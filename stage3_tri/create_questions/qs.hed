# --- Vowel vs Consonant ---
QS "Vowel" {a,Aa,aA,aa,A,e,eA,eE,ea,Ea,i,iE,ie,Ie,I,o,u,uO,uo,Uo}

QS "Consonant" {L,M,N,R,S,Z,b,d,dZ,dz,f,g,h,k,l,m,n,p,r,s,t,tS,ts,v,x,z}

# --- Consonant Classes ---
QS "Sonorant" {j,l,m,n,r,v}

# QS "NonSonorant" {b,d,g,k,p,s,S,t,z,Z}

QS "Fricative" {s,S,z,Z,f,h,x}

# QS "NonFricative" {p,t,k,b,d,g}

QS "Affricates" {ts,tS,dz,dZ}

# QS "ForeignFricatives" {f,x,h}

# --- Place of Articulation ---
QS "Labial" {p,b,m,v,f}

# QS "NonLabial" {t,d,k,g}

QS "Coronal" {t,d,n,l,r}

# QS "NonCoronal" {k,g}

QS "Silibant" {s,z,S,Z,ts,tS,dz,dZ}

# QS "NonSilibant" {S,Z}

# --- Voiced ---
QS "Voiced" {g,d,b,dz,dZ,z,Z,m,n,l,r,j}

QS "NonVoiced" {k,t,p,ts,tS,s,S,f,h,x}

# --- Diphthong endings ---
QS "Diphthong" {j,w}

# --- Silence and Noise ---
QS "Silence" {sil}


