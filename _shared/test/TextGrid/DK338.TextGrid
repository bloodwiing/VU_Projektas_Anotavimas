            xmax = 273.090000
            text = ""
        intervals [45]:
            xmin = 273.090000
            xmax = 276.900000
            text = "o gal pats būdamas istorijos mokytoju, parėjęs namo vis tiek manot, jog"
        intervals [46]:
            xmin = 276.900000
            xmax = 277.180000
            text = ""
        intervals [47]:
            xmin = 277.180000
            xmax = 281.770000
            text = "dar suspės galvą su ta praeitim mano mažiesiems iškvaršint"
        intervals [48]:
            xmin = 281.770000
            xmax = 281.800000
            text = ""
        intervals [49]:
            xmin = 281.800000
            xmax = 283.840000
            text = "Tegul jie pasidžiaugia gyvenimu."
        intervals [50]:
            xmin = 283.840000
            xmax = 392.220000
            text = ""
        intervals [51]:
            xmin = 392.220000
            xmax = 397.020000
            text = "Mindaugai, mano dukra yra aštuonių metų, ir jinai taip pat domisi"
        intervals [52]:
            xmin = 397.020000
            xmax = 397.050000
            text = ""
        intervals [53]:
            xmin = 397.050000
            xmax = 398.970000
            text = "Baltarusijos, ir Rusijos prezidentais. Tai"
        intervals [54]:
            xmin = 398.970000
            xmax = 399.180000
            text = ""
        intervals [55]:
            xmin = 399.180000
            xmax = 403.920000
            text = "kažkuria prasme iš tiesų vaikai patyliukais perima tai, kas yra mūsų gyvenimuose,"
        intervals [56]:
            xmin = 403.920000
            xmax = 403.950000
            text = ""
        intervals [57]:
            xmin = 403.950000
            xmax = 405.990000
            text = "nusiklauso mūsų pokalbių"
