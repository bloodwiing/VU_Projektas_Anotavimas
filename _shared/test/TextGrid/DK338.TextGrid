            xmax = 2413.998000
            text = ""
        intervals [1182]:
            xmin = 2413.998000
            xmax = 2416.130000
            text = "visi žmonės yra skirtingi. Visi jie kitaip"
        intervals [1183]:
            xmin = 2416.130000
