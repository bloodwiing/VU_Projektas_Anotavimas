        intervals [254]:
            xmin = 1683.030000
            xmax = 1684.020000
            text = "egzamino metu."
        intervals [255]:
            xmin = 1684.020000
            xmax = 1684.590000
            text = ""
        intervals [256]:
            xmin = 1684.590000
            xmax = 1689.450000
            text = "Taigi neišvengiamai dabar tenka prisiminti ir su egzaminu tiesiogiai susijusį"
        intervals [257]:
            xmin = 1689.450000
            xmax = 1693.260000
            text = "dar vieną dalyką. Tai būtent istorijos dėstymo mokykloje programą."
