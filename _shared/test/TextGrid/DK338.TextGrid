        intervals [1152]:
            xmin = 2357.880000
            xmax = 2364.660000
            text = "pusės būtų pavadi nes nu kaip aš čia Ką. laiko pojūtį prarasčiau tai yra blogai ar ne, nenudirbčiau darbų, bet iš kitos pusės, kad"
        intervals [1153]:
            xmin = 2364.660000
            xmax = 2365.890000
            text = ""
        intervals [1154]:
            xmin = 2365.890000
            xmax = 2370.600000
            text = "ta mano laiko tėkmė būnant sodyboje kaime būtų gerokai lėtesnė, negu"
        intervals [1155]:
            xmin = 2370.600000
            xmax = 2371.440000
            text = "yra darbe."
        intervals [1156]:
            xmin = 2371.440000
            xmax = 2371.740000
            text = ""
        intervals [1157]:
            xmin = 2371.740000
            xmax = 2373.480000
            text = "Kad aš galėčiau pasiilsėti."
        intervals [1158]:
            xmin = 2373.480000
            xmax = 2373.780000
            text = ""
        intervals [1159]:
            xmin = 2373.780000
            xmax = 2377.830000
            text = "Aš mėgstu atgauti tą dvasinę tokią ir fizinę ramybę. Pirtyje."
        intervals [1160]:
            xmin = 2377.830000
            xmax = 2378.370000
            text = ""
        intervals [1161]:
            xmin = 2378.370000
            xmax = 2382.759000
            text = "Aš manau, tas yra svarbu. Aš mėgstu užsiimti tam tikra fizine veikla, nors tam"
        intervals [1162]:
            xmin = 2382.759000
            xmax = 2383.230000
            text = ""
        intervals [1163]:
            xmin = 2383.230000
            xmax = 2384.820000
            text = "laiko lieka"
        intervals [1164]:
            xmin = 2384.820000
