            text = ""
        intervals [1391]:
            xmin = 2823.530000
            xmax = 2824.640000
            text = "didelė erdvė."
        intervals [1392]:
            xmin = 2824.640000
            xmax = 2824.910000
            text = ""
        intervals [1393]:
            xmin = 2824.910000
            xmax = 2828.240000
            text = "Mokytojai neranda atramos šituose dalykuose."
        intervals [1394]:
            xmin = 2828.240000
            xmax = 2828.660000
            text = ""
        intervals [1395]:
            xmin = 2828.660000
            xmax = 2830.635000
            text = "Na, ir formuojasi vakuumas."
        intervals [1396]:
            xmin = 2830.635000
            xmax = 2831.390000
            text = ""
        intervals [1397]:
            xmin = 2831.390000
            xmax = 2832.500000
            text = "Viso šito dalyko,"
        intervals [1398]:
            xmin = 2832.500000
            xmax = 2832.740000
            text = ""
        intervals [1399]:
            xmin = 2832.740000
            xmax = 2835.260000
            text = "nes aš manyčiau, kad dalykine prasme"
        intervals [1400]:
            xmin = 2835.260000
            xmax = 2835.650000
            text = ""
        intervals [1401]:
            xmin = 2835.650000
            xmax = 2837.360000
            text = "ta situacija nėra tokia bloga."
        intervals [1402]:
            xmin = 2837.360000
            xmax = 2837.780000
            text = ""
        intervals [1403]:
            xmin = 2837.780000
            xmax = 2839.580000
            text = "Čia svarbiausia yra didaktiniai"
        intervals [1404]:
            xmin = 2839.580000
            xmax = 2839.760000
            text = ""
        intervals [1405]:
            xmin = 2839.760000
            xmax = 2845.160000
            text = "dalykai nes aiškinant mokiniams i tiksliau, ką reiškia aiškinant va čia mes irgi tokį stereotipą. Turim,"
        intervals [1406]:
            xmin = 2845.160000
            xmax = 2845.340000
            text = ""
        intervals [1407]:
            xmin = 2845.340000
            xmax = 2848.160000
            text = "kad mokiniams reikia kažką išaiškinti, išmokyti"
        intervals [1408]:
            xmin = 2848.160000
            xmax = 2848.490000
            text = ""
        intervals [1409]:
            xmin = 2848.490000
            xmax = 2851.769000
            text = "jau daugiau kaip trisdešim metų. ir Lietuvoj ir pasauly yra kalbama, "
        intervals [1410]:
            xmin = 2851.769000
            xmax = 2852.690000
            text = ""
        intervals [1411]:
            xmin = 2852.690000
            xmax = 2856.860000
            text = "reikia padėti mokiniui, kad jis išsiaiškintų. Jis išmoktų,"
        intervals [1412]:
            xmin = 2856.860000
            xmax = 2857.400000
            text = ""
        intervals [1413]:
            xmin = 2857.400000
            xmax = 2858.153000
            text = "o mes dar, vat"
        intervals [1414]:
            xmin = 2858.153000
            xmax = 2858.330000
            text = ""
        intervals [1415]:
            xmin = 2858.330000
            xmax = 2860.520000
            text = "kažkaip vis murkdomės šitoje baloje"
        intervals [1416]:
            xmin = 2860.520000
            xmax = 2860.730000
            text = ""
        intervals [1417]:
            xmin = 2860.730000
            xmax = 2861.319000
            text = "taip kad"
        intervals [1418]:
            xmin = 2861.319000
            xmax = 2861.603000
            text = ""
        intervals [1419]:
            xmin = 2861.603000
            xmax = 2864.150000
            text = "tas vakuumas. Jis kol kas nėra išspręstas."
        intervals [1420]:
            xmin = 2864.150000
            xmax = 2864.420000
            text = ""
        intervals [1421]:
            xmin = 2864.420000
            xmax = 2866.820000
            text = "Bet, aišku, ir mokytojų"
        intervals [1422]:
            xmin = 2866.820000
            xmax = 2867.150000
            text = ""
        intervals [1423]:
            xmin = 2867.150000
            xmax = 2871.920000
            text = "bendruomenės čia yra problemos. Aš čia kalbu apie istorijos mokytojus, nes mes apie istoriką"
        intervals [1424]:
            xmin = 2871.920000
            xmax = 2874.710000
            text = ""
        intervals [1425]:
            xmin = 2874.710000
            xmax = 2875.250000
            text = "yra"
        intervals [1426]:
            xmin = 2875.250000
            xmax = 2875.370000
            text = ""
        intervals [1427]:
            xmin = 2875.370000
            xmax = 2879.514000
            text = "retai suformuluojami konkretūs klausimai. O kokie gi rūpi nes "
        intervals [1428]:
            xmin = 2879.514000
            xmax = 2879.690000
            text = ""
        intervals [1429]:
            xmin = 2879.690000
            xmax = 2884.250000
            text = "sakyti tai, kad viskas yra blogai, arba mes nieko nežinom. Tai nėra atsakymas."
        intervals [1430]:
            xmin = 2884.250000
            xmax = 2884.750000
            text = ""
        intervals [1431]:
            xmin = 2884.750000
            xmax = 2887.810000
            text = "Tai jeigu man šiandien dienai reikia atsakymo,"
        intervals [1432]:
            xmin = 2887.810000
            xmax = 2888.020000
            text = ""
        intervals [1433]:
            xmin = 2888.020000
            xmax = 2888.890000
            text = "pavyzdžiui,"
        intervals [1434]:
            xmin = 2888.890000
            xmax = 2889.070000
            text = ""
        intervals [1435]:
            xmin = 2889.070000
            xmax = 2889.520000
            text = "dėl"
        intervals [1436]:
            xmin = 2889.520000
            xmax = 2890.060000
            text = ""
        intervals [1437]:
            xmin = 2890.060000
            xmax = 2894.470000
            text = "metodų panaudojimo ar lentelių, braižymas ir pildymas vis dar yra"
        intervals [1438]:
            xmin = 2894.470000
            xmax = 2895.700000
            text = "efektyvus metodas"
        intervals [1439]:
            xmin = 2895.700000
            xmax = 2895.970000
            text = ""
        intervals [1440]:
            xmin = 2895.970000
            xmax = 2897.560000
            text = "norint įsisavinti"
        intervals [1441]:
            xmin = 2897.560000
            xmax = 2897.740000
            text = ""
        intervals [1442]:
            xmin = 2897.740000
            xmax = 2899.150000
            text = "istorinę, informaciją, tarkim,"
        intervals [1443]:
            xmin = 2899.150000
            xmax = 2900.470000
            text = ""
        intervals [1444]:
            xmin = 2900.470000
            xmax = 2903.830000
            text = "reikia atlikti tyrimą. Tai pats mokytojas jisai"
        intervals [1445]:
            xmin = 2903.830000
            xmax = 2904.010000
            text = ""
        intervals [1446]:
            xmin = 2904.010000
            xmax = 2908.330000
            text = "galbūt yra ir nepajėgus. Iš kitos pusės ne jo darbas, kad jis čia atlikinėtų jisai turi"
        intervals [1447]:
            xmin = 2908.330000
            xmax = 2909.257000
            text = "susikoncentruoti"
        intervals [1448]:
            xmin = 2909.257000
            xmax = 2909.698000
            text = ""
        intervals [1449]:
            xmin = 2909.698000
            xmax = 2911.990000
            text = "savo funkcijas. Ir čia mokslininkai turi tai atlikti"
        intervals [1450]:
            xmin = 2911.990000
            xmax = 2912.180000
            text = ""
        intervals [1451]:
            xmin = 2912.180000
            xmax = 2915.090000
            text = "tai va, tai čia yra ir iš vienos, ir iš kitos pusės."
        intervals [1452]:
            xmin = 2915.090000
            xmax = 2915.360000
            text = ""
        intervals [1453]:
            xmin = 2915.360000
            xmax = 2917.691000
            text = "Tokio nesusikalbėjimo galbūt šiek tiek,"
        intervals [1454]:
            xmin = 2917.691000
            xmax = 2918.840000
            text = ""
        intervals [1455]:
            xmin = 2918.840000
            xmax = 2921.840000
            text = "aš matyčiau ir tokių teigiamų apraiškų, nes"
        intervals [1456]:
            xmin = 2921.840000
            xmax = 2921.960000
            text = ""
        intervals [1457]:
            xmin = 2921.960000
            xmax = 2923.520000
            text = "akademiniai istorikai"
        intervals [1458]:
            xmin = 2923.520000
            xmax = 2923.850000
            text = ""
        intervals [1459]:
            xmin = 2923.850000
            xmax = 2928.800000
            text = "leisiu sau juos taip pavadinti, vis dažniau mėgina atrasti kelią į mokyklas,"
        intervals [1460]:
            xmin = 2928.800000
            xmax = 2929.310000
            text = "tiek per"
