            xmin = 134.820000
            xmax = 139.020000
            text = "profesijų renkantis savo ateities kelią. Galvojau apie karininko kelią,"
        intervals [48]:
            xmin = 139.020000
            xmax = 139.290000
            text = ""
        intervals [49]:
            xmin = 139.290000
            xmax = 139.920000
            text = "apie"
        intervals [50]:
            xmin = 139.920000
            xmax = 140.190000
            text = ""
        intervals [51]:
            xmin = 140.190000
            xmax = 143.670000
            text = "politiko kelią. Tuomet buvo labai populiaru"
        intervals [52]:
            xmin = 143.670000
            xmax = 144.630000
            text = ""
        intervals [53]:
            xmin = 144.630000
            xmax = 146.475000
            text = "apie tai svarstyti. Bet"
        intervals [54]:
            xmin = 146.475000
            xmax = 146.675000
            text = ""
        intervals [55]:
            xmin = 146.675000
            xmax = 149.310000
            text = "na, mane labai traukė. Istorija. Visą laiką"
        intervals [56]:
            xmin = 149.310000
            xmax = 150.090000
            text = ""
        intervals [57]:
            xmin = 150.090000
            xmax = 154.080000
            text = "tai aš vis dėlto nusprendžiau pasiduoti tai tėkmei"
        intervals [58]:
            xmin = 154.080000
            xmax = 155.055000
            text = ""
        intervals [59]:
            xmin = 155.055000
            xmax = 159.270000
            text = "atsirado galimybė tai padaryti. Tai aš tuo džiaugiuosi ir"
        intervals [60]:
            xmin = 159.270000
            xmax = 159.835000
            text = "niekuomet"
        intervals [61]:
            xmin = 159.835000
            xmax = 160.230000
            text = ""
        intervals [62]:
            xmin = 160.230000
            xmax = 160.980000
            text = "nenusivyliau."
        intervals [63]:
            xmin = 160.980000
            xmax = 166.310000
            text = ""
        intervals [64]:
            xmin = 166.310000
            xmax = 168.050000
            text = "Jeigu jau kaip mokytojas,"
        intervals [65]:
            xmin = 168.050000
            xmax = 168.625000
            text = ""
        intervals [66]:
            xmin = 168.625000
            xmax = 170.180000
            text = "tikras mokytojas, tai"
        intervals [67]:
            xmin = 170.180000
            xmax = 170.840000
            text = ""
        intervals [68]:
            xmin = 170.840000
            xmax = 172.539000
            text = "čia toks yra dvigubas dalykas"
        intervals [69]:
            xmin = 172.539000
            xmax = 172.782000
            text = ""
        intervals [70]:
            xmin = 172.782000
            xmax = 175.250000
            text = "Gal kai buvau dvyliktokas, manęs vienąkart direktorė"
        intervals [71]:
            xmin = 175.250000
            xmax = 176.876000
            text = "paprašė pradinukus"
        intervals [72]:
            xmin = 176.876000
            xmax = 177.260000
            text = ""
        intervals [73]:
            xmin = 177.260000
            xmax = 178.610000
            text = "užimti nes mokytoja"
        intervals [74]:
            xmin = 178.610000
            xmax = 179.180000
            text = ""
        intervals [75]:
            xmin = 179.180000
            xmax = 180.500000
            text = "susirgus ar kažkur"
        intervals [76]:
            xmin = 180.500000
            xmax = 180.980000
            text = ""
        intervals [77]:
            xmin = 180.980000
            xmax = 182.630000
            text = "Tai vat su pradinukais teko"
        intervals [78]:
            xmin = 182.630000
            xmax = 184.345000
            text = ""
        intervals [79]:
            xmin = 184.345000
            xmax = 187.190000
            text = "kažką panašaus daryti, ką darytų mokytojas."
        intervals [80]:
            xmin = 187.190000
            xmax = 187.550000
            text = ""
        intervals [81]:
            xmin = 187.550000
            xmax = 190.310000
            text = "O vėliau tai kai jau buvau studentas,"
        intervals [82]:
            xmin = 190.310000
            xmax = 190.590000
            text = ""
        intervals [83]:
            xmin = 190.590000
            xmax = 193.665000
            text = "pedagoginės praktikos atlikimo metu pasitaikė galimybė "
        intervals [84]:
            xmin = 193.665000
            xmax = 194.100000
            text = ""
        intervals [85]:
            xmin = 194.100000
            xmax = 196.890000
            text = "taip pat vaduoti mokytoją susirgusią."
        intervals [86]:
            xmin = 196.890000
            xmax = 197.520000
            text = ""
        intervals [87]:
            xmin = 197.520000
            xmax = 201.930000
            text = "Ir čia toksai išbandymų savotiškas buvo laikas, nes"
        intervals [88]:
            xmin = 201.930000
            xmax = 202.230000
            text = ""
        intervals [89]:
            xmin = 202.230000
            xmax = 206.543000
            text = "direktorius tiesiog sako: ar tu gali dabar vat nueiti pas dvyliktokus "
        intervals [90]:
            xmin = 206.543000
            xmax = 207.728000
            text = ""
        intervals [91]:
            xmin = 207.728000
            xmax = 210.120000
            text = "jie sėdi klasėje. Aš sakau Aišku, galiu."
        intervals [92]:
            xmin = 210.120000
            xmax = 210.720000
            text = ""
        intervals [93]:
            xmin = 210.720000
            xmax = 213.330000
            text = "Nuėjau ir ką jie tuo metu buvo ten,"
        intervals [94]:
            xmin = 213.330000
            xmax = 213.720000
            text = ""
        intervals [95]:
            xmin = 213.720000
            xmax = 217.470000
            text = "galbūt dviem trim metais jaunesni negu aš tuo metu?"
        intervals [96]:
            xmin = 217.470000
            xmax = 218.130000
            text = ""
        intervals [97]:
            xmin = 218.130000
            xmax = 222.210000
            text = "Na, ir aš jiem taip labai tokiu savo išprususiu"
        intervals [98]:
            xmin = 222.210000
            xmax = 222.480000
            text = ""
        intervals [99]:
            xmin = 222.480000
            xmax = 227.280000
            text = "balsu ir protu viską išdėsčiau apie Pirmąjį pasaulinį karą. Tai, ką atsiminiau iš"
        intervals [100]:
            xmin = 227.280000
            xmax = 232.173000
            text = ""
        intervals [101]:
            xmin = 232.173000
            xmax = 236.640000
            text = "nėra kažkuo. Tos pirmosios pamokos - unikalios, išskirtinės, ko nėra patyrę"
        intervals [102]:
            xmin = 236.640000
            xmax = 236.670000
            text = ""
        intervals [103]:
            xmin = 236.670000
            xmax = 239.088000
            text = "kiti mokytojai. Tai mes dažnai taip pat"
        intervals [104]:
            xmin = 239.088000
            xmax = 239.339000
            text = ""
        intervals [105]:
            xmin = 239.339000
            xmax = 240.570000
            text = "visi įsiliejam į šitą"
        intervals [106]:
            xmin = 240.570000
            xmax = 241.020000
            text = ""
        intervals [107]:
            xmin = 241.020000
            xmax = 245.220000
            text = "profesiją, darydami tam tikras klaidas ir po to atrandam savo"
        intervals [108]:
            xmin = 245.220000
            xmax = 245.620000
            text = ""
        intervals [109]:
            xmin = 245.620000
            xmax = 247.600000
            text = "tempą. Atrandame savo"
        intervals [110]:
            xmin = 247.600000
            xmax = 248.050000
            text = ""
        intervals [111]:
            xmin = 248.050000
            xmax = 250.210000
            text = "stilių, atrandame savo sistemas."
        intervals [112]:
            xmin = 250.210000
            xmax = 285.540000
            text = ""
        intervals [113]:
            xmin = 285.540000
            xmax = 285.902000
            text = "kaip"
        intervals [114]:
            xmin = 285.902000
            xmax = 286.080000
            text = ""
        intervals [115]:
            xmin = 286.080000
            xmax = 288.013000
            text = "sudėtinga visuomet, aš manau."
        intervals [116]:
            xmin = 288.013000
            xmax = 288.252000
            text = ""
        intervals [117]:
            xmin = 288.252000
            xmax = 288.956000
            text = "jeigu tu"
        intervals [118]:
            xmin = 288.956000
            xmax = 289.080000
            text = ""
        intervals [119]:
            xmin = 289.080000
            xmax = 291.438000
            text = "profesionaliai užsiimi tam tikru darbu"
        intervals [120]:
            xmin = 291.438000
            xmax = 292.116000
            text = ""
        intervals [121]:
            xmin = 292.116000
            xmax = 293.940000
            text = "vėliau, tarsi po darbų"
        intervals [122]:
            xmin = 293.940000
            xmax = 296.160000
            text = ""
        intervals [123]:
            xmin = 296.160000
            xmax = 299.370000
            text = "nu, kažkaip norisi atsiriboti iš vienos pusės, iš kitos pusės."
        intervals [124]:
            xmin = 299.370000
            xmax = 299.670000
            text = ""
        intervals [125]:
            xmin = 299.670000
            xmax = 300.840000
            text = "Kadangi istorija"
        intervals [126]:
            xmin = 300.840000
            xmax = 301.320000
            text = ""
        intervals [127]:
            xmin = 301.320000
            xmax = 304.740000
            text = "mano gyvenime yra toks labai integralus dalykas."
        intervals [128]:
            xmin = 304.740000
            xmax = 305.070000
            text = ""
        intervals [129]:
            xmin = 305.070000
            xmax = 307.620000
            text = "Mūsų namuose yra daugybė knygų,"
        intervals [130]:
            xmin = 307.620000
            xmax = 308.010000
            text = ""
        intervals [131]:
            xmin = 308.010000
            xmax = 312.360000
            text = "kabo kažkokių istorinių paveikslų, vėlgi tą patį, ką aš matydavau savo vaikystėj."
        intervals [132]:
            xmin = 312.360000
            xmax = 312.710000
            text = ""
        intervals [133]:
            xmin = 312.710000
            xmax = 313.620000
            text = "Tai natūralu, kad"
        intervals [134]:
            xmin = 313.620000
            xmax = 314.090000
            text = ""
        intervals [135]:
            xmin = 314.090000
            xmax = 315.980000
            text = "mano šeima nėra nuo to atsieta"
        intervals [136]:
            xmin = 315.980000
            xmax = 316.370000
            text = ""
        intervals [137]:
            xmin = 316.370000
            xmax = 321.050000
            text = "sūnui. Yra dveji metai. Tai, na, toksai pokalbis istorine tema yra"
        intervals [138]:
            xmin = 321.050000
            xmax = 321.290000
            text = ""
        intervals [139]:
            xmin = 321.290000
            xmax = 322.310000
            text = "labai sąlyginis,"
        intervals [140]:
            xmin = 322.310000
            xmax = 322.599000
            text = ""
        intervals [141]:
            xmin = 322.599000
            xmax = 326.330000
            text = "bet jam patinka su kardais ir skydais kovoti"
        intervals [142]:
            xmin = 326.330000
            xmax = 326.480000
            text = ""
        intervals [143]:
            xmin = 326.480000
            xmax = 328.610000
            text = "su matomais ir nematomais priešais."
        intervals [144]:
            xmin = 328.610000
            xmax = 328.880000
            text = ""
        intervals [145]:
            xmin = 328.880000
            xmax = 330.920000
            text = "Aš irgi tą patį darydavau vaikystėj."
        intervals [146]:
            xmin = 330.920000
            xmax = 331.190000
            text = ""
        intervals [147]:
            xmin = 331.190000
            xmax = 335.540000
            text = "Su dukra mes jau pasišnekam šiek tiek išsamiau, ypatingai, kai būna"
        intervals [148]:
            xmin = 335.540000
            xmax = 335.900000
            text = ""
        intervals [149]:
            xmin = 335.900000
            xmax = 337.970000
            text = "tam tikros istorinė sukaktys,"
        intervals [150]:
            xmin = 337.970000
            xmax = 338.750000
            text = ""
        intervals [151]:
            xmin = 338.750000
            xmax = 341.570000
            text = "nebūtinai istorinėm temom, bet ir tokiom politinėm."
        intervals [152]:
            xmin = 341.570000
            xmax = 341.880000
            text = ""
        intervals [153]:
            xmin = 341.880000
            xmax = 343.140000
            text = "Vienas iš tokių klausimų:"
        intervals [154]:
            xmin = 343.140000
            xmax = 343.290000
            text = ""
        intervals [155]:
            xmin = 343.290000
            xmax = 349.950000
            text = "kas labai man yra įstrigę Baltarusijos įvykiai? Tai jinai tikrai labai buvo taip aktyviai susidomėjusi ir"
        intervals [156]:
            xmin = 349.950000
            xmax = 350.250000
            text = ""
        intervals [157]:
            xmin = 350.250000
            xmax = 354.600000
            text = "netgi dabar kartais perklausia vat kaip čia su tuo prezidentu"
        intervals [158]:
            xmin = 354.600000
            xmax = 355.170000
            text = ""
        intervals [159]:
            xmin = 355.170000
            xmax = 358.350000
            text = "baltarusių? Ar jis jau pasitraukė?"
        intervals [160]:
            xmin = 358.350000
            xmax = 358.770000
            text = ""
        intervals [161]:
            xmin = 358.770000
            xmax = 360.060000
            text = "Ar vis dėlto dar yra"
        intervals [162]:
            xmin = 360.060000
            xmax = 360.840000
            text = ""
        intervals [163]:
            xmin = 360.840000
            xmax = 362.520000
            text = "šiuo metu dukrai yra penki metai"
        intervals [164]:
            xmin = 362.520000
            xmax = 362.850000
            text = ""
        intervals [165]:
            xmin = 362.850000
            xmax = 366.810000
            text = "vasario šešiolikta - kovo vienuolikta Apie tai šnekam. Kas yra ta Lietuva?"
        intervals [166]:
            xmin = 366.810000
            xmax = 367.170000
            text = ""
        intervals [167]:
            xmin = 367.170000
            xmax = 369.330000
            text = "Bet aš nenoriu ir perspausti, kad, na,"
        intervals [168]:
            xmin = 369.330000
            xmax = 369.920000
            text = ""
        intervals [169]:
            xmin = 369.920000
            xmax = 375.684000
            text = "tie mano vaikai, grįžę iš darželio ar panašiai, savaitgalį ten turi atsisėsti, ir mes tiktai apie istoriją kalbam"
        intervals [170]:
            xmin = 375.684000
            xmax = 376.700000
            text = ""
        intervals [171]:
            xmin = 376.700000
            xmax = 381.470000
            text = "to nebuvo tikimasi. Vaikystėje tiesiog integraliai. Aš pačiupdavau tai, kas man yra"
        intervals [172]:
            xmin = 381.470000
            xmax = 381.950000
            text = "įdomu,"
        intervals [173]:
            xmin = 381.950000
            xmax = 382.410000
            text = ""
        intervals [174]:
            xmin = 382.410000
            xmax = 387.180000
            text = "Ir galbūt čia yra pagrindinis dalykas, kodėl aš įsivažiavau į visą"
        intervals [175]:
            xmin = 387.180000
            xmax = 387.540000
            text = ""
        intervals [176]:
            xmin = 387.540000
            xmax = 388.950000
            text = "tą istorinį pasaulį"
        intervals [177]:
            xmin = 388.950000
            xmax = 389.220000
            text = ""
        intervals [178]:
            xmin = 389.220000
            xmax = 389.580000
            text = "ir"
        intervals [179]:
            xmin = 389.580000
            xmax = 389.700000
            text = ""
        intervals [180]:
            xmin = 389.700000
            xmax = 391.380000
            text = "jame esu po šiai dienai,"
        intervals [181]:
            xmin = 391.380000
            xmax = 425.560000
            text = ""
        intervals [182]:
            xmin = 425.560000
            xmax = 429.310000
            text = "Vienareikšmiškai aš kažkaip neatsieju šitų dviejų"
        intervals [183]:
            xmin = 429.310000
            xmax = 429.640000
            text = ""
        intervals [184]:
            xmin = 429.640000
            xmax = 431.140000
            text = "ar netgi trijų dalykų."
        intervals [185]:
            xmin = 431.140000
            xmax = 431.440000
            text = ""
        intervals [186]:
            xmin = 431.440000
            xmax = 434.530000
            text = "Ir, beje, aš taip žiūrėdamas šiek tiek kartais iš šono į"
        intervals [187]:
            xmin = 434.530000
            xmax = 434.950000
            text = ""
        intervals [188]:
            xmin = 434.950000
            xmax = 439.930000
            text = "į istorikus matau tokio labai dirbtinumo, kad kai kurie istorikai yra nu"
        intervals [189]:
            xmin = 439.930000
            xmax = 444.250000
            text = "vat kaip profesija. Aš turiu profesiją. Aš esu istorikas, atlieku tą savo darbą."
        intervals [190]:
            xmin = 444.250000
            xmax = 444.850000
            text = ""
        intervals [191]:
            xmin = 444.850000
            xmax = 446.970000
            text = "Man gal pernelyg ir neįdomu. Reikia čia "
        intervals [192]:
            xmin = 446.970000
            xmax = 447.910000
            text = ""
        intervals [193]:
            xmin = 447.910000
            xmax = 449.110000
            text = "Nereikia, nedirbu."
        intervals [194]:
            xmin = 449.110000
            xmax = 449.470000
            text = ""
        intervals [195]:
            xmin = 449.470000
            xmax = 451.703000
            text = "Nežinau, o pas mane tai visiškai kitaip"
        intervals [196]:
            xmin = 451.703000
            xmax = 451.863000
            text = ""
        intervals [197]:
            xmin = 451.863000
            xmax = 454.090000
            text = "Aš bet kokį istorinį tokį dalyką"
        intervals [198]:
            xmin = 454.090000
            xmax = 454.240000
            text = ""
        intervals [199]:
            xmin = 454.240000
            xmax = 457.390000
            text = "pamatęs, palietęs, man suvirpa kažkas taip viduje."
        intervals [200]:
            xmin = 457.390000
            xmax = 457.842000
            text = ""
        intervals [201]:
            xmin = 457.842000
            xmax = 459.910000
            text = "Visiškai nesvarbu, ar man rodo kažkokį"
        intervals [202]:
            xmin = 459.910000
            xmax = 460.150000
            text = ""
        intervals [203]:
            xmin = 460.150000
            xmax = 462.430000
            text = "penkiasdešimties metų senumo laikraštį,"
        intervals [204]:
            xmin = 462.430000
            xmax = 462.730000
            text = ""
        intervals [205]:
            xmin = 462.730000
            xmax = 466.870000
            text = "ar monetą. Tarkime, ten trisdešimties metų netgi senumo,"
        intervals [206]:
            xmin = 466.870000
            xmax = 467.230000
            text = ""
        intervals [207]:
            xmin = 467.230000
            xmax = 467.949000
            text = "ar galbūt "
        intervals [208]:
            xmin = 467.949000
            xmax = 468.080000
            text = ""
        intervals [209]:
            xmin = 468.080000
            xmax = 470.140000
            text = "aš kažkokį piliakalnį pamatau."
        intervals [210]:
            xmin = 470.140000
            xmax = 474.380000
            text = ""
        intervals [211]:
            xmin = 474.380000
            xmax = 476.570000
            text = "Tai yra mano gyvenimo dalis, ir"
        intervals [212]:
            xmin = 476.570000
            xmax = 476.930000
            text = ""
        intervals [213]:
            xmin = 476.930000
            xmax = 477.740000
            text = "tai yra svarbu."
        intervals [214]:
            xmin = 477.740000
            xmax = 535.540000
            text = ""
        intervals [215]:
            xmin = 535.540000
            xmax = 536.739000
            text = "Oi, čia yra labai"
        intervals [216]:
            xmin = 536.739000
            xmax = 536.970000
            text = ""
        intervals [217]:
            xmin = 536.970000
            xmax = 540.520000
            text = "skirtingi dalykai. Taip, yra tam tikri dėsningumai."
        intervals [218]:
            xmin = 540.520000
            xmax = 543.280000
            text = ""
        intervals [219]:
            xmin = 543.280000
            xmax = 546.850000
            text = "tokią praeitį. Kadangi istorija domėjausi nuo mažumės,"
        intervals [220]:
            xmin = 546.850000
            xmax = 547.270000
            text = ""
        intervals [221]:
            xmin = 547.270000
            xmax = 551.020000
            text = "o istorijos pamokos, tos tikrosios mokykloje prasideda penktoj klasėj"
        intervals [222]:
            xmin = 551.020000
            xmax = 551.200000
            text = ""
        intervals [223]:
            xmin = 551.200000
            xmax = 552.100000
            text = "ir aš taip labai"
        intervals [224]:
            xmin = 552.100000
            xmax = 552.250000
            text = ""
        intervals [225]:
            xmin = 552.250000
            xmax = 556.150000
            text = "pamenu, laukiau vat kada aš tapsiu penktoku ir bus istorijos pamokos."
        intervals [226]:
            xmin = 556.150000
            xmax = 556.540000
            text = ""
        intervals [227]:
            xmin = 556.540000
            xmax = 560.350000
            text = "Ir atsimenu pačią pirmą istorijos pamoką. Mokytoja istorijos sako:"
        intervals [228]:
            xmin = 560.350000
            xmax = 560.630000
            text = ""
        intervals [229]:
            xmin = 560.630000
            xmax = 565.160000
            text = "na, dabar įsivaizduokit, kad mes čia su laiko mašina, persikeliam daugybę"
        intervals [230]:
            xmin = 565.160000
            xmax = 566.600000
            text = "tūkstančių metų atgal."
        intervals [231]:
            xmin = 566.600000
            xmax = 567.977000
            text = ""
        intervals [232]:
            xmin = 567.977000
            xmax = 569.540000
