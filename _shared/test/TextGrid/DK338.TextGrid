            text = ""
        intervals [1207]:
            xmin = 2457.020000
            xmax = 2460.740000
            text = "ir aš suprantu, kad mes visi esam skirtingi. Tai, kad nieko nepakeisi. Čia."
        intervals [1208]:
            xmin = 2460.740000
            xmax = 2507.440000
            text = ""
        intervals [1209]:
            xmin = 2507.440000
            xmax = 2508.670000
            text = "Aš Aurimai kaupdavau,"
