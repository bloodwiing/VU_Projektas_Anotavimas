            text = ""
        intervals [324]:
            xmin = 1932.010000
            xmax = 1936.930000
            text = "Šitas žmogus yra patyręs daugybę likimo smūgių ir jau besiruošia į pensiją."
        intervals [325]:
            xmin = 1936.930000
            xmax = 1937.350000
            text = ""
        intervals [326]:
            xmin = 1937.350000
            xmax = 1940.496000
