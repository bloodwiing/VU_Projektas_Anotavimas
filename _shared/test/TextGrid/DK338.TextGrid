            text = ""
        intervals [263]:
            xmin = 1696.910000
            xmax = 1698.950000
            text = "kas dieną susiduriat, jūsų nuomone,"
        intervals [264]:
            xmin = 1698.950000
            xmax = 1699.370000
            text = ""
        intervals [265]:
            xmin = 1699.370000
