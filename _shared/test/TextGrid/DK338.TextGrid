            xmin = 2929.310000
            xmax = 2929.520000
            text = ""
        intervals [1462]:
            xmin = 2929.520000
            xmax = 2931.320000
            text = "proginius tam tikrus vizitus,"
        intervals [1463]:
            xmin = 2931.320000
            xmax = 2931.680000
            text = ""
        intervals [1464]:
            xmin = 2931.680000
            xmax = 2936.180000
            text = "tiek per įvairius kvalifikacijos kėlimo seminarus, kurie, na, nėra labai"
        intervals [1465]:
            xmin = 2936.180000
            xmax = 2937.770000
            text = "sistemingi šiandien dienai."
        intervals [1466]:
            xmin = 2937.770000
            xmax = 2938.230000
            text = ""
        intervals [1467]:
            xmin = 2938.230000
            xmax = 2940.420000
            text = "Bet aš matau tokį susidomėjimą"
        intervals [1468]:
            xmin = 2940.420000
            xmax = 2940.540000
            text = ""
        intervals [1469]:
            xmin = 2940.540000
            xmax = 2942.310000
            text = "apie tai, kas vyksta mokykloje,"
        intervals [1470]:
            xmin = 2942.310000
            xmax = 2942.460000
            text = ""
        intervals [1471]:
            xmin = 2942.460000
            xmax = 2943.782000
            text = "nes manyčiau, kad"
        intervals [1472]:
            xmin = 2943.782000
            xmax = 2944.650000
            text = ""
        intervals [1473]:
            xmin = 2944.650000
            xmax = 2946.180000
            text = "akademiniai istorikai"
        intervals [1474]:
            xmin = 2946.180000
            xmax = 2946.360000
            text = ""
        intervals [1475]:
            xmin = 2946.360000
            xmax = 2949.330000
            text = "pamato, kas ateina į universiteto"
        intervals [1476]:
            xmin = 2949.330000
            xmax = 2949.510000
            text = ""
        intervals [1477]:
            xmin = 2949.510000
            xmax = 2951.640000
            text = "auditorijas. Tai juk iš mokyklų ateina"
        intervals [1478]:
            xmin = 2951.640000
