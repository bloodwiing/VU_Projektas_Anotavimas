        intervals [1269]:
            xmin = 2582.860000
            xmax = 2584.810000
            text = "po klasę ir žiūriu, kaip jiem sekasi,"
        intervals [1270]:
            xmin = 2584.810000
            xmax = 2585.260000
            text = ""
        intervals [1271]:
            xmin = 2585.260000
            xmax = 2587.900000
            text = "ir žiūriu vienas mokinys yra užrašęs:"
