            text = ""
        intervals [328]:
            xmin = 1940.830000
            xmax = 1944.040000
            text = "na, ir kokia viso to, ką jūs čia mus mokote prasmė"
        intervals [329]:
            xmin = 1944.040000
            xmax = 1944.460000
            text = ""
        intervals [330]:
            xmin = 1944.460000
            xmax = 1948.840000
            text = "Tomą kryką priverčia radikaliai pakeisti savo dėstomą dalyką."
