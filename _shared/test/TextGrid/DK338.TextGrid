            xmax = 420.760000
            text = ""
        intervals [69]:
            xmin = 420.760000
            xmax = 425.020000
            text = "ar Jūs galite apie savo profesiją pasakyti, kad tai yra kartu ir jūsų hobi, ir gyvenimo būdas."
