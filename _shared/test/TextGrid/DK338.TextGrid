            xmax = 40.770000
            text = ""
        intervals [12]:
            xmin = 40.770000
            xmax = 42.870000
            text = "kurias jūs mus verčiat mokytis"
        intervals [13]:
            xmin = 42.870000
            xmax = 43.260000
            text = ""
        intervals [14]:
            xmin = 43.260000
            xmax = 48.030000
            text = "na o istoriko teritorijoj šiandien svečiuosis ir savo mintimis dalinsis mokytojas,"
        intervals [15]:
            xmin = 48.030000
            xmax = 52.023000
            text = "istorijos mokslų daktaras. VDU licėjaus sokratus direktorius Mindaugas Nefas."
        intervals [16]:
            xmin = 52.023000
            xmax = 52.200000
            text = ""
        intervals [17]:
            xmin = 52.200000
            xmax = 53.220000
            text = "Laba diena, Mindaugai,"
        intervals [18]:
            xmin = 53.220000
            xmax = 55.020000
            text = ""
        intervals [19]:
            xmin = 55.020000
            xmax = 58.230000
            text = "Mindaugai, kaip pasirinkot profesiją, kuri visuomenėj yra,"
        intervals [20]:
            xmin = 58.230000
            xmax = 58.350000
            text = ""
        intervals [21]:
            xmin = 58.350000
            xmax = 59.820000
            text = "kaip mes žinom, nepopuliari,"
        intervals [22]:
            xmin = 59.820000
            xmax = 60.330000
            text = ""
        intervals [23]:
            xmin = 60.330000
            xmax = 63.390000
            text = "paprastai nesiejama nei su savirealizacijos galimybe,"
        intervals [24]:
            xmin = 63.390000
            xmax = 63.660000
            text = ""
        intervals [25]:
            xmin = 63.660000
            xmax = 65.099000
            text = "nei su finansine gerove."
        intervals [26]:
            xmin = 65.099000
            xmax = 65.503000
            text = ""
        intervals [27]:
            xmin = 65.503000
            xmax = 67.410000
            text = "O gal ši profesija pasirinko jus?"
        intervals [28]:
            xmin = 67.410000
            xmax = 161.500000
            text = ""
        intervals [29]:
            xmin = 161.500000
            xmax = 165.700000
            text = "Mindaugai, ar pamenat savo pirmąją dieną mokykloj? Ar tai buvo istorijos pamoka,"
        intervals [30]:
            xmin = 165.700000
            xmax = 250.560000
            text = ""
        intervals [31]:
            xmin = 250.560000
            xmax = 253.233000
            text = "Mindaugai, jūs akivaizdu, kad turit savo stilių, nes esat"
        intervals [32]:
            xmin = 253.233000
            xmax = 254.775000
            text = ""
        intervals [33]:
            xmin = 254.775000
            xmax = 256.769000
            text = "savo mokinių. Apie tai galima"
        intervals [34]:
            xmin = 256.769000
            xmax = 256.920000
            text = ""
        intervals [35]:
            xmin = 256.920000
            xmax = 260.790000
            text = "išgirsti, kai jie dalinasi savo įspūdžiais apie jūsų pamokas."
        intervals [36]:
            xmin = 260.790000
            xmax = 261.255000
            text = ""
        intervals [37]:
            xmin = 261.255000
            xmax = 263.641000
            text = "O kokia jūsų asmeninė patirtis? Ar jūs"
        intervals [38]:
            xmin = 263.641000
            xmax = 264.120000
            text = ""
        intervals [39]:
            xmin = 264.120000
            xmax = 266.820000
            text = "palikęs mokyklą, uždaręs savo klasę?"
        intervals [40]:
            xmin = 266.820000
            xmax = 267.150000
            text = ""
        intervals [41]:
            xmin = 267.150000
            xmax = 271.509000
            text = "Ar jūs prisimenat istoriją? Ir ar jūs apie istoriją pasakojot savo"
        intervals [42]:
