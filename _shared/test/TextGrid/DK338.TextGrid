        intervals [5]:
            xmin = 28.680000
            xmax = 33.360000
            text = "Šiandien kalbėsime apie mūzos Klėjos likimą mokykloje ir istorijos mokytojų"
        intervals [6]:
            xmin = 33.360000
            xmax = 37.230000
            text = "akistatą su auklėtinių užduodamu pamatiniu, bet baisiu klausimu:"
