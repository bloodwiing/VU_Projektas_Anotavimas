            text = ""
        intervals [1165]:
            xmin = 2385.030000
            xmax = 2386.140000
            text = "gerokai mažiau."
        intervals [1166]:
            xmin = 2386.140000
            xmax = 2386.470000
            text = ""
        intervals [1167]:
            xmin = 2386.470000
            xmax = 2390.670000
            text = "Bet čia vėlgi yra prioritetų klausimas, ir kiekvienas mes esame atsakingi"
        intervals [1168]:
            xmin = 2390.670000
            xmax = 2390.940000
            text = ""
        intervals [1169]:
            xmin = 2390.940000
            xmax = 2394.450000
            text = "nuo to, kaip tas dvidešim keturias valandas sudėliojome savo paroj"
        intervals [1170]:
            xmin = 2394.450000
            xmax = 2394.900000
            text = ""
        intervals [1171]:
            xmin = 2394.900000
            xmax = 2398.672000
            text = "Tai kadangi aš esu toksai veiklus žmogus, daug ką darantis žmogus"
        intervals [1172]:
            xmin = 2398.672000
            xmax = 2398.920000
            text = ""
        intervals [1173]:
            xmin = 2398.920000
            xmax = 2402.130000
            text = "man, kaip mokytojui ir dabar, kaip jau mokyklos direktoriui, yra"
        intervals [1174]:
            xmin = 2402.130000
            xmax = 2402.531000
            text = ""
        intervals [1175]:
            xmin = 2402.531000
            xmax = 2403.690000
            text = "Na, iššūkis"
        intervals [1176]:
            xmin = 2403.690000
            xmax = 2404.070000
            text = ""
        intervals [1177]:
            xmin = 2404.070000
            xmax = 2408.600000
            text = "suprasti, kodėl kai kurie žmonės tarsi nieko labai pernelyg neveikia, bet yra"
        intervals [1178]:
            xmin = 2408.600000
            xmax = 2410.790000
            text = "pavargę, ir aš vat su savimi dirbu"
        intervals [1179]:
