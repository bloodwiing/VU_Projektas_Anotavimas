            text = ""
        intervals [1306]:
            xmin = 2627.110000
            xmax = 2629.240000
            text = "kuris, beje, dabar mokosi istoriją."
        intervals [1307]:
            xmin = 2629.240000
            xmax = 2629.360000
            text = ""
        intervals [1308]:
            xmin = 2629.360000
            xmax = 2634.100000
            text = "Aš turiu nemažai mokinių, kurie mokėsi arba vis dar mokosi istorijos specialybėje,"
        intervals [1309]:
            xmin = 2634.100000
            xmax = 2634.430000
            text = ""
        intervals [1310]:
            xmin = 2634.430000
            xmax = 2637.490000
            text = "universitete ir Aurimai. Ne vienas ir tavo studentas"
        intervals [1311]:
            xmin = 2637.490000
            xmax = 2638.052000
            text = ""
        intervals [1312]:
            xmin = 2638.052000
            xmax = 2638.364000
            text = "buvo."
        intervals [1313]:
            xmin = 2638.364000
            xmax = 2638.630000
            text = ""
        intervals [1314]:
            xmin = 2638.630000
            xmax = 2640.730000
            text = "Tai jisai neturėjo sąsiuvinio"
        intervals [1315]:
            xmin = 2640.730000
            xmax = 2641.120000
            text = ""
        intervals [1316]:
            xmin = 2641.120000
            xmax = 2645.770000
            text = "ir ir sako: tai ką man dabar daryt aš sakau nu Ką daryt, ką daryt? Nors ir ant"
        intervals [1317]:
            xmin = 2645.770000
            xmax = 2646.651000
            text = "tualetinio popieriaus"
        intervals [1318]:
            xmin = 2646.651000
            xmax = 2647.990000
            text = ""
        intervals [1319]:
            xmin = 2647.990000
            xmax = 2648.290000
            text = "ir"
        intervals [1320]:
            xmin = 2648.290000
            xmax = 2649.469000
            text = ""
        intervals [1321]:
            xmin = 2649.469000
            xmax = 2651.080000
            text = "pasakiau ir užmiršau. Mes ten dirbam"
        intervals [1322]:
            xmin = 2651.080000
            xmax = 2651.620000
            text = ""
        intervals [1323]:
            xmin = 2651.620000
            xmax = 2654.380000
            text = "ir aš žiūriu, ką jisai ten daro."
        intervals [1324]:
            xmin = 2654.380000
            xmax = 2654.680000
            text = ""
        intervals [1325]:
            xmin = 2654.680000
            xmax = 2655.490000
            text = "O jisai,"
        intervals [1326]:
            xmin = 2655.490000
            xmax = 2655.850000
            text = ""
        intervals [1327]:
            xmin = 2655.850000
            xmax = 2658.130000
            text = "paėmęs vienkartinę servetėlę"
        intervals [1328]:
            xmin = 2658.130000
            xmax = 2658.610000
            text = ""
        intervals [1329]:
            xmin = 2658.610000
            xmax = 2659.028000
            text = "ant"
        intervals [1330]:
            xmin = 2659.028000
            xmax = 2659.840000
            text = ""
        intervals [1331]:
            xmin = 2659.840000
            xmax = 2662.630000
            text = "tos reiškia pirmosios pusės. jisai"
        intervals [1332]:
            xmin = 2662.630000
            xmax = 2663.419000
            text = ""
        intervals [1333]:
            xmin = 2663.419000
            xmax = 2664.313000
            text = "užsirašęs."
        intervals [1334]:
            xmin = 2664.313000
            xmax = 2664.580000
            text = ""
        intervals [1335]:
            xmin = 2664.580000
            xmax = 2668.390000
            text = "Tos ir tos mokyklos, tos ir tos klasės mokinys. Tas ir tas,"
        intervals [1336]:
            xmin = 2668.390000
            xmax = 2668.660000
            text = ""
        intervals [1337]:
            xmin = 2668.660000
            xmax = 2672.110000
            text = "o tada verčia ir rašo atsakymus į tą"
        intervals [1338]:
            xmin = 2672.110000
            xmax = 2672.260000
            text = ""
        intervals [1339]:
            xmin = 2672.260000
            xmax = 2672.800000
            text = "užduotį."
        intervals [1340]:
            xmin = 2672.800000
            xmax = 2673.550000
            text = ""
        intervals [1341]:
            xmin = 2673.550000
            xmax = 2675.129000
            text = "Aš net nusifotografavau."
        intervals [1342]:
            xmin = 2675.129000
            xmax = 2675.710000
            text = ""
        intervals [1343]:
            xmin = 2675.710000
            xmax = 2677.390000
            text = "Tai va, tokios linksmos istorijos,"
        intervals [1344]:
            xmin = 2677.390000
            xmax = 2677.540000
            text = ""
        intervals [1345]:
            xmin = 2677.540000
            xmax = 2681.440000
            text = "linksmos ir mokiniam linksmos, ir man, kaip mokytojui prisiminti, bet tai"
        intervals [1346]:
            xmin = 2681.440000
            xmax = 2681.980000
            text = ""
        intervals [1347]:
            xmin = 2681.980000
            xmax = 2683.572000
            text = "nepasakančios ir kažkaip,"
        intervals [1348]:
            xmin = 2683.572000
            xmax = 2684.170000
            text = ""
        intervals [1349]:
            xmin = 2684.170000
            xmax = 2684.761000
            text = "na taip,"
        intervals [1350]:
            xmin = 2684.761000
            xmax = 2685.130000
            text = ""
        intervals [1351]:
            xmin = 2685.130000
            xmax = 2687.440000
            text = "iš neigiamos pusės parodančius tuos mokinius,"
        intervals [1352]:
            xmin = 2687.440000
            xmax = 2687.680000
            text = ""
        intervals [1353]:
            xmin = 2687.680000
            xmax = 2692.540000
            text = "o parodančius tai, kad procesas yra žaismingas, ir jie kartais sugeba pasinaudoti,"
        intervals [1354]:
            xmin = 2692.540000
            xmax = 2693.080000
            text = ""
        intervals [1355]:
            xmin = 2693.080000
            xmax = 2693.950000
            text = "sakykime, tokiu"
        intervals [1356]:
            xmin = 2693.950000
            xmax = 2694.400000
            text = ""
        intervals [1357]:
            xmin = 2694.400000
            xmax = 2699.260000
            text = "galbūt mokytojo kartais netikslumu. vat jie sugeba visa tai išversti, ir tu prie"
        intervals [1358]:
            xmin = 2699.260000
            xmax = 2701.390000
            text = "jų prikibti negali, nes jie viską padarė. Tai"
        intervals [1359]:
            xmin = 2701.390000
            xmax = 2702.320000
            text = ""
        intervals [1360]:
            xmin = 2702.320000
            xmax = 2703.520000
            text = "užduotį suformulavai"
        intervals [1361]:
            xmin = 2703.520000
            xmax = 2775.720000
            text = ""
        intervals [1362]:
            xmin = 2775.720000
            xmax = 2779.710000
            text = "Sudėtinga atsakyti, bet aš manau, kad yra problemų su"
        intervals [1363]:
            xmin = 2779.710000
            xmax = 2780.130000
            text = ""
        intervals [1364]:
            xmin = 2780.130000
            xmax = 2782.957000
            text = "mūsų mokslo pasauliu. Visų pirma todėl, kad"
        intervals [1365]:
            xmin = 2782.957000
            xmax = 2783.150000
            text = ""
        intervals [1366]:
            xmin = 2783.150000
            xmax = 2784.120000
            text = "mes neturime"
        intervals [1367]:
            xmin = 2784.120000
            xmax = 2784.840000
            text = ""
        intervals [1368]:
            xmin = 2784.840000
            xmax = 2787.330000
            text = "mokslinės istorijos didaktikos. Lietuvoje"
        intervals [1369]:
            xmin = 2787.330000
            xmax = 2787.690000
            text = ""
        intervals [1370]:
            xmin = 2787.690000
            xmax = 2792.310000
            text = "po nepriklausomybės atkūrimo po devyniasdešimtų metų, jeigu aš neklystu, vos dvi"
        intervals [1371]:
            xmin = 2792.310000
            xmax = 2792.720000
            text = ""
        intervals [1372]:
            xmin = 2792.720000
            xmax = 2797.700000
            text = "yra daktaro disertacijos, apgintos konkrečiai iš istorijos didaktikos srities."
        intervals [1373]:
            xmin = 2797.700000
            xmax = 2800.460000
            text = "Tai profesoriaus Benedikto Šetkaus ir"
        intervals [1374]:
            xmin = 2800.460000
            xmax = 2801.030000
            text = ""
        intervals [1375]:
            xmin = 2801.030000
            xmax = 2805.662000
            text = "daktaro Algio Bitauto daugiau aš tai kažkaip ir nežinau. Galbūt dar kažkokia viena kita"
        intervals [1376]:
            xmin = 2805.662000
            xmax = 2805.920000
            text = ""
        intervals [1377]:
            xmin = 2805.920000
            xmax = 2806.460000
            text = "atsiprašau."
        intervals [1378]:
            xmin = 2806.460000
            xmax = 2806.730000
            text = ""
        intervals [1379]:
            xmin = 2806.730000
            xmax = 2807.090000
            text = "Dar"
        intervals [1380]:
            xmin = 2807.090000
            xmax = 2809.192000
            text = ""
        intervals [1381]:
            xmin = 2809.192000
            xmax = 2810.780000
            text = "susijęs su istorijos didaktika."
        intervals [1382]:
            xmin = 2810.780000
            xmax = 2811.110000
            text = ""
        intervals [1383]:
            xmin = 2811.110000
            xmax = 2814.440000
            text = "Dalykai ir viskas. Mes neturime tų mokslinių tyrimų."
        intervals [1384]:
            xmin = 2814.440000
            xmax = 2815.040000
            text = ""
        intervals [1385]:
            xmin = 2815.040000
            xmax = 2816.390000
            text = "Taigi mokslas"
        intervals [1386]:
            xmin = 2816.390000
            xmax = 2816.570000
            text = ""
        intervals [1387]:
            xmin = 2816.570000
            xmax = 2820.560000
            text = "nesugeba paaiškinti klausimų, kurie yra reikalingi."
        intervals [1388]:
            xmin = 2820.560000
            xmax = 2820.740000
            text = ""
        intervals [1389]:
            xmin = 2820.740000
            xmax = 2823.170000
            text = "Na, mokykloje ir gaunasi ta tokia"
        intervals [1390]:
            xmin = 2823.170000
