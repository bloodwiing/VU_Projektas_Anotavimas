            text = "yra sparčiai nykstantis atributas"
        intervals [417]:
            xmin = 879.303000
            xmax = 879.540000
            text = ""
        intervals [418]:
            xmin = 879.540000
            xmax = 881.520000
            text = "dėl įvairiausių dalykų - tiek dėl"
        intervals [419]:
            xmin = 881.520000
            xmax = 881.790000
            text = ""
        intervals [420]:
            xmin = 881.790000
            xmax = 883.710000
            text = "mokomųjų priemonių, tiek dėl"
        intervals [421]:
            xmin = 883.710000
            xmax = 884.010000
            text = ""
        intervals [422]:
            xmin = 884.010000
            xmax = 885.270000
            text = "pačių mokytojų"
        intervals [423]:
            xmin = 885.270000
            xmax = 885.780000
            text = ""
        intervals [424]:
            xmin = 885.780000
            xmax = 887.370000
            text = "profesinio tobulėjimo,"
        intervals [425]:
            xmin = 887.370000
            xmax = 887.820000
            text = ""
        intervals [426]:
            xmin = 887.820000
            xmax = 888.786000
            text = "bet natūralu, kad"
        intervals [427]:
            xmin = 888.786000
            xmax = 889.018000
            text = ""
        intervals [428]:
            xmin = 889.018000
            xmax = 892.740000
            text = "dažnai žmonės, prisimindami savo patirtis, istorijos mokymosi,"
        intervals [429]:
            xmin = 892.740000
            xmax = 892.920000
            text = ""
        intervals [430]:
            xmin = 892.920000
            xmax = 894.060000
            text = "vis dar tai atsimena,"
        intervals [431]:
            xmin = 894.060000
            xmax = 894.540000
            text = ""
        intervals [432]:
            xmin = 894.540000
            xmax = 899.100000
            text = "ir tada jiems tarsi suponuoja mintį, kad ir šių dienų vaikai visi taip pat mokosi"
        intervals [433]:
            xmin = 899.100000
            xmax = 900.090000
            text = "istorijos dalyko."
        intervals [434]:
            xmin = 900.090000
            xmax = 913.770000
            text = ""
        intervals [435]:
            xmin = 913.770000
            xmax = 918.450000
            text = "Oi, aš manau, daug turėjau sėkmingų pamokų. Lygiai taip pat, kaip ir daugybę nesėkmingų pamokų"
        intervals [436]:
            xmin = 918.450000
            xmax = 919.838000
            text = "turėdavau aš visuomet"
        intervals [437]:
            xmin = 919.838000
            xmax = 920.175000
            text = ""
        intervals [438]:
            xmin = 920.175000
            xmax = 921.300000
            text = "studentam savo"
        intervals [439]:
            xmin = 921.300000
            xmax = 921.480000
            text = ""
        intervals [440]:
            xmin = 921.480000
            xmax = 923.280000
            text = "patardavau, ir šiais laikais patariu,"
        intervals [441]:
            xmin = 923.280000
            xmax = 923.610000
            text = ""
        intervals [442]:
            xmin = 923.610000
            xmax = 928.470000
            text = "kad po pamokos jie pamėgintų rasti vieną minutę dvi minutes laiko"
        intervals [443]:
            xmin = 928.470000
            xmax = 928.680000
            text = ""
        intervals [444]:
            xmin = 928.680000
            xmax = 931.080000
            text = "pagalvoti, o kaip man čia pasisekė toj pamokoj"
        intervals [445]:
            xmin = 931.080000
            xmax = 931.320000
            text = ""
        intervals [446]:
            xmin = 931.320000
            xmax = 935.790000
            text = "Aš manau, kiekvienas mokytojas visuomet tai jaučia. Nu, ar aš pagavau tuos"
        intervals [447]:
            xmin = 935.790000
            xmax = 940.470000
            text = "mokinius? Ar jie pamėgino padaryti, ar jiems pavyko tai, ko aš norėjau iš jų?"
        intervals [448]:
            xmin = 940.470000
            xmax = 940.950000
            text = ""
        intervals [449]:
            xmin = 940.950000
            xmax = 943.050000
            text = "Ar man pavyko tas vat kelias?"
        intervals [450]:
            xmin = 943.050000
            xmax = 943.320000
            text = ""
        intervals [451]:
            xmin = 943.320000
            xmax = 945.120000
            text = "Bet man tokia viena pamoka įsiminė."
        intervals [452]:
            xmin = 945.120000
            xmax = 945.360000
            text = ""
        intervals [453]:
            xmin = 945.360000
            xmax = 948.090000
            text = "Yra toks dalykas, išorinis mokyklų vertinimas,"
        intervals [454]:
            xmin = 948.090000
            xmax = 948.270000
            text = ""
        intervals [455]:
            xmin = 948.270000
            xmax = 949.230000
            text = "kuomet ateina"
        intervals [456]:
            xmin = 949.230000
            xmax = 949.530000
            text = ""
        intervals [457]:
            xmin = 949.530000
            xmax = 954.150000
            text = "vertintojai iš kitų miestų, iš kitų mokyklų. Na, ir jie stebi tavo pamoką."
        intervals [458]:
            xmin = 954.150000
            xmax = 954.510000
            text = ""
        intervals [459]:
            xmin = 954.510000
            xmax = 961.710000
            text = "Aišku, visuomet čia sakoma. Čia ne tik mokytoją vertina, bet visą sistemą, nu bet vis tiek. Tai yra tam tikras iššūkis mokytojui, nes, na"
        intervals [460]:
            xmin = 961.710000
            xmax = 962.070000
            text = ""
        intervals [461]:
            xmin = 962.070000
            xmax = 965.250000
            text = "suaugę žmonės, pripažinkim, nelabai mėgsta būti vertinami."
        intervals [462]:
            xmin = 965.250000
            xmax = 965.760000
            text = ""
        intervals [463]:
            xmin = 965.760000
            xmax = 968.340000
            text = "Na, ir čia istorija nutiko prieš keletą metų."
        intervals [464]:
            xmin = 968.340000
            xmax = 968.610000
            text = ""
        intervals [465]:
            xmin = 968.610000
            xmax = 971.610000
            text = "Mano pamokas stebėjo. Paprastai ten stebi po dvi"
        intervals [466]:
            xmin = 971.610000
            xmax = 971.790000
            text = ""
        intervals [467]:
            xmin = 971.790000
            xmax = 975.480000
            text = "kartais tris pamokas ir, mano jau buvo keturias pamokas stebėję."
        intervals [468]:
            xmin = 975.480000
            xmax = 975.960000
            text = ""
        intervals [469]:
            xmin = 975.960000
            xmax = 978.630000
            text = "Ir aš buvau tiesiog šventai įsitikinęs, kad"
        intervals [470]:
            xmin = 978.630000
            xmax = 979.020000
            text = ""
        intervals [471]:
            xmin = 979.020000
            xmax = 982.650000
            text = "mano pamokos daugiau nebestebės. Joks išorinis vertintojas."
        intervals [472]:
            xmin = 982.650000
            xmax = 982.980000
            text = ""
        intervals [473]:
            xmin = 982.980000
            xmax = 986.190000
            text = "Aš visuomet labai ruošiuosi savo pamokoms. Tikrai"
        intervals [474]:
            xmin = 986.190000
            xmax = 986.490000
            text = ""
        intervals [475]:
            xmin = 986.490000
            xmax = 989.678000
            text = "turiu ir pateiktis pasidaręs ir užduotis. Tai"
        intervals [476]:
            xmin = 989.678000
            xmax = 990.120000
            text = ""
        intervals [477]:
            xmin = 990.120000
            xmax = 991.470000
            text = "nėra tai, kad aš ateinu"
        intervals [478]:
            xmin = 991.470000
            xmax = 991.710000
            text = ""
        intervals [479]:
            xmin = 991.710000
            xmax = 991.980000
            text = "per"
        intervals [480]:
            xmin = 991.980000
            xmax = 992.130000
            text = ""
        intervals [481]:
            xmin = 992.130000
            xmax = 995.670000
            text = "kabineto slenkstį ir tik tuomet sugalvoju, ką reikia daryt tai. Niekada taip nėra buvę."
        intervals [482]:
            xmin = 995.670000
            xmax = 996.030000
            text = ""
        intervals [483]:
            xmin = 996.030000
            xmax = 998.460000
            text = "Tai va, tai aš kažkaip galvojau. Nieks pas mane nebeateis."
        intervals [484]:
            xmin = 998.460000
            xmax = 998.610000
            text = ""
        intervals [485]:
            xmin = 998.610000
            xmax = 1002.780000
            text = "Per pertrauką ieškau savo auklėtinių. Ten kažkokius reikalus išsprendėm ir"
        intervals [486]:
            xmin = 1002.780000
            xmax = 1003.050000
            text = ""
        intervals [487]:
            xmin = 1003.050000
            xmax = 1007.820000
            text = "sulig skambučiu įlekiu į klasę ir kažką ten vaikam pradedu. Dvyliktokai tuo metu buvo"
        intervals [488]:
            xmin = 1007.820000
            xmax = 1008.750000
            text = "kažką aš jiem ten"
        intervals [489]:
            xmin = 1008.750000
            xmax = 1009.080000
            text = ""
        intervals [490]:
            xmin = 1009.080000
            xmax = 1011.030000
            text = "reiškia. Juokus pasakoti,"
        intervals [491]:
            xmin = 1011.030000
            xmax = 1011.540000
            text = ""
        intervals [492]:
            xmin = 1011.540000
            xmax = 1012.170000
            text = "įžangai"
        intervals [493]:
            xmin = 1012.170000
            xmax = 1012.380000
            text = ""
        intervals [494]:
            xmin = 1012.380000
            xmax = 1014.163000
            text = "ir aš pasuku galvą, žiūri, sėdi "
        intervals [495]:
            xmin = 1014.163000
            xmax = 1015.710000
            text = ""
        intervals [496]:
            xmin = 1015.710000
            xmax = 1016.294000
            text = "na, ir mes"
        intervals [497]:
            xmin = 1016.294000
            xmax = 1016.558000
            text = ""
        intervals [498]:
            xmin = 1016.558000
            xmax = 1019.880000
            text = "turėjome tada pamoką apie karą Ramiajame vandenyne,"
        intervals [499]:
            xmin = 1019.880000
            xmax = 1020.250000
            text = ""
        intervals [500]:
            xmin = 1020.250000
            xmax = 1022.396000
            text = "ir tada mes pradėjom viską dirbt"
        intervals [501]:
            xmin = 1022.396000
            xmax = 1022.622000
            text = ""
        intervals [502]:
            xmin = 1022.622000
            xmax = 1024.689000
            text = "tokia nuotaika. Labai toks tempas, labai"
        intervals [503]:
            xmin = 1024.689000
            xmax = 1024.690000
            text = ""
        intervals [504]:
            xmin = 1024.690000
            xmax = 1025.260000
            text = "geras,"
        intervals [505]:
            xmin = 1025.260000
            xmax = 1025.500000
            text = ""
        intervals [506]:
            xmin = 1025.500000
            xmax = 1027.569000
            text = "labai geras mokinių įsitraukimas,"
        intervals [507]:
            xmin = 1027.569000
            xmax = 1027.810000
            text = ""
        intervals [508]:
            xmin = 1027.810000
            xmax = 1028.589000
            text = "ir po to"
        intervals [509]:
            xmin = 1028.589000
            xmax = 1028.740000
            text = ""
        intervals [510]:
            xmin = 1028.740000
            xmax = 1032.728000
            text = "tas vertintojas sako: žinot, Mindaugai, aš tiesiog esu apakęs. "
        intervals [511]:
            xmin = 1032.728000
            xmax = 1033.569000
            text = ""
        intervals [512]:
            xmin = 1033.569000
            xmax = 1035.250000
            text = "geriausia mano matyta pamoka,"
        intervals [513]:
            xmin = 1035.250000
            xmax = 1035.609000
            text = ""
        intervals [514]:
            xmin = 1035.609000
            xmax = 1036.569000
            text = "ir aš galvoju."
        intervals [515]:
            xmin = 1036.569000
            xmax = 1036.960000
            text = ""
        intervals [516]:
            xmin = 1036.960000
            xmax = 1040.890000
            text = "Bet tai tikriausiai yra viena iš geriausių ir mano vestų pamokų,"
        intervals [517]:
            xmin = 1040.890000
            xmax = 1041.339000
            text = ""
        intervals [518]:
            xmin = 1041.339000
            xmax = 1044.778000
            text = "kai nebuvo jokios įtampos, jokio tokio žinot,"
        intervals [519]:
            xmin = 1044.778000
            xmax = 1045.390000
            text = ""
        intervals [520]:
            xmin = 1045.390000
            xmax = 1048.540000
            text = "perspausto mėginimo tempą didinti"
        intervals [521]:
            xmin = 1048.540000
            xmax = 1049.364000
            text = ""
        intervals [522]:
            xmin = 1049.364000
            xmax = 1053.400000
            text = "daryti kažkokį tokį. Žinot, presigą. Vaikams nebuvo iš vaikų pusės tokio"
        intervals [523]:
            xmin = 1053.400000
            xmax = 1055.230000
            text = "atmetimo, nes tas yra labai svarbu."
        intervals [524]:
            xmin = 1055.230000
            xmax = 1055.530000
            text = ""
        intervals [525]:
            xmin = 1055.530000
            xmax = 1057.060000
            text = "Kartais ateini į pamoką"
        intervals [526]:
            xmin = 1057.060000
            xmax = 1057.360000
            text = ""
        intervals [527]:
            xmin = 1057.360000
            xmax = 1061.770000
            text = "ir tu jauti, kad vaikai atmeta tai, ką tu darai, ir tai nereiškia, kad vaikų tai yra"
        intervals [528]:
            xmin = 1061.770000
            xmax = 1062.400000
            text = "problema."
        intervals [529]:
            xmin = 1062.400000
            xmax = 1062.670000
            text = ""
        intervals [530]:
            xmin = 1062.670000
            xmax = 1064.380000
            text = "Tai tikriausiai yra tavo problema,"
        intervals [531]:
            xmin = 1064.380000
            xmax = 1064.680000
            text = ""
        intervals [532]:
            xmin = 1064.680000
            xmax = 1067.230000
            text = "nes, na, tikrai vaikai yra skirtingi,"
        intervals [533]:
            xmin = 1067.230000
            xmax = 1067.350000
            text = ""
        intervals [534]:
            xmin = 1067.350000
            xmax = 1072.180000
            text = "skirtingos, netgi paralelinės klasės su viena klase pavyksta tas užduotis"
        intervals [535]:
            xmin = 1072.180000
            xmax = 1073.920000
            text = "padaryti su kita. Žiūrėk, jau ne."
        intervals [536]:
            xmin = 1073.920000
            xmax = 1074.190000
            text = ""
        intervals [537]:
            xmin = 1074.190000
            xmax = 1075.690000
            text = "Aha, tai aš visada"
        intervals [538]:
            xmin = 1075.690000
            xmax = 1076.020000
            text = ""
        intervals [539]:
            xmin = 1076.020000
            xmax = 1079.680000
            text = "taip vat galvoju, kaip čia padaryt kitą kartą, kad jiems būtų geriau,"
        intervals [540]:
            xmin = 1079.680000
            xmax = 1080.040000
            text = ""
        intervals [541]:
            xmin = 1080.040000
            xmax = 1081.870000
            text = "nenurašau visko tiktai"
        intervals [542]:
            xmin = 1081.870000
            xmax = 1082.020000
            text = ""
        intervals [543]:
            xmin = 1082.020000
            xmax = 1084.375000
            text = "ant vaikų. Taip kartais būna vaikai. "
        intervals [544]:
            xmin = 1084.375000
            xmax = 1084.669000
            text = ""
        intervals [545]:
            xmin = 1084.669000
            xmax = 1085.208000
            text = "Mokiniai"
        intervals [546]:
            xmin = 1085.208000
            xmax = 1085.560000
            text = ""
        intervals [547]:
            xmin = 1085.560000
            xmax = 1087.763000
            text = "yra ta amžiaus grupė, kuri"
        intervals [548]:
            xmin = 1087.763000
            xmax = 1088.094000
            text = ""
        intervals [549]:
            xmin = 1088.094000
            xmax = 1090.120000
            text = "skiria daugybę išmėginimų mokytojui."
        intervals [550]:
            xmin = 1090.120000
            xmax = 1090.480000
            text = ""
        intervals [551]:
            xmin = 1090.480000
            xmax = 1094.410000
            text = "Ypatingai, jeigu tu esi jaunas mokytojas, jeigu tu esi ką tik atėjęs"
        intervals [552]:
            xmin = 1094.410000
            xmax = 1094.590000
            text = ""
        intervals [553]:
            xmin = 1094.590000
            xmax = 1096.420000
            text = "į tą mokyklą dirbti, mokytojas"
        intervals [554]:
            xmin = 1096.420000
            xmax = 1096.750000
            text = ""
        intervals [555]:
            xmin = 1096.750000
            xmax = 1098.580000
            text = "jie tau skiria daugybę išmėginimų,"
        intervals [556]:
            xmin = 1098.580000
            xmax = 1098.850000
            text = ""
        intervals [557]:
            xmin = 1098.850000
            xmax = 1103.710000
            text = "ir jeigu tu nepasiduodi įveikti tuos išmėginimus, tai užsitarnauji gero"
        intervals [558]:
            xmin = 1103.710000
            xmax = 1104.940000
            text = "mokytojo įvaizdį."
        intervals [559]:
            xmin = 1104.940000
            xmax = 1105.310000
            text = ""
        intervals [560]:
            xmin = 1105.310000
            xmax = 1108.940000
            text = "Nežinau, ar tai yra vardas, bet įvaizdis - tai galimas toksai"
        intervals [561]:
            xmin = 1108.940000
            xmax = 1109.300000
            text = ""
        intervals [562]:
            xmin = 1109.300000
            xmax = 1113.680000
            text = "ir aš. Todėl labai skeptiškai visuomet vertinu ir savikritiškai save. Kai"
        intervals [563]:
            xmin = 1113.680000
            xmax = 1116.120000
            text = "sako va tu esi ten geras mokytojas tai"
        intervals [564]:
            xmin = 1116.120000
            xmax = 1116.440000
            text = ""
        intervals [565]:
            xmin = 1116.440000
            xmax = 1120.072000
            text = "na, nežinau, kokie kriterijai. Baigtinis sąrašas ."
        intervals [566]:
            xmin = 1120.072000
            xmax = 1120.265000
            text = ""
        intervals [567]:
            xmin = 1120.265000
            xmax = 1121.095000
            text = "būtų"
        intervals [568]:
            xmin = 1121.095000
            xmax = 1121.888000
            text = ""
        intervals [569]:
            xmin = 1121.888000
            xmax = 1125.470000
            text = "mokytojas turi atitikti, kad būtų geras. Čia yra labai universalūs dalykai."
        intervals [570]:
            xmin = 1125.470000
            xmax = 1125.800000
            text = ""
        intervals [571]:
            xmin = 1125.800000
            xmax = 1128.470000
            text = "Aš pažįstu mokytojų ir esu matęs, kaip jie dirba."
        intervals [572]:
            xmin = 1128.470000
            xmax = 1128.680000
            text = ""
        intervals [573]:
            xmin = 1128.680000
            xmax = 1133.360000
            text = "Jų didaktika yra visiškai dvidešimto amžiaus pradžios. Nieko ten nėra šiuolaikiško,"
        intervals [574]:
            xmin = 1133.360000
            xmax = 1133.600000
            text = ""
        intervals [575]:
            xmin = 1133.600000
            xmax = 1137.200000
            text = "bet jie taip puikiai įtraukia mokinius."
        intervals [576]:
            xmin = 1137.200000
            xmax = 1137.380000
            text = ""
        intervals [577]:
            xmin = 1137.380000
            xmax = 1139.300000
            text = "Šakės, mokiniai juos myli."
        intervals [578]:
            xmin = 1139.300000
            xmax = 1139.660000
            text = ""
        intervals [579]:
            xmin = 1139.660000
            xmax = 1143.110000
            text = "Ir yra daugybė mokytojų, kurie labai, sakykime,"
        intervals [580]:
            xmin = 1143.110000
            xmax = 1143.586000
            text = ""
        intervals [581]:
            xmin = 1143.586000
            xmax = 1146.830000
            text = "tiksliai, pagal šiuolaikinės didaktikos principus, dirba."
        intervals [582]:
            xmin = 1146.830000
            xmax = 1147.100000
            text = ""
        intervals [583]:
            xmin = 1147.100000
            xmax = 1151.720000
            text = "Bet mokiniam jie nepatinka. Kažkas vat nesigauna, tokios chemijos,"
        intervals [584]:
            xmin = 1151.720000
            xmax = 1151.960000
            text = ""
        intervals [585]:
            xmin = 1151.960000
            xmax = 1154.660000
            text = "o mokykloje tos chemijos reikia. Šiek tiek"
        intervals [586]:
            xmin = 1154.660000
            xmax = 1154.930000
            text = ""
        intervals [587]:
            xmin = 1154.930000
            xmax = 1156.280000
            text = "reikia žaismingumo."
        intervals [588]:
            xmin = 1156.280000
            xmax = 1156.580000
            text = ""
        intervals [589]:
            xmin = 1156.580000
            xmax = 1158.770000
            text = "Reikia būti ne tik geru dalyko"
        intervals [590]:
            xmin = 1158.770000
            xmax = 1159.010000
            text = ""
        intervals [591]:
            xmin = 1159.010000
            xmax = 1160.000000
            text = "išmanytoju,"
        intervals [592]:
            xmin = 1160.000000
            xmax = 1160.180000
            text = ""
        intervals [593]:
            xmin = 1160.180000
            xmax = 1161.860000
            text = "bet reikia būti ir aktoriumi."
        intervals [594]:
            xmin = 1161.860000
            xmax = 1162.260000
            text = ""
        intervals [595]:
            xmin = 1162.260000
            xmax = 1166.820000
            text = "Reikia mokėti ir balsą tam tikra puse pakreipti, ir galbūt"
        intervals [596]:
            xmin = 1166.820000
            xmax = 1168.080000
            text = "mimiką kažkokią"
        intervals [597]:
            xmin = 1168.080000
            xmax = 1169.340000
            text = ""
        intervals [598]:
            xmin = 1169.340000
            xmax = 1170.780000
            text = "yra daugybė savybių"
        intervals [599]:
            xmin = 1170.780000
            xmax = 1172.405000
            text = ""
        intervals [600]:
            xmin = 1172.405000
            xmax = 1174.148000
            text = "kiekvienas. Mokykloje besimokęs"
        intervals [601]:
            xmin = 1174.148000
            xmax = 1174.380000
            text = ""
        intervals [602]:
            xmin = 1174.380000
            xmax = 1179.360000
            text = "iš tiesų galėtume atrinkti bent po vieną kitą mokytoją, kuris, mūsų galva, buvo tas geras."
        intervals [603]:
            xmin = 1179.360000
            xmax = 1180.290000
            text = "Mes jį prisimenam"
        intervals [604]:
            xmin = 1180.290000
            xmax = 1180.530000
            text = ""
        intervals [605]:
            xmin = 1180.530000
            xmax = 1184.970000
            text = "Aišku, prisimenam ir vieną kitą, kuris buvo blogas, ir tai yra įrodymas, kad mes visi labai"
        intervals [606]:
            xmin = 1184.970000
            xmax = 1187.010000
            text = "individualiai galime įvertinti savo"
        intervals [607]:
            xmin = 1187.010000
            xmax = 1187.280000
            text = ""
        intervals [608]:
            xmin = 1187.280000
            xmax = 1188.570000
            text = "buvusius mokytojus."
        intervals [609]:
            xmin = 1188.570000
            xmax = 1302.550000
            text = ""
        intervals [610]:
            xmin = 1302.550000
            xmax = 1303.199000
            text = "Prie visų"
        intervals [611]:
            xmin = 1303.199000
            xmax = 1303.570000
            text = ""
        intervals [612]:
            xmin = 1303.570000
            xmax = 1304.800000
            text = "galima priskirti"
        intervals [613]:
            xmin = 1304.800000
            xmax = 1305.370000
            text = ""
        intervals [614]:
            xmin = 1305.370000
            xmax = 1310.290000
            text = "matot, koks yra dalykas. Mano santykis su egzaminų sistema yra toks trejopas:"
        intervals [615]:
            xmin = 1310.290000
            xmax = 1310.530000
            text = ""
        intervals [616]:
            xmin = 1310.530000
            xmax = 1311.775000
            text = "visų pirma aš"
        intervals [617]:
            xmin = 1311.775000
            xmax = 1312.150000
            text = ""
        intervals [618]:
            xmin = 1312.150000
            xmax = 1317.160000
            text = "mokyklą baigiau pagal šią egzaminų sistemą, nes jai yra daugiau kaip dvidešim metų, jau"
        intervals [619]:
            xmin = 1317.160000
            xmax = 1317.580000
            text = ""
        intervals [620]:
            xmin = 1317.580000
            xmax = 1319.680000
            text = "tai aš ją žinau šiek tiek taip išsamiau"
        intervals [621]:
            xmin = 1319.680000
            xmax = 1320.309000
            text = ""
        intervals [622]:
            xmin = 1320.309000
            xmax = 1324.720000
            text = "iš vidaus pajautęs, ką tai reiškia mokiniui laikyti tuos egzaminus, nes jie labai menkai"
        intervals [623]:
            xmin = 1324.720000
            xmax = 1325.320000
            text = "pasikeitė."
        intervals [624]:
            xmin = 1325.320000
            xmax = 1325.710000
            text = ""
        intervals [625]:
            xmin = 1325.710000
            xmax = 1328.746000
            text = "Antras mano sąlyčio taškas yra tai, kad aš esu mokytojas "
        intervals [626]:
            xmin = 1328.746000
            xmax = 1329.390000
            text = ""
        intervals [627]:
            xmin = 1329.390000
            xmax = 1331.217000
            text = "per daugiau kaip dešim metų. Visuomet"
        intervals [628]:
            xmin = 1331.217000
            xmax = 1331.419000
            text = ""
        intervals [629]:
            xmin = 1331.419000
            xmax = 1332.311000
            text = "rengdavau mokinius "
        intervals [630]:
            xmin = 1332.311000
            xmax = 1334.130000
            text = ""
        intervals [631]:
            xmin = 1334.130000
            xmax = 1334.910000
            text = "Pasakau tokį"
        intervals [632]:
            xmin = 1334.910000
            xmax = 1335.630000
            text = ""
        intervals [633]:
            xmin = 1335.630000
            xmax = 1339.020000
            text = "klišė. Rengdavau egzaminams, nors taip, tarsi ir"
        intervals [634]:
            xmin = 1339.020000
            xmax = 1339.410000
            text = ""
        intervals [635]:
            xmin = 1339.410000
            xmax = 1343.880000
            text = "čia mano toks minusinis būtų kaip mokytojo vertinimo rodiklis, nes, na,"
        intervals [636]:
            xmin = 1343.880000
            xmax = 1344.210000
            text = ""
        intervals [637]:
            xmin = 1344.210000
            xmax = 1348.860000
            text = "tikrai nesu parengęs šimtukininkų. Ten eilės yra mano nemažai mokinių, kurie"
        intervals [638]:
            xmin = 1348.860000
            xmax = 1348.890000
            text = ""
        intervals [639]:
            xmin = 1348.890000
            xmax = 1350.780000
            text = "gavo labai aukštus įvertinimus,"
        intervals [640]:
            xmin = 1350.780000
            xmax = 1351.170000
            text = ""
        intervals [641]:
            xmin = 1351.170000
            xmax = 1356.000000
            text = "bet yra ir tokių kuklių, labai pasiekimų, bet aš kažkaip niekuomet to labai nesusireikšmindavau"
        intervals [642]:
            xmin = 1356.000000
            xmax = 1356.759000
            text = "savo darbe "
        intervals [643]:
            xmin = 1356.759000
            xmax = 1357.750000
            text = ""
        intervals [644]:
            xmin = 1357.750000
            xmax = 1361.680000
            text = "Man buvo gerokai svarbesni kiti dalykai, kad mokinys pažintų istoriją,"
        intervals [645]:
            xmin = 1361.680000
            xmax = 1362.040000
            text = ""
        intervals [646]:
            xmin = 1362.040000
            xmax = 1366.990000
            text = "gautų instrumentus ateity naudotis juos. Na ir trečias mano toks sąlyčio kampas. Tai, kad aš"
        intervals [647]:
            xmin = 1366.990000
            xmax = 1371.970000
            text = "esu istorijos egzamino vyrvertintojas. Tai matau ne tik savo mokinių atsakymus,"
        intervals [648]:
            xmin = 1371.970000
            xmax = 1372.840000
            text = "bet Ir na"
        intervals [649]:
            xmin = 1372.840000
            xmax = 1373.200000
            text = ""
        intervals [650]:
            xmin = 1373.200000
            xmax = 1375.937000
            text = "gerokai platesnės auditorijos mokinių atsakymus. "
        intervals [651]:
            xmin = 1375.937000
            xmax = 1377.400000
            text = ""
        intervals [652]:
            xmin = 1377.400000
            xmax = 1381.720000
            text = "mėgstu kritikuoti egzaminą, nes jis yra neįdomus. Jis yra"
        intervals [653]:
            xmin = 1381.720000
            xmax = 1382.164000
            text = ""
        intervals [654]:
            xmin = 1382.164000
            xmax = 1385.890000
            text = "statiškas ta prasme, kad jeigu mes pasižiūrėtume į užduotis, vyrauja"
        intervals [655]:
            xmin = 1385.890000
            xmax = 1386.560000
            text = ""
        intervals [656]:
            xmin = 1386.560000
            xmax = 1391.360000
            text = "tokio tipo užduotys, kuomet mokinys turi atrasti atsakymą tekste ir jį elementariai"
        intervals [657]:
            xmin = 1391.360000
            xmax = 1391.390000
            text = ""
        intervals [658]:
            xmin = 1391.390000
            xmax = 1392.657000
            text = "perrašyti. Nu toks"
        intervals [659]:
            xmin = 1392.657000
            xmax = 1392.877000
            text = ""
        intervals [660]:
            xmin = 1392.877000
            xmax = 1395.590000
            text = "teksto suvokimo darbas. Tai nėra"
        intervals [661]:
            xmin = 1395.590000
            xmax = 1395.620000
            text = ""
        intervals [662]:
            xmin = 1395.620000
            xmax = 1400.360000
            text = "automatiškai blogai, nes iš tiesų tai yra istoriko amato dalis ar ne Aurimai mes Turime"
        intervals [663]:
            xmin = 1400.360000
            xmax = 1400.900000
            text = "surasti"
        intervals [664]:
            xmin = 1400.900000
            xmax = 1401.170000
            text = ""
        intervals [665]:
            xmin = 1401.170000
            xmax = 1403.990000
            text = "šaltinyje, tam tikrą informaciją, suprasti, išskaityti."
        intervals [666]:
            xmin = 1403.990000
            xmax = 1404.407000
            text = ""
        intervals [667]:
            xmin = 1404.407000
            xmax = 1408.880000
            text = "Bet vis dėlto, kai vyrauja tik tokio tipo užduotys, nelieka to"
        intervals [668]:
            xmin = 1408.880000
            xmax = 1409.480000
            text = "tokio."
        intervals [669]:
            xmin = 1409.480000
            xmax = 1409.870000
            text = ""
        intervals [670]:
            xmin = 1409.870000
            xmax = 1412.330000
            text = "nu, pasakysiu, draivo istorijos,"
        intervals [671]:
            xmin = 1412.330000
            xmax = 1412.480000
            text = ""
        intervals [672]:
            xmin = 1412.480000
            xmax = 1414.550000
            text = "kas veža, tai yra ta tėkmė,"
        intervals [673]:
            xmin = 1414.550000
            xmax = 1414.780000
            text = ""
        intervals [674]:
            xmin = 1414.780000
            xmax = 1416.340000
            text = "įdomybės, tam tikros."
        intervals [675]:
            xmin = 1416.340000
            xmax = 1416.610000
            text = ""
        intervals [676]:
            xmin = 1416.610000
            xmax = 1417.270000
            text = "Jis yra"
        intervals [677]:
            xmin = 1417.270000
            xmax = 1417.630000
            text = ""
        intervals [678]:
            xmin = 1417.630000
            xmax = 1421.230000
            text = "taip gerai didaktiškai, nugludintas, kad nekeltų, jokių,"
        intervals [679]:
            xmin = 1421.230000
            xmax = 1421.620000
            text = ""
        intervals [680]:
            xmin = 1421.620000
            xmax = 1422.340000
            text = "dažniausiai"
        intervals [681]:
            xmin = 1422.340000
            xmax = 1422.460000
            text = ""
        intervals [682]:
            xmin = 1422.460000
            xmax = 1423.150000
            text = "nekeltų jokių"
        intervals [683]:
            xmin = 1423.150000
            xmax = 1423.300000
            text = ""
        intervals [684]:
            xmin = 1423.300000
            xmax = 1424.230000
            text = "dviprasmybių."
        intervals [685]:
            xmin = 1424.230000
            xmax = 1424.560000
            text = ""
        intervals [686]:
            xmin = 1424.560000
            xmax = 1427.470000
            text = "Ir va čia dingsta tas žaismingumas, visas istorijos"
        intervals [687]:
            xmin = 1427.470000
            xmax = 1427.710000
            text = ""
        intervals [688]:
            xmin = 1427.710000
            xmax = 1430.620000
            text = "mes neklausiame mokinių. O kaip tu manai,"
        intervals [689]:
            xmin = 1430.620000
            xmax = 1431.130000
            text = ""
        intervals [690]:
            xmin = 1431.130000
            xmax = 1434.313000
            text = "nes bijome, kad negalėsime įvertinti, nes,"
        intervals [691]:
            xmin = 1434.313000
            xmax = 1434.640000
            text = ""
        intervals [692]:
            xmin = 1434.640000
            xmax = 1435.240000
            text = "aišku, mes"
        intervals [693]:
            xmin = 1435.240000
            xmax = 1435.750000
            text = ""
        intervals [694]:
            xmin = 1435.750000
            xmax = 1440.310000
            text = "oficialiai nesakome, kad mes bijom, kad negalėsim įvertint. Mes sakom, kad mokiniai nepajėgūs to"
        intervals [695]:
            xmin = 1440.310000
            xmax = 1440.910000
            text = "padaryti."
        intervals [696]:
            xmin = 1440.910000
            xmax = 1441.990000
            text = ""
        intervals [697]:
            xmin = 1441.990000
            xmax = 1443.310000
            text = "Mes jų neklausiame."
        intervals [698]:
            xmin = 1443.310000
            xmax = 1443.686000
            text = ""
        intervals [699]:
            xmin = 1443.686000
            xmax = 1447.940000
            text = "Ką jie žino arba ką jie galvoja apie tam tikrus kontroversiškus klausimus?"
        intervals [700]:
            xmin = 1447.940000
            xmax = 1448.120000
            text = ""
        intervals [701]:
            xmin = 1448.120000
            xmax = 1449.020000
            text = "vat štai, tarkime,"
        intervals [702]:
            xmin = 1449.020000
            xmax = 1449.470000
            text = ""
        intervals [703]:
            xmin = 1449.470000
            xmax = 1450.230000
            text = "Generolas"
        intervals [704]:
            xmin = 1450.230000
            xmax = 1450.444000
            text = ""
        intervals [705]:
            xmin = 1450.444000
            xmax = 1453.910000
            text = "Vėtra ar ne slapyvardžiu? Jonas Noreika. Jo viso klausimo"
        intervals [706]:
            xmin = 1453.910000
            xmax = 1456.160000
            text = "iškėlimas pastaraisiais metais yra tokios"
        intervals [707]:
            xmin = 1456.160000
            xmax = 1456.430000
            text = ""
        intervals [708]:
            xmin = 1456.430000
            xmax = 1458.290000
            text = "intelektualiosios visuomenės"
        intervals [709]:
            xmin = 1458.290000
            xmax = 1458.620000
            text = ""
        intervals [710]:
            xmin = 1458.620000
            xmax = 1460.030000
            text = "diskusijų objektas."
        intervals [711]:
            xmin = 1460.030000
            xmax = 1461.290000
            text = ""
        intervals [712]:
            xmin = 1461.290000
            xmax = 1462.850000
            text = "tai beveik nieko nežino."
        intervals [713]:
            xmin = 1462.850000
            xmax = 1463.090000
            text = ""
        intervals [714]:
            xmin = 1463.090000
            xmax = 1466.450000
            text = "Nes jų laukas yra kitas per istorijos pamokas apie tai nekalbam"
        intervals [715]:
            xmin = 1466.450000
            xmax = 1466.720000
            text = ""
        intervals [716]:
            xmin = 1466.720000
            xmax = 1467.950000
            text = "ir aš prieš porą metų"
        intervals [717]:
            xmin = 1467.950000
            xmax = 1468.220000
            text = ""
        intervals [718]:
            xmin = 1468.220000
            xmax = 1470.860000
            text = "pateikiau jiems užduotį pasidomėti tuo lauku,"
        intervals [719]:
            xmin = 1470.860000
            xmax = 1471.340000
            text = ""
        intervals [720]:
            xmin = 1471.340000
            xmax = 1472.870000
            text = "kokia jūsų yra nuomonė,"
        intervals [721]:
            xmin = 1472.870000
            xmax = 1473.210000
            text = ""
        intervals [722]:
            xmin = 1473.210000
            xmax = 1473.810000
            text = "ir jie"
        intervals [723]:
            xmin = 1473.810000
            xmax = 1474.582000
            text = ""
        intervals [724]:
            xmin = 1474.582000
            xmax = 1479.060000
            text = "jie tiesiog vau. Kokių čia dalykų, kiek čia tos diskusijos yra išplėtotos,"
        intervals [725]:
            xmin = 1479.060000
            xmax = 1479.900000
            text = ""
        intervals [726]:
            xmin = 1479.900000
            xmax = 1483.170000
            text = "aš čia nekaltinu mokinių sakydamas, kad jie nesidomi tais dalykais."
        intervals [727]:
            xmin = 1483.170000
            xmax = 1483.350000
            text = ""
        intervals [728]:
            xmin = 1483.350000
            xmax = 1484.070000
            text = "Aš čia daugiau,"
        intervals [729]:
            xmin = 1484.070000
            xmax = 1484.220000
            text = ""
        intervals [730]:
            xmin = 1484.220000
            xmax = 1487.280000
            text = "metu akmenuką į mūsų suaugusių daržą, kad mes kažkaip"
        intervals [731]:
            xmin = 1487.280000
            xmax = 1488.480000
            text = ""
        intervals [732]:
            xmin = 1488.480000
            xmax = 1489.980000
            text = "tą istoriją taip, na,"
        intervals [733]:
            xmin = 1489.980000
            xmax = 1490.280000
            text = ""
        intervals [734]:
            xmin = 1490.280000
            xmax = 1491.390000
            text = "nususinam,"
        intervals [735]:
            xmin = 1491.390000
            xmax = 1491.540000
            text = ""
        intervals [736]:
            xmin = 1491.540000
            xmax = 1492.560000
            text = "padarom tokiu"
        intervals [737]:
            xmin = 1492.560000
            xmax = 1492.920000
            text = ""
        intervals [738]:
            xmin = 1492.920000
            xmax = 1495.020000
            text = "labai sausu mokslu,"
        intervals [739]:
            xmin = 1495.020000
            xmax = 1495.380000
            text = ""
        intervals [740]:
            xmin = 1495.380000
            xmax = 1499.970000
            text = "nes galvojam, kad tada pasiekiame tuos rezultatus ir patikrinam kažką"
        intervals [741]:
            xmin = 1499.970000
            xmax = 1500.240000
            text = ""
        intervals [742]:
            xmin = 1500.240000
            xmax = 1503.420000
            text = "taip. Istorijos egzaminas patikrina tam tikrus gebėjimus,"
        intervals [743]:
            xmin = 1503.420000
            xmax = 1504.590000
            text = ""
        intervals [744]:
            xmin = 1504.590000
            xmax = 1506.720000
            text = "jie yra pakankamai fragmentiški,"
        intervals [745]:
            xmin = 1506.720000
            xmax = 1507.350000
            text = ""
        intervals [746]:
            xmin = 1507.350000
            xmax = 1507.780000
            text = "ir aš"
        intervals [747]:
            xmin = 1507.780000
            xmax = 1508.220000
            text = ""
        intervals [748]:
            xmin = 1508.220000
            xmax = 1511.130000
            text = "su nemaža dalimi ar tai savo buvusių mokinių,"
        intervals [749]:
            xmin = 1511.130000
            xmax = 1511.490000
            text = ""
        intervals [750]:
            xmin = 1511.490000
            xmax = 1512.210000
            text = "ar tai,"
        intervals [751]:
            xmin = 1512.210000
            xmax = 1512.930000
            text = ""
        intervals [752]:
            xmin = 1512.930000
            xmax = 1517.430000
            text = "tarkime, šiaip žmonių, kurie laikė istorijos egzaminą. Šitos sistemos kartais pakabu jie sako"
        intervals [753]:
            xmin = 1517.430000
            xmax = 1517.640000
            text = ""
        intervals [754]:
            xmin = 1517.640000
            xmax = 1521.060000
            text = "daugybės dalykų. Tai ką ten egzaminui reikėjo? aš jau nebepamenu,"
        intervals [755]:
            xmin = 1521.060000
            xmax = 1521.270000
            text = ""
        intervals [756]:
            xmin = 1521.270000
            xmax = 1523.280000
            text = "bet atsimenu ten kažką. Na, tarkim,"
        intervals [757]:
            xmin = 1523.280000
