            xmax = 1206.500000
            text = ""
        intervals [182]:
            xmin = 1206.500000
            xmax = 1208.569000
            text = "tie duomenys yra surašomi į įvairiausias"
        intervals [183]:
            xmin = 1208.569000
            xmax = 1208.720000
            text = ""
        intervals [184]:
            xmin = 1208.720000
            xmax = 1213.370000
            text = "lenteles. yra šimtukininkų kiek yra išlaikiusių, kiek yra neišlaikiusių"
        intervals [185]:
            xmin = 1213.370000
            xmax = 1213.640000
            text = ""
        intervals [186]:
            xmin = 1213.640000
            xmax = 1214.443000
            text = "egzaminus."
        intervals [187]:
            xmin = 1214.443000
            xmax = 1214.690000
            text = ""
        intervals [188]:
            xmin = 1214.690000
            xmax = 1215.496000
            text = "Kitaip sakant,"
        intervals [189]:
            xmin = 1215.496000
            xmax = 1215.860000
            text = ""
        intervals [190]:
            xmin = 1215.860000
            xmax = 1219.893000
            text = "visa kūryba susiveda į nu tokius bejausmius šaltus"
        intervals [191]:
            xmin = 1219.893000
            xmax = 1220.600000
            text = ""
        intervals [192]:
            xmin = 1220.600000
            xmax = 1223.570000
            text = "jaunų žmonių likimus. Sprendžiančius skaičius."
        intervals [193]:
            xmin = 1223.570000
            xmax = 1223.870000
            text = ""
        intervals [194]:
            xmin = 1223.870000
            xmax = 1226.480000
            text = "Pakalbėkim dabar apie istorijos egzaminą ir"
        intervals [195]:
            xmin = 1226.480000
            xmax = 1227.170000
            text = ""
        intervals [196]:
            xmin = 1227.170000
            xmax = 1228.868000
            text = "ruošdamasis mūsų pokalbiui aš"
        intervals [197]:
            xmin = 1228.868000
            xmax = 1229.450000
            text = ""
        intervals [198]:
            xmin = 1229.450000
            xmax = 1234.250000
            text = "atkreipiau dėmesį, kad šių metų birželio dvidešim penktą dieną savo feisbuko profilyje jūs"
        intervals [199]:
            xmin = 1234.250000
            xmax = 1235.360000
            text = "parašėte. Cituoju"
        intervals [200]:
            xmin = 1235.360000
            xmax = 1235.810000
            text = ""
        intervals [201]:
            xmin = 1235.810000
            xmax = 1237.850000
            text = "į istorijos egzaminą. aš Žvelgiu dvejopai:"
        intervals [202]:
            xmin = 1237.850000
            xmax = 1238.180000
            text = ""
        intervals [203]:
            xmin = 1238.180000
            xmax = 1240.250000
            text = "visų pirma, kaip šioks toks specialistas,"
        intervals [204]:
            xmin = 1240.250000
            xmax = 1240.670000
            text = ""
        intervals [205]:
            xmin = 1240.670000
            xmax = 1244.030000
            text = "o antra - kaip istorijos ir ypač tam tikrų jos temų fanas."
        intervals [206]:
            xmin = 1244.030000
            xmax = 1244.330000
            text = ""
        intervals [207]:
            xmin = 1244.330000
            xmax = 1249.310000
            text = "Šiuokart noriu žiūrėti tomis antromis akimis. Itin džiugu, jog užduotyje daug dėmesio skirta"
        intervals [208]:
            xmin = 1249.310000
            xmax = 1250.119000
            text = "partizanams"
        intervals [209]:
            xmin = 1250.119000
            xmax = 1250.600000
            text = ""
        intervals [210]:
            xmin = 1250.600000
            xmax = 1254.980000
            text = "verta reikalinga ir aiškiai parodoma, jog partizanai yra svarbi mūsų valstybės dalis."
        intervals [211]:
            xmin = 1254.980000
            xmax = 1255.340000
            text = ""
        intervals [212]:
            xmin = 1255.340000
            xmax = 1260.140000
            text = "Žinoma, kiek liūdina, jog klausimai pernelyg statiški, nuobodoki trūksta skirtingų pozicijų."
        intervals [213]:
            xmin = 1260.140000
            xmax = 1261.640000
            text = "Vertinimo citatos. Pabaiga,"
        intervals [214]:
            xmin = 1261.640000
            xmax = 1262.240000
            text = ""
        intervals [215]:
            xmin = 1262.240000
            xmax = 1264.940000
            text = "jeigu neklystu, į valstybinį istorijos egzaminą."
        intervals [216]:
            xmin = 1264.940000
            xmax = 1265.260000
            text = ""
        intervals [217]:
            xmin = 1265.260000
            xmax = 1266.250000
            text = "Kaip taisyklė,"
        intervals [218]:
            xmin = 1266.250000
            xmax = 1266.670000
            text = ""
        intervals [219]:
            xmin = 1266.670000
            xmax = 1267.480000
            text = "žvelgiama"
        intervals [220]:
            xmin = 1267.480000
            xmax = 1267.960000
            text = ""
        intervals [221]:
            xmin = 1267.960000
            xmax = 1272.880000
            text = "ir čia. Galima kalbėti ir apie mokytojus, ir apie istorikus, tyrinėtojus iš"
        intervals [222]:
            xmin = 1272.880000
            xmax = 1273.180000
            text = "tokio"
        intervals [223]:
            xmin = 1273.180000
            xmax = 1273.330000
            text = ""
        intervals [224]:
            xmin = 1273.330000
            xmax = 1274.230000
            text = "pesimisto"
        intervals [225]:
            xmin = 1274.230000
            xmax = 1274.530000
            text = ""
        intervals [226]:
            xmin = 1274.530000
            xmax = 1276.696000
            text = "ir saikingo optimisto perspektyvos."
        intervals [227]:
            xmin = 1276.696000
            xmax = 1277.020000
            text = ""
        intervals [228]:
            xmin = 1277.020000
            xmax = 1278.910000
            text = "Pesimistui, kaip taisyklė, viskas blogai,"
        intervals [229]:
            xmin = 1278.910000
            xmax = 1279.330000
            text = ""
        intervals [230]:
            xmin = 1279.330000
            xmax = 1280.080000
            text = "todėl"
        intervals [231]:
            xmin = 1280.080000
            xmax = 1280.560000
            text = ""
        intervals [232]:
            xmin = 1280.560000
            xmax = 1285.480000
            text = "ir egzaminas blogas, todėl ir jį reikia keisti. Nieks nežino, kaip keisti, bet keisti reikia."
        intervals [233]:
            xmin = 1285.480000
            xmax = 1285.870000
            text = ""
        intervals [234]:
            xmin = 1285.870000
            xmax = 1288.900000
            text = "Na, o saikingas optimistas laikosi nuomonės, kad"
        intervals [235]:
            xmin = 1288.900000
            xmax = 1289.200000
            text = ""
        intervals [236]:
            xmin = 1289.200000
            xmax = 1293.580000
            text = "egzaminas iš esmės neblogas, tik jį reikia šiek tiek paremontuoti. Na, dažniausiai irgi"
        intervals [237]:
            xmin = 1293.580000
            xmax = 1293.940000
            text = ""
        intervals [238]:
            xmin = 1293.940000
            xmax = 1295.726000
            text = "nieks nežino, kaip remontuoti, bet"
        intervals [239]:
            xmin = 1295.726000
            xmax = 1296.250000
            text = ""
        intervals [240]:
            xmin = 1296.250000
            xmax = 1299.070000
            text = "apsisprendžiama, kad iš esmės dalykai neblogi. Tai"
        intervals [241]:
            xmin = 1299.070000
            xmax = 1299.490000
            text = ""
        intervals [242]:
            xmin = 1299.490000
            xmax = 1302.070000
            text = "ties kuria gi frakcija galima priskirti jus,"
        intervals [243]:
            xmin = 1302.070000
            xmax = 1665.930000
            text = ""
        intervals [244]:
            xmin = 1665.930000
            xmax = 1670.806000
            text = "Mindaugai, dar vienas klausimas susijęs su egzaminais. Jūs ką tik tai vertindamas."
        intervals [245]:
            xmin = 1670.806000
            xmax = 1671.240000
            text = ""
        intervals [246]:
            xmin = 1671.240000
            xmax = 1673.310000
            text = "Ko gi egzaminatoriai"
        intervals [247]:
            xmin = 1673.310000
