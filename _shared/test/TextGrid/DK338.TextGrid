            text = ""
        intervals [1185]:
            xmin = 2417.840000
            xmax = 2419.790000
            text = "ir jie neturi būt tokie patys kaip tu."
        intervals [1186]:
            xmin = 2419.790000
            xmax = 2420.240000
            text = ""
        intervals [1187]:
            xmin = 2420.240000
            xmax = 2423.480000
            text = "Aš. Beje, šitą pamoką išmokau iš savo buvusių auklėtinių,"
        intervals [1188]:
            xmin = 2423.480000
            xmax = 2423.780000
            text = ""
        intervals [1189]:
            xmin = 2423.780000
            xmax = 2427.320000
            text = "kurie buvo ryškūs intravertai, o aš esu ekstravertas,"
