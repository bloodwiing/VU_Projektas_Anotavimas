            text = ""
        intervals [1146]:
            xmin = 2350.480000
            xmax = 2352.190000
            text = "mokyklinio diskurso."
        intervals [1147]:
            xmin = 2352.190000
            xmax = 2352.550000
            text = ""
        intervals [1148]:
            xmin = 2352.550000
            xmax = 2355.930000
            text = "Tai noriu susikurti tokią aplinką, kuri laiko"
