            text = ""
        intervals [758]:
            xmin = 1523.640000
            xmax = 1524.166000
            text = "aš vat"
        intervals [759]:
            xmin = 1524.166000
            xmax = 1524.570000
            text = ""
        intervals [760]:
            xmin = 1524.570000
            xmax = 1529.310000
            text = "esu pastebėjęs. Vaikai prisimena kažkokius tokius visiškai nereikšmingus dalykus. Tarkim, kažkada"
        intervals [761]:
            xmin = 1529.310000
            xmax = 1529.700000
            text = "sakau,"
        intervals [762]:
            xmin = 1529.700000
            xmax = 1531.410000
            text = ""
        intervals [763]:
            xmin = 1531.410000
            xmax = 1531.860000
            text = "klausia:"
        intervals [764]:
            xmin = 1531.860000
            xmax = 1532.010000
            text = ""
        intervals [765]:
            xmin = 1532.010000
            xmax = 1534.350000
            text = "o ar tikrai Žygimantas Augustas neturėjo vaikų,"
        intervals [766]:
            xmin = 1534.350000
            xmax = 1534.560000
            text = ""
        intervals [767]:
            xmin = 1534.560000
            xmax = 1535.520000
            text = "sakau. Na, žinot,"
        intervals [768]:
            xmin = 1535.520000
            xmax = 1535.730000
