            xmin = 1674.619000
            xmax = 1674.896000
            text = ""
        intervals [250]:
            xmin = 1674.896000
            xmax = 1678.080000
            text = "egzamine atsidūrusių jaunų žmonių? Jūs pasakėt, kad"
