            text = ""
        intervals [1194]:
            xmin = 2435.232000
            xmax = 2439.460000
            text = "štai, kai jau persilaužiau, supratau, kad ir nereikia iš jų reikalauti to,"
        intervals [1195]:
            xmin = 2439.460000
            xmax = 2439.850000
            text = ""
        intervals [1196]:
            xmin = 2439.850000
            xmax = 2441.230000
            text = "kad jie būtų tokie kaip aš"
        intervals [1197]:
            xmin = 2441.230000
            xmax = 2441.590000
            text = ""
        intervals [1198]:
            xmin = 2441.590000
            xmax = 2446.270000
            text = "tada. Na, puikūs yra santykiai po šiai dienai. Palaikom per feisbuką,"
        intervals [1199]:
            xmin = 2446.270000
            xmax = 2448.834000
            text = "susirašom per per kažkur susitinkam"
        intervals [1200]:
