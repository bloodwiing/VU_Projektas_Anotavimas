            text = ""
        intervals [1261]:
            xmin = 2569.960000
            xmax = 2575.030000
            text = "kas yra pramonės perversmas, na ir aš sakau neužmirškit, kad pradedam aiškinti nuo to, kas tai yra"
        intervals [1262]:
            xmin = 2575.030000
            xmax = 2575.300000
            text = ""
        intervals [1263]:
            xmin = 2575.300000
            xmax = 2576.920000
            text = "kėdė, knyga, spinta, stalas."
        intervals [1264]:
