            xmin = 2044.680000
            xmax = 2049.139000
            text = ""
        intervals [991]:
            xmin = 2049.139000
            xmax = 2053.670000
            text = "Mes žaidžiam tokį keistą žaidimą, ir latviai šito žaidimo labai nesupranta ir mums nedovanoja."
