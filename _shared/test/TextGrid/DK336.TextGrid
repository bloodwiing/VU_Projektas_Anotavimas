            text = ""
        intervals [884]:
            xmin = 1818.740000
            xmax = 1822.280000
            text = "Tai, kiek man teko skaityt tų raportų, visokių ir panašiai tai jie dar tokie."
        intervals [885]:
            xmin = 1822.280000
            xmax = 1822.850000
            text = ""
        intervals [886]:
            xmin = 1822.850000
            xmax = 1824.800000
            text = "Rusų kalba versta į lietuvių. Tokia"
        intervals [887]:
            xmin = 1824.800000
            xmax = 1824.980000
            text = ""
        intervals [888]:
            xmin = 1824.980000
            xmax = 1829.360000
            text = "tokia keista, kartais net sunku pasakyt. Bet jie bet jie, kadangi rusiškai supranta,"
        intervals [889]:
            xmin = 1829.360000
            xmax = 1830.413000
            text = "tai tai tai tada"
        intervals [890]:
            xmin = 1830.413000
