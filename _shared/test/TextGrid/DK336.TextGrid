        intervals [119]:
            xmin = 870.959000
            xmax = 871.630000
            text = ""
        intervals [120]:
            xmin = 871.630000
            xmax = 874.270000
            text = "Lietuvos kino studijos dokumentinis filmas"
        intervals [121]:
            xmin = 874.270000
            xmax = 874.660000
            text = ""
        intervals [122]:
            xmin = 874.660000
            xmax = 878.560000
            text = "apie savanorius buvo ir ten amžininkai jau tuomet"
        intervals [123]:
            xmin = 878.560000
            xmax = 878.890000
            text = ""
        intervals [124]:
            xmin = 878.890000
            xmax = 883.840000
            text = "kokiais aštuoniasdešim aštuntais. Aštuoniasdešim devintais. Jiems buvo apie devyniasdešim metų, ir jie"
        intervals [125]:
            xmin = 883.840000
            xmax = 884.080000
            text = "ten"
        intervals [126]:
            xmin = 884.080000
            xmax = 884.410000
            text = ""
        intervals [127]:
            xmin = 884.410000
            xmax = 886.600000
            text = "prisiminimais dalinosi, kaip ėjo"
        intervals [128]:
            xmin = 886.600000
            xmax = 887.170000
            text = ""
        intervals [129]:
            xmin = 887.170000
            xmax = 888.164000
            text = "savanoriais"
        intervals [130]:
            xmin = 888.164000
            xmax = 889.288000
            text = ""
        intervals [131]:
            xmin = 889.288000
            xmax = 891.760000
            text = "į į kažkokį mobilizacijos punktą."
        intervals [132]:
            xmin = 891.760000
            xmax = 893.470000
            text = ""
        intervals [133]:
            xmin = 893.470000
            xmax = 895.750000
            text = "pas kažką tai pasiskolino. Batus"
        intervals [134]:
            xmin = 895.750000
            xmax = 896.380000
            text = ""
        intervals [135]:
            xmin = 896.380000
            xmax = 901.270000
            text = "ir ir buvo toks prašymas, kad atsinešti savo ginklą - kažkokį tai ir, ir"
        intervals [136]:
            xmin = 901.270000
            xmax = 901.867000
            text = "lenkai."
        intervals [137]:
            xmin = 901.867000
            xmax = 902.140000
            text = ""
        intervals [138]:
            xmin = 902.140000
            xmax = 902.593000
            text = "Lenkų"
        intervals [139]:
            xmin = 902.593000
            xmax = 904.150000
            text = ""
        intervals [140]:
            xmin = 904.150000
            xmax = 906.910000
            text = "jaunuoliai iš jų tyčiojasi, sako: va žėkit kareiviai."
        intervals [141]:
            xmin = 906.910000
            xmax = 937.230000
            text = ""
        intervals [142]:
            xmin = 937.230000
            xmax = 939.780000
            text = "laikotarpiu kažkokie tai va tie va tautiniai"
        intervals [143]:
            xmin = 939.780000
            xmax = 967.031000
            text = ""
        intervals [144]:
            xmin = 967.031000
            xmax = 970.010000
            text = "man labai patinka tas pavyzdys, kai kalbam apie apie tautiškumo"
        intervals [145]:
            xmin = 970.010000
            xmax = 972.410000
            text = "supratimą Vilniaus krašte, kad"
        intervals [146]:
            xmin = 972.410000
            xmax = 973.460000
            text = ""
        intervals [147]:
            xmin = 973.460000
            xmax = 975.496000
            text = "žmogui nebuvo jokios problemos"
        intervals [148]:
            xmin = 975.496000
            xmax = 976.010000
            text = ""
        intervals [149]:
            xmin = 976.010000
            xmax = 979.940000
            text = "kalbėti lenkiškai ir save, vadinti lietuviu arba atvirkščiai."
        intervals [150]:
            xmin = 979.940000
            xmax = 980.240000
            text = ""
        intervals [151]:
            xmin = 980.240000
            xmax = 983.780000
            text = "Tai va toks, toks buvo tas Gordijaus mazgas, tautinis"
        intervals [152]:
            xmin = 983.780000
            xmax = 991.428000
            text = ""
        intervals [153]:
            xmin = 991.428000
            xmax = 993.470000
            text = "Didelių miestų problema. Bolševizmas -"
        intervals [154]:
            xmin = 993.470000
            xmax = 1017.828000
            text = ""
        intervals [155]:
            xmin = 1017.828000
            xmax = 1018.725000
            text = "pavyzdžiui, logistika"
        intervals [156]:
            xmin = 1018.725000
            xmax = 1088.460000
            text = ""
        intervals [157]:
            xmin = 1088.460000
            xmax = 1092.870000
            text = "Perfrazuojant Napoleoną, lietuviai galėjo maitinti savo kariuomenę tam, kad"
        intervals [158]:
            xmin = 1092.870000
            xmax = 1094.321000
            text = "nemaitinti svetimos. "
        intervals [159]:
            xmin = 1094.321000
            xmax = 1109.950000
            text = ""
        intervals [160]:
            xmin = 1109.950000
            xmax = 1114.529000
            text = "Trumpam jau užsiminėm apie apie savanorius, apie tą tokį na pakankamai"
        intervals [161]:
            xmin = 1114.529000
            xmax = 1114.660000
            text = ""
        intervals [162]:
            xmin = 1114.660000
            xmax = 1115.410000
            text = "unikalų"
        intervals [163]:
            xmin = 1115.410000
            xmax = 1116.400000
            text = ""
        intervals [164]:
            xmin = 1116.400000
            xmax = 1118.542000
            text = "reiškinį, ar ne pakalbėkim truputėlį "
        intervals [165]:
            xmin = 1118.542000
            xmax = 1120.330000
            text = ""
        intervals [166]:
            xmin = 1120.330000
            xmax = 1124.230000
            text = "Dėl jų atsiradimo, dėl tos idėjos iškėlimo, kaip nutinka, kad"
        intervals [167]:
            xmin = 1124.230000
            xmax = 1124.800000
            text = ""
        intervals [168]:
            xmin = 1124.800000
            xmax = 1130.230000
            text = "kviečia savanorius ne vieną kartą ar ne kviečia prisijungti, ginti jaunąją Lietuvą."
        intervals [169]:
            xmin = 1130.230000
            xmax = 1188.840000
            text = ""
        intervals [170]:
            xmin = 1188.840000
            xmax = 1192.950000
            text = "Čia dėl geopolitikos. Ar mes galim kažkaip tai regionų specifiką prijungti prie to?"
        intervals [171]:
            xmin = 1192.950000
            xmax = 1291.600000
            text = ""
        intervals [172]:
            xmin = 1291.600000
            xmax = 1296.400000
            text = "prakutę ūkininkai galėję išleisti į mokslus savo vaikus ir ir per"
        intervals [173]:
            xmin = 1296.400000
            xmax = 1298.770000
            text = "čia atėjęs supratimas, ar ne, kad"
        intervals [174]:
            xmin = 1298.770000
            xmax = 1350.230000
            text = ""
        intervals [175]:
            xmin = 1350.230000
            xmax = 1353.930000
            text = "pirmasis, pavadinkim tas pirmasis kvietimas. Pirmasis šaukimasis jis"
        intervals [176]:
            xmin = 1353.930000
            xmax = 1354.410000
            text = ""
        intervals [177]:
            xmin = 1354.410000
            xmax = 1356.377000
            text = "nebuvo labai sėkmingas ar ne"
        intervals [178]:
            xmin = 1356.377000
            xmax = 1357.890000
            text = ""
        intervals [179]:
            xmin = 1357.890000
            xmax = 1360.350000
            text = "savanorių, tų žmonių tiek, kiek buvo tikėtasi, ar ne."
        intervals [180]:
