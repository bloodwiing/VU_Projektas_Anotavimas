            text = ""
        intervals [981]:
            xmin = 2031.750000
            xmax = 2037.610000
            text = "O kas mum pinigus skolino? O dar gal ir reikės pasiskolint? O gal reikės dar jeigu su lenkais kariaut o, kas daugiau parems. Tai"
        intervals [982]:
