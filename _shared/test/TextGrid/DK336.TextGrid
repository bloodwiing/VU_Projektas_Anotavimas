            xmin = 2075.520000
            xmax = 2089.810000
            text = ""
        intervals [258]:
            xmin = 2089.810000
            xmax = 2091.354000
            text = "Turbūt šitame ginče tai mes"
        intervals [259]:
            xmin = 2091.354000
            xmax = 2091.699000
            text = ""
        intervals [260]:
            xmin = 2091.699000
            xmax = 2093.482000
            text = "Užtenka prisiminti Klaipėdą, ar ne"
        intervals [261]:
            xmin = 2093.482000
