            text = "taip pat ta motyvacija jų, tokia"
        intervals [1046]:
            xmin = 2151.409000
            xmax = 2167.004000
            text = ""
        intervals [1047]:
            xmin = 2167.004000
            xmax = 2170.330000
            text = "Bermontas Avalovas išvis nieko nepadarė. Tai yra statytinis"
        intervals [1048]:
            xmin = 2170.330000
            xmax = 2170.600000
            text = ""
        intervals [1049]:
            xmin = 2170.600000
            xmax = 2172.850000
            text = "žmogus, kuris realiai kažką padarė. Buvo"
        intervals [1050]:
            xmin = 2172.850000
            xmax = 2179.750000
            text = ""
        intervals [1051]:
            xmin = 2179.750000
            xmax = 2183.110000
            text = "kuris visai nesenai padėjo kurti suomių kariuomenę."
        intervals [1052]:
            xmin = 2183.110000
            xmax = 2183.805000
            text = ""
        intervals [1053]:
            xmin = 2183.805000
            xmax = 2184.970000
            text = "išgarsėjo būtent"
        intervals [1054]:
            xmin = 2184.970000
            xmax = 2185.330000
            text = ""
        intervals [1055]:
            xmin = 2185.330000
            xmax = 2187.707000
            text = "su manerheimu kartu išmetę raudonuosius"
        intervals [1056]:
            xmin = 2187.707000
            xmax = 2187.997000
            text = ""
        intervals [1057]:
            xmin = 2187.997000
            xmax = 2189.350000
            text = "iš Suomijos. Čia buvo jo"
        intervals [1058]:
            xmin = 2189.350000
            xmax = 2189.680000
            text = ""
        intervals [1059]:
            xmin = 2189.680000
            xmax = 2191.810000
            text = "valanda. Tai buvo žmogus, kuris tame,"
        intervals [1060]:
            xmin = 2191.810000
            xmax = 2192.400000
            text = ""
        intervals [1061]:
            xmin = 2192.400000
            xmax = 2196.960000
            text = "sakykime, drumstame vandenyje idealiai galėjo viską daryti. Ir jisai buvo didžioji"
        intervals [1062]:
            xmin = 2196.960000
            xmax = 2197.410000
            text = "figūra,"
        intervals [1063]:
            xmin = 2197.410000
            xmax = 2197.560000
            text = ""
        intervals [1064]:
            xmin = 2197.560000
            xmax = 2203.560000
            text = "ir štai šitas fon der golcas jisai iš tikrųjų su draugais ten buvo ir draugų, tokių parinktų. Jie sukūrė tą"
        intervals [1065]:
            xmin = 2203.560000
            xmax = 2203.920000
            text = ""
        intervals [1066]:
            xmin = 2203.920000
            xmax = 2208.900000
            text = "naują Vokietijos kariuomenę fraikorpsų pagrindu. Fraikorpsai, tai yra Napoleono karų"
        intervals [1067]:
            xmin = 2208.900000
            xmax = 2210.820000
            text = "laikais tokie vokiečių savanorių"
        intervals [1068]:
            xmin = 2210.820000
            xmax = 2210.940000
            text = ""
        intervals [1069]:
            xmin = 2210.940000
            xmax = 2211.990000
            text = "tradiciniai daliniai."
        intervals [1070]:
            xmin = 2211.990000
            xmax = 2212.756000
            text = ""
        intervals [1071]:
            xmin = 2212.756000
            xmax = 2217.270000
            text = "ten jau pas jį suvažiavo ne ta buvusioji vokiečių kariuomenė. Bet tai va šitie fraikorpsai"
        intervals [1072]:
            xmin = 2217.270000
            xmax = 2217.300000
            text = ""
        intervals [1073]:
            xmin = 2217.300000
            xmax = 2217.900000
            text = "iš esmės"
        intervals [1074]:
            xmin = 2217.900000
            xmax = 2220.620000
            text = ""
        intervals [1075]:
            xmin = 2220.620000
            xmax = 2225.210000
            text = "labai įdomi. Tai yra vokiškoji dalis, kuri buvo pakankamai motyvuota patyrusi labai"
        intervals [1076]:
            xmin = 2225.210000
            xmax = 2226.985000
            text = "kovose profesionalūs labai žmonės."
        intervals [1077]:
            xmin = 2226.985000
            xmax = 2228.707000
            text = ""
        intervals [1078]:
            xmin = 2228.707000
            xmax = 2232.410000
            text = "negalėjo kaip vokiečiai veikti. Dėl to jiem reikėjo nusidažyti rusiškom"
        intervals [1079]:
            xmin = 2232.410000
            xmax = 2232.650000
            text = ""
        intervals [1080]:
            xmin = 2232.650000
            xmax = 2237.330000
            text = "baltųjų spalvom. Tai dėl to ištraukė iš iš iš iš nelaisvės tų rusų"
        intervals [1081]:
            xmin = 2237.330000
            xmax = 2240.360000
            text = "pririnko. reiškia ir čia va toksai labai keistas toks"
        intervals [1082]:
            xmin = 2240.360000
            xmax = 2240.690000
            text = ""
        intervals [1083]:
            xmin = 2240.690000
            xmax = 2242.130000
            text = "darinys ir egzistavo."
        intervals [1084]:
            xmin = 2242.130000
            xmax = 2242.480000
            text = ""
        intervals [1085]:
            xmin = 2242.480000
            xmax = 2244.910000
            text = "Tai lietuviai labai aiškiai suprato, kad čia yra"
        intervals [1086]:
            xmin = 2244.910000
            xmax = 2245.030000
            text = ""
        intervals [1087]:
            xmin = 2245.030000
            xmax = 2249.350000
            text = "neaiškios jėgos, akivaizdžiai nedraugiškos Lietuvos nepriklausomybės atžvilgiu,"
        intervals [1088]:
            xmin = 2249.350000
            xmax = 2249.650000
            text = ""
        intervals [1089]:
            xmin = 2249.650000
            xmax = 2252.680000
            text = "bet su vokiečiais stengėsi nesipykti. Tai va, čia tokia yra"
        intervals [1090]:
            xmin = 2252.680000
            xmax = 2253.040000
            text = ""
        intervals [1091]:
            xmin = 2253.040000
            xmax = 2254.750000
            text = "mūsų situacija. O latviam tai yra"
        intervals [1092]:
            xmin = 2254.750000
            xmax = 2255.080000
            text = ""
        intervals [1093]:
            xmin = 2255.080000
            xmax = 2259.880000
            text = "neabejotinas priešas. va čia jau latvių nepriklausomybei. Pagrindinis priešas, aš"
        intervals [1094]:
            xmin = 2259.880000
            xmax = 2261.019000
            text = "sakyčiau, ir buvo šitie"
        intervals [1095]:
            xmin = 2261.019000
            xmax = 2267.008000
            text = ""
        intervals [1096]:
            xmin = 2267.008000
            xmax = 2269.790000
            text = "be jokios abejonės, Tiktai tiek, kad lietuvių nelaikė"
        intervals [1097]:
            xmin = 2269.790000
            xmax = 2270.330000
            text = ""
        intervals [1098]:
            xmin = 2270.330000
            xmax = 2272.459000
            text = "Latvijoj labai dideliais sąjungininkais. Nes"
        intervals [1099]:
            xmin = 2272.459000
            xmax = 2272.690000
            text = ""
        intervals [1100]:
            xmin = 2272.690000
            xmax = 2274.320000
            text = "nepasitikėjo dėl tų mūsų"
        intervals [1101]:
            xmin = 2274.320000
            xmax = 2274.470000
            text = ""
        intervals [1102]:
            xmin = 2274.470000
            xmax = 2275.820000
            text = "draugysčių su vokiečiais."
        intervals [1103]:
            xmin = 2275.820000
            xmax = 2276.120000
            text = ""
        intervals [1104]:
            xmin = 2276.120000
            xmax = 2277.680000
            text = "Jiem labiausiai tiko lenkai."
        intervals [1105]:
            xmin = 2277.680000
            xmax = 2278.630000
            text = ""
        intervals [1106]:
            xmin = 2278.630000
            xmax = 2283.040000
            text = "Ir tas lenkų, latvių, ta draugystė, kuri ypatingai išryškėjo, sakykim,"
        intervals [1107]:
            xmin = 2283.040000
            xmax = 2287.000000
            text = "dvidešimtų metų pradžioj, devynioliktų pabaigoje, vykstant kovom Latgaloj"
        intervals [1108]:
            xmin = 2287.000000
            xmax = 2287.480000
            text = ""
        intervals [1109]:
            xmin = 2287.480000
            xmax = 2289.040000
            text = "Jinai mum buvo labai nenaudinga,"
        intervals [1110]:
            xmin = 2289.040000
            xmax = 2301.694000
            text = ""
        intervals [1111]:
            xmin = 2301.694000
            xmax = 2306.820000
            text = "niekas nenuspręsta, o tuo labiau kad ta Kuršo gubernijos siena. Jinai gi buvo pakeista devynioliktam amžiuj, ir"
        intervals [1112]:
            xmin = 2306.820000
            xmax = 2310.060000
            text = "latviai žiūrėjo taip, kaip naudinga jiem o mes žiūrėjom kaip naudinga mum"
        intervals [1113]:
            xmin = 2310.060000
            xmax = 2310.420000
            text = ""
        intervals [1114]:
            xmin = 2310.420000
            xmax = 2311.586000
            text = "nes tai yra senos lietuvių"
        intervals [1115]:
            xmin = 2311.586000
            xmax = 2313.130000
            text = ""
        intervals [1116]:
            xmin = 2313.130000
            xmax = 2314.930000
            text = "Tas lietuvių - latvių reiškia"
        intervals [1117]:
            xmin = 2314.930000
            xmax = 2315.200000
            text = ""
        intervals [1118]:
            xmin = 2315.200000
            xmax = 2319.490000
            text = "tas bendravimas jisai su kol nepereina prie šitų sunkių klausimų."
        intervals [1119]:
            xmin = 2319.490000
            xmax = 2320.220000
            text = ""
        intervals [1120]:
            xmin = 2320.220000
            xmax = 2324.960000
            text = "Bet buitiniam lygmeny didžiulis bendradarbiavimas, ir, sakykim, partizanų veiksmuose tai tikrai"
        intervals [1121]:
            xmin = 2324.960000
            xmax = 2326.580000
            text = "vieni su kitais ten bendradarbiavo"
        intervals [1122]:
            xmin = 2326.580000
            xmax = 2327.090000
            text = ""
        intervals [1123]:
            xmin = 2327.090000
            xmax = 2332.040000
            text = "Aš sakyčiau, kas lietuvius su latviais labai supykino. Tai mūsų elgesys devynioliktų metų"
        intervals [1124]:
            xmin = 2332.040000
            xmax = 2333.150000
            text = "pabaigoj Latgaloj"
        intervals [1125]:
            xmin = 2333.150000
            xmax = 2334.280000
            text = ""
        intervals [1126]:
            xmin = 2334.280000
            xmax = 2334.734000
            text = "Nes"
        intervals [1127]:
            xmin = 2334.734000
            xmax = 2334.910000
            text = ""
        intervals [1128]:
            xmin = 2334.910000
            xmax = 2337.370000
            text = "Lietuvoj apie tai gal per daug nežinoma, bet lietuviai"
        intervals [1129]:
            xmin = 2337.370000
            xmax = 2337.880000
            text = ""
        intervals [1130]:
            xmin = 2337.880000
            xmax = 2342.740000
            text = "staiga ten, kaip ir laikinai, užėmę tą kraštą ir jau pradėjo dairytis, o gal čia ir"
        intervals [1131]:
            xmin = 2342.740000
            xmax = 2343.460000
            text = "pasilikus"
        intervals [1132]:
            xmin = 2343.460000
            xmax = 2348.290000
            text = ""
        intervals [1133]:
            xmin = 2348.290000
            xmax = 2349.010000
            text = "lenkų dar"
        intervals [1134]:
            xmin = 2349.010000
            xmax = 2349.790000
            text = ""
        intervals [1135]:
            xmin = 2349.790000
            xmax = 2354.740000
            text = "paskatinti. Tai tikrai buvo nusiteikę labai prieš lietuvius. Tai, sakykim, tas devynioliktų metų"
        intervals [1136]:
            xmin = 2354.740000
            xmax = 2357.922000
            text = "draugystė. Jinai jau dvidešimtų metų pradžioj tikrai nebuvo panaši"
        intervals [1137]:
            xmin = 2357.922000
            xmax = 2378.960000
            text = ""
        intervals [1138]:
            xmin = 2378.960000
            xmax = 2381.780000
            text = "Išeinam iš karo su labai galinga kariuomene."
        intervals [1139]:
            xmin = 2381.780000
            xmax = 2383.430000
            text = ""
        intervals [1140]:
            xmin = 2383.430000
            xmax = 2386.820000
            text = "Iš tikrųjų per tokį trumpą laiką mus labai sustiprino"
        intervals [1141]:
            xmin = 2386.820000
            xmax = 2386.940000
            text = ""
        intervals [1142]:
            xmin = 2386.940000
            xmax = 2387.360000
            text = "ir"
        intervals [1143]:
            xmin = 2387.360000
            xmax = 2388.050000
            text = ""
        intervals [1144]:
            xmin = 2388.050000
            xmax = 2392.040000
            text = "tos kovos, kurias mes sugebėjom nepralaimėti. aš taip, pasakyčiau,"
        intervals [1145]:
            xmin = 2392.040000
            xmax = 2392.280000
            text = ""
        intervals [1146]:
            xmin = 2392.280000
            xmax = 2393.720000
            text = "Vilniaus kovos tai yra"
        intervals [1147]:
            xmin = 2393.720000
            xmax = 2393.930000
            text = ""
        intervals [1148]:
            xmin = 2393.930000
            xmax = 2395.694000
            text = "jokiu būdu ne pergalė. Todėl, kad"
        intervals [1149]:
            xmin = 2395.694000
            xmax = 2396.023000
            text = ""
        intervals [1150]:
            xmin = 2396.023000
            xmax = 2396.960000
            text = "mes mes netenkam."
        intervals [1151]:
            xmin = 2396.960000
            xmax = 2398.497000
            text = ""
        intervals [1152]:
            xmin = 2398.497000
            xmax = 2403.050000
            text = "Širvintos Giedraičiai Musninkai vis tiktai sustiprino tikėjimą savo jėgom."
        intervals [1153]:
            xmin = 2403.050000
            xmax = 2404.010000
            text = ""
        intervals [1154]:
            xmin = 2404.010000
            xmax = 2405.720000
            text = "Buvom ne taip prastai apginkluoti."
        intervals [1155]:
            xmin = 2405.720000
            xmax = 2406.642000
            text = ""
        intervals [1156]:
            xmin = 2406.642000
            xmax = 2408.540000
            text = "dvidešimtais metais labai daug ginklų gaunam"
        intervals [1157]:
            xmin = 2408.540000
            xmax = 2409.210000
            text = ""
        intervals [1158]:
            xmin = 2409.210000
            xmax = 2409.900000
            text = "ir"
        intervals [1159]:
            xmin = 2409.900000
            xmax = 2410.050000
            text = ""
        intervals [1160]:
            xmin = 2410.050000
            xmax = 2414.760000
            text = "turim ir, ir savo aviaciją, ir artileriją ir ir pėstininkus. Vat kavalerija yra silpnoji"
        intervals [1161]:
            xmin = 2414.760000
            xmax = 2415.180000
            text = "vieta."
        intervals [1162]:
            xmin = 2415.180000
            xmax = 2415.390000
            text = ""
        intervals [1163]:
            xmin = 2415.390000
            xmax = 2418.150000
            text = "Už tai po karo labai daug dėmesio skiriama kavalerijai. Čia"
        intervals [1164]:
            xmin = 2418.150000
            xmax = 2418.360000
            text = ""
        intervals [1165]:
            xmin = 2418.360000
            xmax = 2419.380000
            text = "padaromos išvados"
        intervals [1166]:
            xmin = 2419.380000
            xmax = 2420.160000
            text = ""
        intervals [1167]:
            xmin = 2420.160000
            xmax = 2421.990000
            text = "iš tų kovų, kurios vyko su lenkais."
        intervals [1168]:
            xmin = 2421.990000
            xmax = 2423.280000
            text = ""
        intervals [1169]:
            xmin = 2423.280000
            xmax = 2424.943000
            text = "Turim šarvuotus traukinius"
        intervals [1170]:
            xmin = 2424.943000
            xmax = 2425.122000
            text = ""
        intervals [1171]:
            xmin = 2425.122000
            xmax = 2427.750000
            text = "Turim Kauno tvirtovės konceptas. Turim, turim"
        intervals [1172]:
            xmin = 2427.750000
            xmax = 2428.183000
            text = "daug ką."
        intervals [1173]:
            xmin = 2428.183000
            xmax = 2429.490000
            text = ""
        intervals [1174]:
            xmin = 2429.490000
            xmax = 2430.180000
            text = "Žinoma,"
        intervals [1175]:
            xmin = 2430.180000
            xmax = 2430.630000
            text = ""
        intervals [1176]:
            xmin = 2430.630000
            xmax = 2435.610000
            text = "kariuomenė daugiausiai sustiprė dvidešim pirmų metų pradžioje, kada karai jau pasibaigę,"
        intervals [1177]:
            xmin = 2435.610000
            xmax = 2435.820000
            text = "yra"
        intervals [1178]:
            xmin = 2435.820000
            xmax = 2436.450000
            text = ""
        intervals [1179]:
            xmin = 2436.450000
            xmax = 2438.010000
            text = "ir turim karininkų."
        intervals [1180]:
            xmin = 2438.010000
            xmax = 2438.929000
            text = ""
        intervals [1181]:
            xmin = 2438.929000
            xmax = 2440.430000
            text = "šiokios tokios patirties"
        intervals [1182]:
            xmin = 2440.430000
            xmax = 2440.820000
            text = ""
        intervals [1183]:
            xmin = 2440.820000
            xmax = 2442.590000
            text = "ir baisų valstybės skurdą."
        intervals [1184]:
            xmin = 2442.590000
            xmax = 2443.370000
            text = ""
        intervals [1185]:
            xmin = 2443.370000
            xmax = 2448.050000
            text = "Mes karo metu galėjom kažkokias paskolas gauti. Paskui šitas reikalas baigėsi,"
        intervals [1186]:
            xmin = 2448.050000
            xmax = 2449.730000
            text = ""
        intervals [1187]:
            xmin = 2449.730000
            xmax = 2451.020000
            text = "atsisėsti ant savo"
        intervals [1188]:
            xmin = 2451.020000
            xmax = 2451.650000
            text = ""
        intervals [1189]:
            xmin = 2451.650000
            xmax = 2455.280000
            text = "uodegytės. Tai labai sunkus, sunkus laikas. Yra"
        intervals [1190]:
            xmin = 2455.280000
            xmax = 2455.400000
            text = ""
        intervals [1191]:
            xmin = 2455.400000
            xmax = 2460.350000
            text = "ir tą didelę, kariuomenę išlaikyti yra labai labai nenaudinga ir, žinoma, didžiulis spaudimas iš"
        intervals [1192]:
            xmin = 2460.350000
            xmax = 2460.800000
            text = "krašto"
        intervals [1193]:
            xmin = 2460.800000
            xmax = 2461.160000
            text = ""
        intervals [1194]:
            xmin = 2461.160000
            xmax = 2465.180000
            text = "ekonomistų, kad reikia kuo greičiau kariuomenę, mažinti, o kaip tu ją mažinsi. Kai dar"
        intervals [1195]:
            xmin = 2465.180000
            xmax = 2465.560000
            text = ""
        intervals [1196]:
            xmin = 2465.560000
            xmax = 2469.220000
            text = "sienos neaiškios ir ir padėtis bet kada gali susikomplikuoti,"
        intervals [1197]:
            xmin = 2469.220000
            xmax = 2470.233000
            text = ""
        intervals [1198]:
            xmin = 2470.233000
            xmax = 2472.430000
            text = "Vilniaus klausimas ilgą laiką buvo atviras."
        intervals [1199]:
            xmin = 2472.430000
            xmax = 2472.820000
            text = ""
        intervals [1200]:
            xmin = 2472.820000
            xmax = 2477.410000
            text = "Praktiškai iki dvidešim antrų metų pabaigos dar buvo neaišku, kaip čia viskas pasibaigs, ir"
        intervals [1201]:
            xmin = 2477.410000
            xmax = 2479.337000
            text = "dvidešim trečiais gi to aiškumo irgi dar"
        intervals [1202]:
            xmin = 2479.337000
            xmax = 2479.840000
            text = ""
        intervals [1203]:
            xmin = 2479.840000
            xmax = 2480.620000
            text = "labai nebuvo,"
        intervals [1204]:
            xmin = 2480.620000
            xmax = 2481.130000
            text = ""
        intervals [1205]:
            xmin = 2481.130000
            xmax = 2482.280000
            text = "ir tų priešų daug."
        intervals [1206]:
            xmin = 2482.280000
            xmax = 2482.450000
            text = ""
        intervals [1207]:
            xmin = 2482.450000
            xmax = 2483.470000
            text = "Tai tikrai"
        intervals [1208]:
            xmin = 2483.470000
            xmax = 2483.830000
            text = ""
        intervals [1209]:
            xmin = 2483.830000
            xmax = 2488.390000
            text = "ta kariuomenė buvo kaip ir stipri, bet bet ją reikėjo mažinti. Reikėjo pereiti į"
        intervals [1210]:
            xmin = 2488.390000
            xmax = 2488.420000
            text = ""
        intervals [1211]:
            xmin = 2488.420000
            xmax = 2489.920000
            text = "taikos meto būseną, ir,"
        intervals [1212]:
            xmin = 2489.920000
            xmax = 2490.340000
            text = ""
        intervals [1213]:
            xmin = 2490.340000
            xmax = 2490.820000
