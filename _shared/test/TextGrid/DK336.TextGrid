            text = ""
        intervals [897]:
            xmin = 1839.310000
            xmax = 1842.670000
            text = "tai rašydavo vietoves taip, kaip užrašyta. Vokiečių štabų"
        intervals [898]:
            xmin = 1842.670000
            xmax = 1843.000000
            text = ""
        intervals [899]:
            xmin = 1843.000000
            xmax = 1843.720000
            text = "žemėlapiuose"
        intervals [900]:
            xmin = 1843.720000
            xmax = 1844.230000
            text = ""
        intervals [901]:
            xmin = 1844.230000
            xmax = 1847.020000
            text = "Tai ten, nu, išskyrus jau tokius. Ten Kaunas, Vilnius reiškia"
        intervals [902]:
