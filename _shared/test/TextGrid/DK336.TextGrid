            xmax = 2644.260000
            text = ""
        intervals [318]:
            xmin = 2644.260000
            xmax = 2645.368000
            text = "paklusnumo vadams."
        intervals [319]:
            xmin = 2645.368000
            xmax = 2689.670000
            text = ""
        intervals [320]:
            xmin = 2689.670000
            xmax = 2693.150000
            text = "Kalbant apie istoriją, kai mes apie vieną ar kitą režimą kalbam"
        intervals [321]:
