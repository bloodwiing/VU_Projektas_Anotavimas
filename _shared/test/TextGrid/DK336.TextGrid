            text = ""
        intervals [349]:
            xmin = 2812.990000
            xmax = 2813.827000
            text = "lapkričio pirma"
        intervals [350]:
            xmin = 2813.827000
            xmax = 2814.160000
            text = ""
        intervals [351]:
            xmin = 2814.160000
            xmax = 2815.600000
            text = "lapkričio dvidešim trečia"
        intervals [352]:
            xmin = 2815.600000
            xmax = 2816.050000
            text = ""
        intervals [353]:
            xmin = 2816.050000
            xmax = 2820.550000
            text = "Visiem klausytojam dėkoju už dėmesį. Tai buvo Istorijos perimetrai prie"
        intervals [354]:
            xmin = 2820.550000
            xmax = 2823.580000
            text = "mikrofono. Šią valandą dirbau aš, žurnalistas Rimas Bružas."
        intervals [355]:
            xmin = 2823.580000
            xmax = 2824.030000
            text = ""
        intervals [356]:
            xmin = 2824.030000
            xmax = 2828.800000
            text = "Visas mūsų laidas galite rasti puikiojoje LRT audiotekoje arba jums"
        intervals [357]:
            xmin = 2828.800000
            xmax = 2830.630000
