            text = ""
        intervals [2]:
            xmin = 14.890000
            xmax = 19.870000
            text = "Gerą dieną garbūs Lietuvos radijo klausytojai eteryje - laida Istorijos perimetrai,"
        intervals [3]:
            xmin = 19.870000
            xmax = 21.430000
            text = "prie mikrofono - Rimas Bružas."
        intervals [4]:
            xmin = 21.430000
            xmax = 22.120000
            text = ""
        intervals [5]:
            xmin = 22.120000
            xmax = 26.800000
            text = "Tūkstantis devyni šimtai aštuonioliktųjų metų lapkričio dvidešim trečią dieną"
        intervals [6]:
            xmin = 26.800000
            xmax = 28.030000
            text = "Ministras Pirmininkas"
        intervals [7]:
            xmin = 28.030000
            xmax = 28.420000
            text = ""
        intervals [8]:
            xmin = 28.420000
            xmax = 32.409000
            text = "Augustinas Voldemaras pasirašė įsakymą numeris vienas"
        intervals [9]:
            xmin = 32.409000
            xmax = 32.800000
            text = ""
        intervals [10]:
            xmin = 32.800000
            xmax = 34.840000
            text = "kuriuo įkūrė apsaugos tarybą."
        intervals [11]:
            xmin = 34.840000
            xmax = 35.380000
            text = ""
        intervals [12]:
            xmin = 35.380000
            xmax = 36.310000
            text = "Nuo šios dienos"
        intervals [13]:
            xmin = 36.310000
            xmax = 36.473000
            text = ""
        intervals [14]:
            xmin = 36.473000
            xmax = 38.680000
            text = "pradėta kurti Lietuvos kariuomenė,"
        intervals [15]:
            xmin = 38.680000
            xmax = 38.830000
            text = ""
        intervals [16]:
            xmin = 38.830000
            xmax = 41.290000
            text = "ir lapkričio dvidešim trečiąją minime"
        intervals [17]:
            xmin = 41.290000
            xmax = 41.630000
            text = ""
        intervals [18]:
            xmin = 41.630000
            xmax = 44.720000
            text = "ginkluotųjų pajėgų dieną. na O šiandien mūsų karius"
        intervals [19]:
            xmin = 44.720000
            xmax = 45.020000
            text = ""
        intervals [20]:
            xmin = 45.020000
            xmax = 49.130000
            text = "sveikiname su šimtas trečiuoju gimtadieniu. Ta proga"
        intervals [21]:
            xmin = 49.130000
            xmax = 49.430000
            text = ""
        intervals [22]:
            xmin = 49.430000
            xmax = 53.990000
            text = "istorijos perimetrų. Svečias - karo istorikas, profesorius Valdas Rakutis. Gerą dieną,"
        intervals [23]:
            xmin = 53.990000
            xmax = 58.670000
            text = ""
        intervals [24]:
            xmin = 58.670000
            xmax = 59.480000
            text = "lapkričio"
        intervals [25]:
            xmin = 59.480000
            xmax = 61.260000
            text = ""
        intervals [26]:
            xmin = 61.260000
            xmax = 62.190000
            text = "kas nutiko"
        intervals [27]:
            xmin = 62.190000
            xmax = 140.832000
            text = ""
        intervals [28]:
            xmin = 140.832000
            xmax = 144.960000
            text = "Voldemaro tas vėlgi pasirašytas įsakymas numeris vienas ar Ne, apie ką jisai"
        intervals [29]:
            xmin = 144.960000
            xmax = 144.990000
            text = ""
        intervals [30]:
            xmin = 144.990000
            xmax = 145.320000
            text = "buvo?"
        intervals [31]:
            xmin = 145.320000
            xmax = 228.560000
            text = ""
        intervals [32]:
            xmin = 228.560000
            xmax = 230.720000
            text = "dažnas supaprastinimas, jisai įneša"
        intervals [33]:
            xmin = 230.720000
            xmax = 231.170000
            text = ""
        intervals [34]:
            xmin = 231.170000
            xmax = 232.400000
            text = "tam tikros destrukcijos,"
        intervals [35]:
            xmin = 232.400000
            xmax = 243.510000
            text = ""
        intervals [36]:
            xmin = 243.510000
            xmax = 244.396000
            text = "Tai ta kariuomenė, kaip"
        intervals [37]:
            xmin = 244.396000
            xmax = 245.072000
            text = ""
        intervals [38]:
            xmin = 245.072000
            xmax = 246.960000
            text = "visų pirma yra žmonės. Ar ne?"
        intervals [39]:
            xmin = 246.960000
            xmax = 247.890000
            text = ""
        intervals [40]:
            xmin = 247.890000
            xmax = 255.240000
            text = "Aštuonioliktais metais turėkim omenyje kontekstą ir pakalbėkim apie apie personalijas. Iš kur jos ateina,"
        intervals [41]:
            xmin = 255.240000
            xmax = 256.440000
            text = ""
        intervals [42]:
            xmin = 256.440000
            xmax = 259.110000
            text = "iš kur pas juos žinojimas ir išmanymas"
        intervals [43]:
            xmin = 259.110000
            xmax = 259.560000
            text = ""
        intervals [44]:
            xmin = 259.560000
            xmax = 260.610000
            text = "karybos meno"
        intervals [45]:
            xmin = 260.610000
            xmax = 260.880000
            text = ""
        intervals [46]:
            xmin = 260.880000
            xmax = 262.019000
            text = "ir kas tai per asmenybes?"
        intervals [47]:
            xmin = 262.019000
            xmax = 273.070000
            text = ""
        intervals [48]:
            xmin = 273.070000
            xmax = 273.550000
            text = "tradicija,"
        intervals [49]:
            xmin = 273.550000
            xmax = 273.730000
            text = ""
        intervals [50]:
            xmin = 273.730000
            xmax = 274.660000
            text = "tam tikra prasme ar ne"
        intervals [51]:
            xmin = 274.660000
            xmax = 326.547000
            text = ""
        intervals [52]:
            xmin = 326.547000
            xmax = 328.488000
            text = "bazinis parengimo kursas "
        intervals [53]:
            xmin = 328.488000
            xmax = 430.794000
            text = ""
        intervals [54]:
            xmin = 430.794000
            xmax = 432.120000
            text = "aš kaip tik ir Norėjau klaust, tas"
        intervals [55]:
            xmin = 432.120000
            xmax = 433.049000
            text = ""
        intervals [56]:
            xmin = 433.049000
            xmax = 436.980000
            text = "hau yra vienas dalykas, ar ne, bet reikėjo turėti dar ir kitą"
        intervals [57]:
            xmin = 436.980000
            xmax = 440.400000
            text = "momentą, tai yra tikėjimą ta jaunąja valstybe."
        intervals [58]:
            xmin = 440.400000
            xmax = 441.137000
            text = ""
        intervals [59]:
            xmin = 441.137000
            xmax = 443.634000
            text = "kur dar visiškai neaišku, kaip ten bus, ar ne? "
        intervals [60]:
            xmin = 443.634000
            xmax = 444.360000
            text = ""
        intervals [61]:
            xmin = 444.360000
            xmax = 446.040000
            text = "ta prasme buvo rizikos"
        intervals [62]:
            xmin = 446.040000
            xmax = 473.174000
            text = ""
        intervals [63]:
            xmin = 473.174000
            xmax = 474.575000
            text = "apgultis ar ne tas"
        intervals [64]:
            xmin = 474.575000
            xmax = 474.840000
            text = ""
        intervals [65]:
            xmin = 474.840000
            xmax = 475.658000
            text = "kariuomenės"
        intervals [66]:
            xmin = 475.658000
            xmax = 475.794000
            text = ""
        intervals [67]:
            xmin = 475.794000
            xmax = 479.075000
            text = "tas susikūrimas ar čia lapkričio pirmą ar dvidešim trečią Bet"
        intervals [68]:
            xmin = 479.075000
            xmax = 479.880000
            text = ""
        intervals [69]:
            xmin = 479.880000
            xmax = 483.865000
            text = "faktas toks - ir ta priešo apgultis iš visų pusių, ar ne problemos? Regis,"
        intervals [70]:
            xmin = 483.865000
            xmax = 484.740000
            text = ""
        intervals [71]:
            xmin = 484.740000
            xmax = 488.130000
            text = "kur pažiūrėsi. Rytus, į vakarus, į šiaurę, ten problema"
        intervals [72]:
            xmin = 488.130000
            xmax = 488.670000
            text = ""
        intervals [73]:
            xmin = 488.670000
            xmax = 490.110000
            text = "valstybės saugumo prasme ar ne?"
        intervals [74]:
            xmin = 490.110000
            xmax = 579.720000
            text = ""
        intervals [75]:
            xmin = 579.720000
            xmax = 583.530000
            text = "Turbūt reikėtų paminėt klausytojams, kad ta Vokietijos kariuomenė, kuri čia buvo"
        intervals [76]:
            xmin = 583.530000
            xmax = 583.950000
            text = ""
        intervals [77]:
            xmin = 583.950000
            xmax = 587.100000
            text = "po pirmo pasaulinio karo, jinai Versalio taikos sutartimi"
        intervals [78]:
            xmin = 587.100000
            xmax = 587.760000
            text = ""
        intervals [79]:
            xmin = 587.760000
            xmax = 588.999000
            text = "liko čia tam, kad"
        intervals [80]:
            xmin = 588.999000
            xmax = 589.890000
            text = ""
        intervals [81]:
            xmin = 589.890000
            xmax = 591.360000
            text = "Lietuvai padėtų"
        intervals [82]:
            xmin = 591.360000
            xmax = 591.600000
            text = ""
        intervals [83]:
            xmin = 591.600000
            xmax = 595.890000
            text = "gintis nuo bolševizmo. ar Ne, tai nebuvo tiesiog, kad jie liko. Nors buvo ir tokių, kurie"
        intervals [84]:
            xmin = 595.890000
            xmax = 596.730000
            text = ""
        intervals [85]:
            xmin = 596.730000
            xmax = 599.550000
            text = "karininkų, kuriems grįžti į pokario Vokietiją,"
        intervals [86]:
            xmin = 599.550000
            xmax = 599.940000
            text = ""
        intervals [87]:
            xmin = 599.940000
            xmax = 602.049000
            text = "neatrodė gera, mintis, jie"
        intervals [88]:
            xmin = 602.049000
            xmax = 602.286000
            text = ""
        intervals [89]:
            xmin = 602.286000
            xmax = 603.390000
            text = "rinkosi likti čia."
        intervals [90]:
            xmin = 603.390000
            xmax = 655.050000
            text = ""
        intervals [91]:
            xmin = 655.050000
            xmax = 656.310000
            text = "natūralu. Duonos nebuvo"
        intervals [92]:
            xmin = 656.310000
            xmax = 694.550000
            text = ""
        intervals [93]:
            xmin = 694.550000
            xmax = 695.510000
            text = "mes čia taip labai gražiai"
        intervals [94]:
            xmin = 695.510000
            xmax = 696.080000
            text = ""
        intervals [95]:
            xmin = 696.080000
            xmax = 700.640000
            text = "komplektuojam Lietuvos kariuomenę pa pa pamažu žiūrim, kas iš kur atsiranda,"
        intervals [96]:
            xmin = 700.640000
            xmax = 700.970000
            text = ""
        intervals [97]:
            xmin = 700.970000
            xmax = 701.300000
            text = "tai"
        intervals [98]:
            xmin = 701.300000
            xmax = 701.450000
            text = ""
        intervals [99]:
            xmin = 701.450000
            xmax = 704.536000
            text = "šitos komplektacijos procese. Važiuokime toliau."
        intervals [100]:
            xmin = 704.536000
            xmax = 705.230000
            text = ""
        intervals [101]:
            xmin = 705.230000
            xmax = 706.310000
            text = "Ginklai ar ne"
        intervals [102]:
            xmin = 706.310000
            xmax = 706.700000
            text = ""
        intervals [103]:
            xmin = 706.700000
            xmax = 708.127000
            text = "būtinas dalykas"
        intervals [104]:
            xmin = 708.127000
            xmax = 708.350000
            text = ""
        intervals [105]:
            xmin = 708.350000
            xmax = 713.030000
            text = "po karo? Aišku, čia to to tos amunicijos buvo. Bet kariuomenę sukomplektuot tai ne"
        intervals [106]:
            xmin = 713.030000
            xmax = 713.480000
            text = "kažkokį"
        intervals [107]:
