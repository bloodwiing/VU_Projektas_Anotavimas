        intervals [911]:
            xmin = 1915.690000
            xmax = 1917.550000
            text = "Mes turime sąjungininkų."
        intervals [912]:
            xmin = 1917.550000
            xmax = 1917.670000
            text = ""
        intervals [913]:
            xmin = 1917.670000
            xmax = 1919.560000
            text = "Tai mūsų sąjungininkai yra lenkai."
        intervals [914]:
            xmin = 1919.560000
