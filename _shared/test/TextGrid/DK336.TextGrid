            text = ""
        intervals [185]:
            xmin = 1365.150000
            xmax = 1370.130000
            text = "dėl žemių ateina, ar ne kas pakankamai stipriai sumotyvuoja tuos žmones, ir tada jau"
        intervals [186]:
