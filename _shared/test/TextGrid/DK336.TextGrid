        intervals [240]:
            xmin = 1886.949000
            xmax = 1889.930000
            text = "kalbėjom iš šiaurės. Yra"
        intervals [241]:
            xmin = 1889.930000
            xmax = 1890.620000
            text = ""
        intervals [242]:
            xmin = 1890.620000
            xmax = 1893.502000
            text = "tiesa ne visai tuo pačiu laiku, ar ne yra bermontininkai."
        intervals [243]:
            xmin = 1893.502000
            xmax = 1895.590000
            text = ""
        intervals [244]:
            xmin = 1895.590000
            xmax = 1899.824000
            text = "Rytuose. Mes turim problemą su Lenkija. Turim problemą su bolševikais."
        intervals [245]:
            xmin = 1899.824000
            xmax = 1900.300000
            text = ""
        intervals [246]:
            xmin = 1900.300000
            xmax = 1902.580000
            text = "Kaip sekasi tuose"
        intervals [247]:
            xmin = 1902.580000
            xmax = 1902.850000
            text = ""
        intervals [248]:
            xmin = 1902.850000
            xmax = 1905.370000
            text = "trijuose frontuose? Kuo jie vienodi,"
        intervals [249]:
            xmin = 1905.370000
            xmax = 1905.580000
            text = ""
        intervals [250]:
            xmin = 1905.580000
            xmax = 1908.370000
            text = "kuo jie panašūs, kuo jie skirtingi, kokia specifika?"
        intervals [251]:
