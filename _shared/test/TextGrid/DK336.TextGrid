        intervals [950]:
            xmin = 1983.770000
            xmax = 1988.420000
            text = "bet po to reiškia. Pradedam konflinktuoti nuo landvero karo reiškia jau nuo nuo vasaros"
        intervals [951]:
            xmin = 1988.420000
