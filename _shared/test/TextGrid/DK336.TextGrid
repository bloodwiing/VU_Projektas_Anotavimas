            xmin = 2166.750000
            xmax = 2261.711000
            text = ""
        intervals [273]:
            xmin = 2261.711000
            xmax = 2265.640000
            text = "Šiaurės Lietuvoje latviai buvo lietuvių sąjungininkai, ar ne"
        intervals [274]:
            xmin = 2265.640000
