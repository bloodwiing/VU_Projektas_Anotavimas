            text = ""
        intervals [921]:
            xmin = 1927.540000
            xmax = 1930.810000
            text = "yra labai skirtingos. Mes matom Lietuvą, vienokią"
        intervals [922]:
            xmin = 1930.810000
            xmax = 1931.110000
            text = ""
        intervals [923]:
            xmin = 1931.110000
            xmax = 1934.110000
            text = "Lenkija. Lietuva mato jau senai Lenkijos sudėty"
        intervals [924]:
            xmin = 1934.110000
