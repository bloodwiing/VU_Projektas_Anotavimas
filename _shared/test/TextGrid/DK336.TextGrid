            text = "ilgą laiką, iki tūkstantis devyni šimtai penktų metų,"
        intervals [185]:
            xmin = 371.400000
            xmax = 371.640000
            text = ""
        intervals [186]:
            xmin = 371.640000
            xmax = 375.870000
            text = "katalikai katalikai lietuviai išvis buvo kariuomenėj labai nepageidaujami."
        intervals [187]:
            xmin = 375.870000
            xmax = 376.440000
            text = ""
        intervals [188]:
            xmin = 376.440000
            xmax = 376.950000
            text = "Tokio"
        intervals [189]:
            xmin = 376.950000
            xmax = 377.130000
            text = ""
        intervals [190]:
            xmin = 377.130000
            xmax = 380.820000
            text = "griežto draudimo tarsi ir nebuvo, bet bet bet buvo"
        intervals [191]:
            xmin = 380.820000
            xmax = 381.360000
            text = ""
        intervals [192]:
            xmin = 381.360000
            xmax = 383.190000
            text = "čia kaip ir su su tuo spaudos draudimu."
        intervals [193]:
            xmin = 383.190000
            xmax = 383.640000
            text = ""
        intervals [194]:
            xmin = 383.640000
            xmax = 385.950000
            text = "O nuo tūkstantis devyni šimtai penktų metų"
        intervals [195]:
            xmin = 385.950000
            xmax = 386.340000
            text = ""
        intervals [196]:
            xmin = 386.340000
            xmax = 387.240000
            text = "ten penktų, šeštų,"
        intervals [197]:
            xmin = 387.240000
            xmax = 387.590000
            text = ""
        intervals [198]:
            xmin = 387.590000
            xmax = 390.222000
            text = "jau kaip ir atsirado galimybė studijuoti Vilniaus"
        intervals [199]:
            xmin = 390.222000
            xmax = 390.920000
            text = ""
        intervals [200]:
            xmin = 390.920000
            xmax = 394.850000
            text = "karo mokykloj, pėstininkų mokykloj junkerių mokykloj. tai tie pavadinimai truputėlį,"
        intervals [201]:
            xmin = 394.850000
            xmax = 396.200000
            text = ""
        intervals [202]:
            xmin = 396.200000
            xmax = 397.708000
            text = "lietuviai nėjo į šitą kariuomenę"
        intervals [203]:
            xmin = 397.708000
            xmax = 398.600000
            text = ""
        intervals [204]:
            xmin = 398.600000
            xmax = 401.090000
            text = "Čia irgi labai svarbus dalykas buvo laikoma"
        intervals [205]:
            xmin = 401.090000
            xmax = 401.390000
            text = ""
        intervals [206]:
            xmin = 401.390000
            xmax = 402.710000
            text = "nepatriotiška"
        intervals [207]:
            xmin = 402.710000
            xmax = 403.250000
            text = ""
        intervals [208]:
            xmin = 403.250000
            xmax = 405.436000
            text = "eiti karininku Rusijos imperijos,"
        intervals [209]:
            xmin = 405.436000
            xmax = 407.030000
            text = ""
        intervals [210]:
            xmin = 407.030000
            xmax = 409.040000
            text = "Glovackio, atsiminimuose apie tai labai"
        intervals [211]:
            xmin = 409.040000
            xmax = 409.317000
            text = ""
        intervals [212]:
            xmin = 409.317000
            xmax = 412.315000
            text = "akcentuoja ir ir ir pati Vilniaus lietuvių bendruomenė."
        intervals [213]:
            xmin = 412.315000
            xmax = 412.990000
            text = ""
        intervals [214]:
            xmin = 412.990000
            xmax = 414.370000
            text = "kreivai žiūrėjo į tuos"
        intervals [215]:
            xmin = 414.370000
            xmax = 414.850000
            text = ""
        intervals [216]:
            xmin = 414.850000
            xmax = 415.760000
            text = "karininkus,"
        intervals [217]:
            xmin = 415.760000
            xmax = 416.140000
            text = ""
        intervals [218]:
            xmin = 416.140000
            xmax = 420.970000
            text = "lietuvius katalikus. Bet, bet teoriškai jau jau jų atsirado šiek tiek ir praktiškai. Visi"
        intervals [219]:
            xmin = 420.970000
            xmax = 422.322000
            text = "tie besimokę mokykloj"
        intervals [220]:
            xmin = 422.322000
            xmax = 422.710000
            text = ""
        intervals [221]:
            xmin = 422.710000
            xmax = 425.080000
            text = "ir sudarė tos Lietuvos kariuomenės. Tokį"
        intervals [222]:
            xmin = 425.080000
            xmax = 425.500000
            text = ""
        intervals [223]:
            xmin = 425.500000
            xmax = 429.963000
            text = "tokį labiau išmanantį nu jie kadriniai karininkai vis tiek buvo. tai Jau beveik visi jie ten ir buvo"
        intervals [224]:
            xmin = 429.963000
            xmax = 446.960000
            text = ""
        intervals [225]:
            xmin = 446.960000
            xmax = 450.260000
            text = "Kas ten buvo rizika išvis tas laikotarpis yra visuotinio chaoso"
        intervals [226]:
            xmin = 450.260000
            xmax = 450.740000
            text = ""
        intervals [227]:
            xmin = 450.740000
            xmax = 452.524000
            text = "ir visos kariuomenės"
        intervals [228]:
            xmin = 452.524000
            xmax = 452.770000
            text = ""
        intervals [229]:
            xmin = 452.770000
            xmax = 455.330000
            text = "kurios kūrėsi Lietuvos kariuomenė, kūrėsi bent trys"
        intervals [230]:
            xmin = 455.330000
            xmax = 456.980000
            text = "kariuomenės. Vienu metu. Lietuvoje"
        intervals [231]:
            xmin = 456.980000
            xmax = 457.310000
            text = ""
        intervals [232]:
            xmin = 457.310000
            xmax = 458.900000
            text = "tai labai jautėsi pavyzdžiui Vilniuje"
        intervals [233]:
            xmin = 458.900000
            xmax = 459.230000
            text = ""
        intervals [234]:
            xmin = 459.230000
            xmax = 463.970000
            text = "nes kūrėsi ir Lietuvos kariuomenė, kūrėsi ir Lenkijos kariuomenė, kūrėsi bolševikų įvairūs"
        intervals [235]:
            xmin = 463.970000
            xmax = 464.480000
            text = "daliniai,"
        intervals [236]:
            xmin = 464.480000
            xmax = 465.500000
            text = ""
        intervals [237]:
            xmin = 465.500000
            xmax = 467.584000
            text = "ir tie patys bermontininkai čia, Lietuvoj, "
        intervals [238]:
            xmin = 467.584000
            xmax = 470.450000
            text = ""
        intervals [239]:
            xmin = 470.450000
            xmax = 472.730000
            text = "ir tuo pačiu labai herojiškas laikas."
        intervals [240]:
            xmin = 472.730000
            xmax = 490.610000
            text = ""
        intervals [241]:
            xmin = 490.610000
            xmax = 491.900000
            text = "Problema ir galimybė."
        intervals [242]:
            xmin = 491.900000
            xmax = 492.170000
            text = ""
        intervals [243]:
            xmin = 492.170000
            xmax = 496.550000
            text = "va čia yra labai svarbus dalykas, kad visi suprato, kad senasis pasaulis žlugo."
        intervals [244]:
            xmin = 496.550000
            xmax = 497.210000
            text = ""
        intervals [245]:
            xmin = 497.210000
            xmax = 500.540000
            text = "Tiek Rusijos imperija tiek Vokietijos imperija griūtyje."
        intervals [246]:
            xmin = 500.540000
            xmax = 501.110000
            text = ""
        intervals [247]:
            xmin = 501.110000
            xmax = 501.740000
            text = "Ir dabar"
        intervals [248]:
            xmin = 501.740000
            xmax = 501.860000
            text = ""
        intervals [249]:
            xmin = 501.860000
            xmax = 502.520000
            text = "šitoje"
        intervals [250]:
            xmin = 502.520000
            xmax = 502.670000
            text = ""
        intervals [251]:
            xmin = 502.670000
            xmax = 507.410000
            text = "niekieno žemėj, tokioj atsiradusioj, prasideda kūrimo procesas ir dabar kas"
        intervals [252]:
            xmin = 507.410000
            xmax = 507.440000
            text = ""
        intervals [253]:
            xmin = 507.440000
            xmax = 509.000000
            text = "kas, kas sukurs,"
        intervals [254]:
            xmin = 509.000000
            xmax = 509.720000
            text = ""
        intervals [255]:
            xmin = 509.720000
            xmax = 510.200000
            text = "ir"
        intervals [256]:
            xmin = 510.200000
            xmax = 510.380000
            text = ""
        intervals [257]:
            xmin = 510.380000
            xmax = 513.049000
            text = "kartais atrodo nu kaip tie žmonės. Galėjo tikėti Lietuva."
        intervals [258]:
            xmin = 513.049000
            xmax = 513.380000
            text = ""
        intervals [259]:
            xmin = 513.380000
            xmax = 515.059000
            text = "Bet jie nelabai turėjo pasirinkimą,"
        intervals [260]:
            xmin = 515.059000
            xmax = 515.690000
            text = ""
        intervals [261]:
            xmin = 515.690000
            xmax = 516.282000
            text = "nes"
        intervals [262]:
            xmin = 516.282000
            xmax = 516.679000
            text = ""
        intervals [263]:
            xmin = 516.679000
            xmax = 518.659000
            text = "visos kariuomenės kuriasi tautiniu pagrindu"
        intervals [264]:
            xmin = 518.659000
            xmax = 519.692000
            text = ""
        intervals [265]:
            xmin = 519.692000
            xmax = 522.870000
            text = "Kai kuriais atvejais, kai bolševikai kažkokiu ideologiniu pagrindu"
        intervals [266]:
            xmin = 522.870000
            xmax = 523.320000
            text = ""
        intervals [267]:
            xmin = 523.320000
            xmax = 526.050000
            text = "ir tu tiesiog užklausi, kas tu esi"
        intervals [268]:
            xmin = 526.050000
            xmax = 526.200000
            text = ""
        intervals [269]:
            xmin = 526.200000
            xmax = 528.840000
            text = "ir kuo tu nori būti, ir pagal tai žmonės renkasi"
        intervals [270]:
            xmin = 528.840000
            xmax = 529.560000
            text = ""
        intervals [271]:
            xmin = 529.560000
            xmax = 533.070000
            text = "pasirinkti vieną ar kitą pusę. Kai kurie blaškosi, kai kurie laksto"
        intervals [272]:
            xmin = 533.070000
            xmax = 533.550000
            text = ""
        intervals [273]:
            xmin = 533.550000
            xmax = 538.262000
            text = "tarp kariuomenių, tarp tarp idėjų, tarp kitų dalykų. Tai va, tas laikas. Jisai toks"
        intervals [274]:
            xmin = 538.262000
            xmax = 538.350000
            text = ""
        intervals [275]:
            xmin = 538.350000
            xmax = 539.250000
            text = "sudėtingas, bet"
        intervals [276]:
            xmin = 539.250000
            xmax = 539.676000
            text = ""
        intervals [277]:
            xmin = 539.676000
            xmax = 544.410000
            text = "reik pastebėti, ko mes dažnai nenorime pasakyti, kad pirmasis Lietuvos kariuomenės"
        intervals [278]:
            xmin = 544.410000
            xmax = 546.300000
            text = "kūrimosi etapas vyksta iš esmės,"
        intervals [279]:
            xmin = 546.300000
            xmax = 546.620000
            text = ""
        intervals [280]:
            xmin = 546.620000
            xmax = 549.290000
            text = "vokiečių kariuomenės prižiūrimoj teritorijoj."
        intervals [281]:
            xmin = 549.290000
            xmax = 550.220000
            text = ""
        intervals [282]:
            xmin = 550.220000
            xmax = 553.010000
            text = "Aš sakyčiau, tai yra labai svarbu suvokti,"
        intervals [283]:
            xmin = 553.010000
            xmax = 553.370000
            text = ""
        intervals [284]:
            xmin = 553.370000
            xmax = 558.200000
            text = "nes kartais atrodo, kad čia mes nusprendėm ėmėm. Padarėm ne. Jeigu nebūtų to stogo, tai čia"
        intervals [285]:
            xmin = 558.200000
            xmax = 558.230000
            text = ""
        intervals [286]:
            xmin = 558.230000
            xmax = 559.490000
            text = "nieko net nebūtų atsiradę,"
        intervals [287]:
            xmin = 559.490000
            xmax = 559.940000
            text = ""
        intervals [288]:
            xmin = 559.940000
            xmax = 563.060000
            text = "nes mes neturėjom į ką atsiremti. Nebuvo nė vienos valstybės,"
        intervals [289]:
            xmin = 563.060000
            xmax = 563.420000
            text = ""
        intervals [290]:
            xmin = 563.420000
            xmax = 566.390000
            text = "išskyrus Vokietiją, kuriem mes buvom naudingi,"
        intervals [291]:
            xmin = 566.390000
            xmax = 567.290000
            text = ""
        intervals [292]:
            xmin = 567.290000
            xmax = 572.428000
            text = "ir čia mūsų buvo silpnoji vieta. Bet štai šitas stogas, kuris išbuvo na apie pusę metų, sakykim"
        intervals [293]:
            xmin = 572.428000
            xmax = 572.910000
            text = ""
        intervals [294]:
            xmin = 572.910000
            xmax = 578.310000
            text = "jis vis tik sudarė sąlygas mums sustiprėti, šiek tiek apsitvarkyti ir tapti savarankiška"
        intervals [295]:
            xmin = 578.310000
            xmax = 578.580000
            text = ""
        intervals [296]:
            xmin = 578.580000
            xmax = 579.572000
            text = "Lietuvos kariuomene"
        intervals [297]:
            xmin = 579.572000
            xmax = 603.870000
            text = ""
        intervals [298]:
            xmin = 603.870000
            xmax = 609.750000
            text = "Taip čia ir yra. Įdomiausias dalykas, kad daugumas tų karininkų, kurie paskui vadovo tam saksų, tai divizijai,"
        intervals [299]:
            xmin = 609.750000
            xmax = 610.189000
            text = ""
        intervals [300]:
            xmin = 610.189000
            xmax = 611.970000
            text = "ypatingai, tai pietinei brigadai."
        intervals [301]:
            xmin = 611.970000
            xmax = 612.420000
            text = ""
        intervals [302]:
            xmin = 612.420000
            xmax = 616.830000
            text = "Tai buvo tie patys žmonės, kurie tarnavo Lietuvoj nuo nuo nuo penkioliktų šešioliktų"
        intervals [303]:
            xmin = 616.830000
            xmax = 618.060000
            text = "septynioliktų metų."
        intervals [304]:
            xmin = 618.060000
            xmax = 618.180000
            text = ""
        intervals [305]:
            xmin = 618.180000
            xmax = 621.810000
            text = "Todėl, kad jie puikiai suprato, kad grįžus į Vokietiją jų niekas nelaukia."
        intervals [306]:
            xmin = 621.810000
            xmax = 622.230000
            text = ""
        intervals [307]:
            xmin = 622.230000
            xmax = 622.410000
            text = "O"
        intervals [308]:
            xmin = 622.410000
            xmax = 622.980000
            text = ""
        intervals [309]:
            xmin = 622.980000
            xmax = 625.170000
            text = "vis tiek kažkokios algos, kažkoks statusas."
        intervals [310]:
            xmin = 625.170000
            xmax = 625.580000
            text = ""
        intervals [311]:
            xmin = 625.580000
            xmax = 627.830000
            text = "Na, ir jie turėjo tam tikrų užduočių,"
        intervals [312]:
            xmin = 627.830000
            xmax = 628.948000
            text = ""
        intervals [313]:
            xmin = 628.948000
            xmax = 633.170000
            text = "mes galvojam, kad ta Vokietija tokia stabili. Ne po karo ten gi buvo visiška blogai. Ten"
        intervals [314]:
            xmin = 633.170000
            xmax = 633.200000
            text = ""
        intervals [315]:
            xmin = 633.200000
            xmax = 634.820000
            text = "chaosas prasidėjo revoliucija,"
        intervals [316]:
            xmin = 634.820000
            xmax = 635.600000
            text = ""
        intervals [317]:
            xmin = 635.600000
            xmax = 639.110000
            text = "ir ta ta, sakykim, senoji kariuomenė akivaizdžiai subyrėjo,"
        intervals [318]:
            xmin = 639.110000
            xmax = 641.090000
            text = ""
        intervals [319]:
            xmin = 641.090000
            xmax = 645.710000
            text = "tapo nevaldoma. Vienintelis būdas buvo juos išvežti visus namo ir ir atvežti čia"
        intervals [320]:
            xmin = 645.710000
            xmax = 645.740000
            text = ""
        intervals [321]:
            xmin = 645.740000
            xmax = 650.240000
            text = "kitus. Arba tie patys žmonės. Kai kurie iš tų karių, kurie buvo demobilizuojami."
        intervals [322]:
            xmin = 650.240000
            xmax = 650.640000
            text = ""
        intervals [323]:
            xmin = 650.640000
            xmax = 654.930000
            text = "Jie jau žinojo, kad namuose jų niekas nelaukia. Baisi bedarbystė, chaosas,"
        intervals [324]:
            xmin = 654.930000
            xmax = 661.200000
            text = ""
        intervals [325]:
            xmin = 661.200000
            xmax = 664.890000
            text = "ne tiktai ten. Iš Saksonijos atvežė čia tuos saksus savanorius, bet realiai"
        intervals [326]:
            xmin = 664.890000
            xmax = 665.100000
            text = ""
        intervals [327]:
            xmin = 665.100000
            xmax = 666.750000
            text = "kai kurie jau čia ir buvo Lietuvoj"
        intervals [328]:
            xmin = 666.750000
            xmax = 666.960000
            text = ""
        intervals [329]:
            xmin = 666.960000
            xmax = 670.470000
            text = "karininkai. Puskarininkiai - tai didžiąja dauguma nu kareiviai. Ten įvairiai buvo"
        intervals [330]:
            xmin = 670.470000
            xmax = 671.100000
            text = ""
        intervals [331]:
            xmin = 671.100000
            xmax = 672.786000
            text = "ir ir tie patys"
        intervals [332]:
            xmin = 672.786000
            xmax = 673.110000
            text = ""
        intervals [333]:
            xmin = 673.110000
            xmax = 678.480000
            text = "žmonės. Jie, jie tą Lietuvą, gerai puikiausiai pažinojo visus visas teritorijas visas svarbias vietas."
        intervals [334]:
            xmin = 678.480000
            xmax = 678.930000
            text = ""
        intervals [335]:
            xmin = 678.930000
            xmax = 679.470000
            text = "Na, ir"
        intervals [336]:
            xmin = 679.470000
            xmax = 679.900000
            text = ""
        intervals [337]:
            xmin = 679.900000
            xmax = 681.370000
            text = "paskaičius jų dokumentus,"
        intervals [338]:
            xmin = 681.370000
            xmax = 681.640000
            text = ""
        intervals [339]:
            xmin = 681.640000
            xmax = 685.998000
            text = "tai neatrodo, kad čia Lietuva kūrėsi. Atrodo, kad tai yra vokiečių kariuomenės projektas."
        intervals [340]:
            xmin = 685.998000
            xmax = 686.592000
            text = ""
        intervals [341]:
            xmin = 686.592000
            xmax = 688.870000
            text = "kažkokių vietinių kuriami kažkokie daliniai."
        intervals [342]:
            xmin = 688.870000
            xmax = 689.380000
            text = ""
        intervals [343]:
            xmin = 689.380000
            xmax = 694.240000
            text = "Bet, sakau, tas toks vaizdas iki gegužės iki birželio. Paskui radikaliai keičiasi situacija."
        intervals [344]:
            xmin = 694.240000
            xmax = 716.870000
            text = ""
        intervals [345]:
            xmin = 716.870000
            xmax = 717.560000
            text = "Labai sunkiai"
        intervals [346]:
            xmin = 717.560000
            xmax = 718.520000
            text = ""
        intervals [347]:
            xmin = 718.520000
            xmax = 726.680000
            text = "po antro pasaulinio karo ginklų Lietuvoj buvo pilna. Kadangi frontas čia ėjo, reiškia ir ten primėtė, ir susirinko kaimiečiai ten, laukuose,"
        intervals [348]:
            xmin = 726.680000
            xmax = 727.250000
            text = ""
        intervals [349]:
            xmin = 727.250000
            xmax = 731.870000
            text = "o po Pirmo pasaulinio - visai kita situacija. Kadangi vokiečiai ginklus surinko labai"
        intervals [350]:
            xmin = 731.870000
            xmax = 732.320000
            text = "greitai"
        intervals [351]:
            xmin = 732.320000
            xmax = 732.740000
            text = ""
        intervals [352]:
            xmin = 732.740000
            xmax = 734.450000
            text = "ir atgal, proceso nebuvo."
        intervals [353]:
            xmin = 734.450000
            xmax = 734.780000
            text = ""
        intervals [354]:
            xmin = 734.780000
            xmax = 736.910000
            text = "reiškia nevyko kaip kešim ketvirtais"
        intervals [355]:
            xmin = 736.910000
            xmax = 737.090000
            text = ""
        intervals [356]:
            xmin = 737.090000
            xmax = 738.920000
            text = "Lietuvoj. Atgalinis procesas - tai"
        intervals [357]:
            xmin = 738.920000
            xmax = 739.400000
            text = ""
        intervals [358]:
            xmin = 739.400000
            xmax = 744.050000
            text = "praktiškai Lietuva atrodė taip, kaip vokiečiai ją prižiūrėjo nuo penkioliktų metų. Tai"
        intervals [359]:
            xmin = 744.050000
            xmax = 744.330000
            text = ""
        intervals [360]:
            xmin = 744.330000
            xmax = 746.370000
            text = "natūralu, kad tų ginklų tikrai trūko,"
        intervals [361]:
            xmin = 746.370000
            xmax = 746.610000
            text = ""
        intervals [362]:
            xmin = 746.610000
            xmax = 748.710000
            text = "ir įsigyti jų buvo ne taip paprasta."
        intervals [363]:
            xmin = 748.710000
            xmax = 749.730000
            text = ""
        intervals [364]:
            xmin = 749.730000
            xmax = 753.570000
            text = "Aišku, pačių ginklų Vokietijoj, pavyzdžiui, buvo didžiulis kiekis,"
        intervals [365]:
            xmin = 753.570000
            xmax = 753.870000
            text = ""
        intervals [366]:
            xmin = 753.870000
            xmax = 755.433000
            text = "nes karo pramonė jinai"
        intervals [367]:
            xmin = 755.433000
            xmax = 755.588000
            text = ""
        intervals [368]:
            xmin = 755.588000
            xmax = 758.541000
            text = "Negali taip iškart sustoti. Dar dar dar produkuoja dar"
        intervals [369]:
            xmin = 758.541000
            xmax = 763.410000
            text = ""
        intervals [370]:
            xmin = 763.410000
            xmax = 765.450000
            text = "pinigų. Aišku, nebrangūs tie ginklai,"
        intervals [371]:
            xmin = 765.450000
            xmax = 765.900000
            text = ""
        intervals [372]:
            xmin = 765.900000
            xmax = 770.400000
            text = "bet tų pinigų irgi nėra. Tai realiai mes turėjom pirkti pinigus iš tų pačių pinigų, kuriuos"
        intervals [373]:
            xmin = 770.400000
            xmax = 772.170000
            text = "skolinomės pradžioj iš vokiečių."
        intervals [374]:
            xmin = 772.170000
            xmax = 773.647000
            text = ""
        intervals [375]:
            xmin = 773.647000
            xmax = 777.970000
            text = "suteikė tam tikras paskolas. Tai čia taip, tai toks žaidimas. Truputėlį tie patys vokiški"
        intervals [376]:
            xmin = 777.970000
            xmax = 779.590000
            text = "pinigai tik pasikeitę, bet po to"
        intervals [377]:
            xmin = 779.590000
            xmax = 779.890000
            text = ""
        intervals [378]:
            xmin = 779.890000
            xmax = 784.780000
            text = "atsirado daugiau finansavimo šaltinių. Ir tada buvo galima įsigyti tų ginklų ir įvairesnių, ir,"
        intervals [379]:
            xmin = 784.780000
            xmax = 785.290000
            text = ""
        intervals [380]:
            xmin = 785.290000
            xmax = 787.090000
            text = "ir, ir, ir patikimesnių,"
        intervals [381]:
            xmin = 787.090000
            xmax = 787.450000
            text = ""
        intervals [382]:
            xmin = 787.450000
            xmax = 789.160000
            text = "ir atsirado didžiulė įvairovė."
        intervals [383]:
            xmin = 789.160000
            xmax = 789.400000
            text = ""
        intervals [384]:
            xmin = 789.400000
            xmax = 792.940000
            text = "Irgi yra problemų, kaip paskui aprūpint tokią kariuomenę, kai net kalibrai skiriasi."
        intervals [385]:
            xmin = 792.940000
            xmax = 793.540000
            text = ""
        intervals [386]:
            xmin = 793.540000
            xmax = 796.900000
            text = "Tai va, tai čia su ginklais turėjom labai didelių problemų."
        intervals [387]:
            xmin = 796.900000
            xmax = 797.130000
            text = ""
        intervals [388]:
            xmin = 797.130000
            xmax = 801.750000
            text = "Ypatingai trūko, sakykim, pradiniam tam laikotarpy sunkesnių ginklų, kulkosvaidžių ir"
        intervals [389]:
            xmin = 801.750000
            xmax = 802.770000
            text = "panašių dalykų. Tai,"
        intervals [390]:
            xmin = 802.770000
            xmax = 803.280000
            text = ""
        intervals [391]:
            xmin = 803.280000
            xmax = 805.500000
            text = "o dar ir mokančių jais naudotis ne taip daug buvo."
        intervals [392]:
            xmin = 805.500000
            xmax = 806.070000
            text = ""
        intervals [393]:
            xmin = 806.070000
            xmax = 810.930000
            text = "Tai čia mes turim. Turim tokią tokį keistą laikotarpį. Aš tai net šian pagalvojau,"
        intervals [394]:
            xmin = 810.930000
            xmax = 814.530000
            text = "kad tai turbūt vokiškasis Lietuvos kariuomenės kūrimosi laikotarpis,"
        intervals [395]:
            xmin = 814.530000
            xmax = 815.390000
            text = ""
        intervals [396]:
            xmin = 815.390000
            xmax = 816.890000
            text = "pavyzdžiui, gaunam, lėktuvų"
        intervals [397]:
            xmin = 816.890000
            xmax = 817.854000
            text = ""
        intervals [398]:
            xmin = 817.854000
            xmax = 818.740000
            text = "su Lakūnais"
        intervals [399]:
            xmin = 818.740000
            xmax = 825.430000
            text = ""
        intervals [400]:
            xmin = 825.430000
            xmax = 829.900000
            text = "laikas, o pradžioj tai buvo tie patys lėktuvai, kurie pirmo pasaulinio karo metu čia tarnavo"
        intervals [401]:
            xmin = 829.900000
            xmax = 830.470000
            text = "Lietuvoje."
        intervals [402]:
            xmin = 830.470000
            xmax = 830.950000
            text = ""
        intervals [403]:
            xmin = 830.950000
            xmax = 831.550000
            text = "Ir ir"
        intervals [404]:
            xmin = 831.550000
            xmax = 833.830000
            text = ""
        intervals [405]:
            xmin = 833.830000
            xmax = 836.098000
            text = "tai tai viskas pradžioj taip atrodo. Bet"
        intervals [406]:
            xmin = 836.098000
            xmax = 836.360000
            text = ""
        intervals [407]:
            xmin = 836.360000
            xmax = 838.300000
            text = "bet tas lietuvių dalyvavimas, sakyčiau,"
        intervals [408]:
            xmin = 838.300000
            xmax = 838.540000
            text = ""
        intervals [409]:
            xmin = 838.540000
            xmax = 839.620000
            text = "labai akivaizdžiai"
        intervals [410]:
            xmin = 839.620000
            xmax = 839.860000
            text = ""
        intervals [411]:
            xmin = 839.860000
            xmax = 841.900000
            text = "stiprėja vat į pavasario pabaigą."
        intervals [412]:
            xmin = 841.900000
            xmax = 854.549000
            text = ""
        intervals [413]:
            xmin = 854.549000
            xmax = 858.920000
            text = "apsirengęs, su trikampėliu, su kepuraite, va kepuraitės - toks pirmas daiktas,"
        intervals [414]:
            xmin = 858.920000
            xmax = 860.390000
            text = "kurį turėjo Lietuvos kariuomenė."
        intervals [415]:
            xmin = 860.390000
            xmax = 860.940000
            text = ""
        intervals [416]:
            xmin = 860.940000
            xmax = 863.250000
            text = "Tai iš tikrųjų taip, taip, viskas gan niūriai atrodo."
        intervals [417]:
            xmin = 863.250000
            xmax = 863.550000
            text = ""
        intervals [418]:
            xmin = 863.550000
            xmax = 867.750000
            text = "Batų ten pas kai ką trūko, reiškia tai tokios tokios egzistencinės problemos."
        intervals [419]:
            xmin = 867.750000
            xmax = 908.580000
            text = ""
        intervals [420]:
            xmin = 908.580000
            xmax = 912.990000
            text = "taip reikia pastebėt, kad lenkų kariuomenė Lietuvoje kūrėsi tuo pačiu metu"
        intervals [421]:
            xmin = 912.990000
            xmax = 913.650000
            text = "visiškai,"
        intervals [422]:
            xmin = 913.650000
            xmax = 914.040000
            text = ""
        intervals [423]:
            xmin = 914.040000
            xmax = 918.870000
            text = "nes jie irgi neturėjo teisės to daryt iki aštuonioliktų metų lapkričio vienuoliktos dienos iki karo"
        intervals [424]:
            xmin = 918.870000
            xmax = 919.530000
            text = "pabaigos,"
        intervals [425]:
            xmin = 919.530000
            xmax = 919.950000
            text = ""
        intervals [426]:
            xmin = 919.950000
            xmax = 923.370000
            text = "ir tos samobronos irgi čia, Vilniaus krašte, kūrėsi"
        intervals [427]:
            xmin = 923.370000
            xmax = 923.640000
            text = ""
        intervals [428]:
            xmin = 923.640000
            xmax = 924.780000
            text = "lietuvių - gudų divizija."
        intervals [429]:
            xmin = 924.780000
            xmax = 925.740000
            text = ""
        intervals [430]:
            xmin = 925.740000
            xmax = 926.160000
            text = "kaip ten"
        intervals [431]:
            xmin = 926.160000
            xmax = 926.370000
            text = ""
        intervals [432]:
            xmin = 926.370000
            xmax = 927.720000
            text = "per vieną dieną skyrėsi"
        intervals [433]:
            xmin = 927.720000
            xmax = 928.410000
            text = ""
        intervals [434]:
            xmin = 928.410000
            xmax = 929.220000
            text = "kūrimo laikas."
        intervals [435]:
            xmin = 929.220000
            xmax = 929.730000
            text = ""
        intervals [436]:
            xmin = 929.730000
            xmax = 930.254000
            text = "Bet"
        intervals [437]:
            xmin = 930.254000
            xmax = 930.750000
            text = ""
        intervals [438]:
            xmin = 930.750000
            xmax = 935.340000
            text = "bet čia, sakyčiau, tautinis klausimas. Ir kuo tu save laikai tapo tokiu esminiu."
        intervals [439]:
            xmin = 935.340000
            xmax = 942.777000
            text = ""
        intervals [440]:
            xmin = 942.777000
            xmax = 945.710000
            text = "nes iš tikrųjų tai ne taip paprasta pasakyt. Jeigu sakykim"
        intervals [441]:
            xmin = 945.710000
            xmax = 946.070000
            text = ""
        intervals [442]:
            xmin = 946.070000
            xmax = 948.740000
            text = "kokioj ten, Suvalkijoj, Dzūkijoj, tai čia viskas aišku."
        intervals [443]:
            xmin = 948.740000
            xmax = 949.490000
            text = ""
        intervals [444]:
            xmin = 949.490000
            xmax = 951.890000
            text = "Žmonės labai aiškiai suvokė, kas jie tokie yra"
        intervals [445]:
            xmin = 951.890000
            xmax = 952.010000
            text = ""
        intervals [446]:
            xmin = 952.010000
            xmax = 956.990000
            text = "ir kalba, ir ir religija čia buvo mūsų atrankos kriterijai. Tai, pavyzdžiui, Vilniaus krašte tai buvo viskas"
        intervals [447]:
            xmin = 956.990000
            xmax = 958.188000
            text = "labai labai dar neaišku,"
        intervals [448]:
            xmin = 958.188000
            xmax = 958.610000
            text = ""
        intervals [449]:
            xmin = 958.610000
            xmax = 960.800000
            text = "ir, ir ir čia reikia pasakyt, kad ir"
        intervals [450]:
            xmin = 960.800000
            xmax = 960.920000
            text = ""
        intervals [451]:
            xmin = 960.920000
            xmax = 964.070000
            text = "gyventojų sudėtis tokia įdomi buvo, bet ir suvokimas,"
        intervals [452]:
            xmin = 964.070000
            xmax = 964.310000
            text = ""
        intervals [453]:
            xmin = 964.310000
            xmax = 965.334000
            text = "kas yra Lietuva, "
        intervals [454]:
            xmin = 965.334000
            xmax = 984.370000
            text = ""
        intervals [455]:
            xmin = 984.370000
            xmax = 988.420000
            text = "Taip ir dar reikia pasakyt, kad Vilniuje buvo nemažai ir bolševikam prijaučiančių."
        intervals [456]:
            xmin = 988.420000
            xmax = 989.020000
            text = ""
        intervals [457]:
            xmin = 989.020000
            xmax = 991.420000
            text = "Todėl, kad vis tiktai buvo ir pramoninis miestas."
        intervals [458]:
            xmin = 991.420000
            xmax = 993.760000
            text = ""
        intervals [459]:
            xmin = 993.760000
            xmax = 995.470000
            text = "Taip taip ir neužmirškim, kad"
        intervals [460]:
            xmin = 995.470000
            xmax = 995.860000
            text = ""
        intervals [461]:
            xmin = 995.860000
            xmax = 996.550000
            text = "žydų yra"
        intervals [462]:
            xmin = 996.550000
            xmax = 997.060000
            text = ""
        intervals [463]:
            xmin = 997.060000
            xmax = 997.990000
            text = "miesteliuose,"
        intervals [464]:
            xmin = 997.990000
            xmax = 998.140000
            text = ""
        intervals [465]:
            xmin = 998.140000
            xmax = 999.970000
            text = "miestuose, didelis kiekis"
        intervals [466]:
            xmin = 999.970000
            xmax = 1000.390000
            text = ""
        intervals [467]:
            xmin = 1000.390000
            xmax = 1002.940000
            text = "ir ir žydų tautybės žmones. Jie"
        intervals [468]:
            xmin = 1002.940000
            xmax = 1003.450000
            text = ""
        intervals [469]:
            xmin = 1003.450000
            xmax = 1005.640000
            text = "savo nekuria kariuomenės"
        intervals [470]:
            xmin = 1005.640000
            xmax = 1006.180000
            text = ""
        intervals [471]:
            xmin = 1006.180000
            xmax = 1007.560000
            text = "jie prie kažko jungiasi"
        intervals [472]:
            xmin = 1007.560000
            xmax = 1008.100000
            text = ""
        intervals [473]:
            xmin = 1008.100000
            xmax = 1012.810000
            text = "prie vienų ir prie kitų. O o o žydų dalyvavimas šituose procesuose yra svarbus"
        intervals [474]:
            xmin = 1012.810000
            xmax = 1013.140000
            text = "tuo,"
        intervals [475]:
            xmin = 1013.140000
            xmax = 1013.500000
            text = ""
        intervals [476]:
            xmin = 1013.500000
            xmax = 1017.828000
            text = "kad jie išmano kai kurias sritis, kurių neišmano, sakykim, pavyzdžiui, lietuviai, "
        intervals [477]:
            xmin = 1017.828000
            xmax = 1018.830000
            text = ""
        intervals [478]:
            xmin = 1018.830000
            xmax = 1019.665000
            text = "pavyzdžiui, logistika"
        intervals [479]:
            xmin = 1019.665000
            xmax = 1020.080000
            text = ""
        intervals [480]:
            xmin = 1020.080000
            xmax = 1023.810000
            text = "be logistikos nieko tu nepadarysi, o čia tradiciškai - ne lietuvių reguliavimo"
        intervals [481]:
            xmin = 1023.810000
            xmax = 1023.840000
            text = ""
        intervals [482]:
            xmin = 1023.840000
            xmax = 1024.890000
            text = "sritis. Ir dėl to"
        intervals [483]:
            xmin = 1024.890000
            xmax = 1026.000000
            text = ""
        intervals [484]:
            xmin = 1026.000000
            xmax = 1029.900000
            text = "tikrai vat. Šitas aspektas nėra iki galo atskleistas. Kaip tenai iš tikrųjų tvarkėsi"
        intervals [485]:
            xmin = 1029.900000
            xmax = 1030.290000
            text = ""
        intervals [486]:
            xmin = 1030.290000
            xmax = 1030.829000
            text = "reikalai,"
        intervals [487]:
            xmin = 1030.829000
            xmax = 1031.400000
            text = ""
        intervals [488]:
            xmin = 1031.400000
            xmax = 1036.230000
            text = "bet mes turėjom infrastruktūrą. Dabar apie tuos privalumus nes saakom. Visko trūko. Bet ko mes turėjom"
        intervals [489]:
            xmin = 1036.230000
            xmax = 1037.010000
            text = ""
        intervals [490]:
            xmin = 1037.010000
            xmax = 1039.500000
            text = "Mes turėjom neblogai sutvarkytą infrastruktūrą"
        intervals [491]:
            xmin = 1039.500000
            xmax = 1040.280000
            text = ""
        intervals [492]:
            xmin = 1040.280000
            xmax = 1041.026000
            text = "todėl, kad"
        intervals [493]:
            xmin = 1041.026000
            xmax = 1041.510000
            text = ""
        intervals [494]:
            xmin = 1041.510000
            xmax = 1046.190000
            text = "vokiečiai perdarė visus Lietuvos geležinkelius vakarietiška maniera. Jeigu taip galima pasakyt, per"
        intervals [495]:
            xmin = 1046.190000
            xmax = 1047.008000
            text = "pusantrų metų"
        intervals [496]:
            xmin = 1047.008000
            xmax = 1047.589000
            text = ""
        intervals [497]:
            xmin = 1047.589000
            xmax = 1050.860000
            text = "čia mes daba dirbam dešimtmečiais, jie per pusantrų metų, nes labai reikėjo."
        intervals [498]:
            xmin = 1050.860000
            xmax = 1051.640000
            text = ""
        intervals [499]:
            xmin = 1051.640000
            xmax = 1052.720000
            text = "Turėjom šiek tiek"
        intervals [500]:
            xmin = 1052.720000
            xmax = 1053.110000
            text = ""
        intervals [501]:
            xmin = 1053.110000
            xmax = 1053.560000
            text = "ūkio."
        intervals [502]:
            xmin = 1053.560000
            xmax = 1054.010000
            text = ""
        intervals [503]:
            xmin = 1054.010000
            xmax = 1056.590000
            text = "Turėjom šiek tiek sutvarkytų reikalų."
        intervals [504]:
            xmin = 1056.590000
            xmax = 1057.062000
            text = ""
        intervals [505]:
            xmin = 1057.062000
            xmax = 1061.240000
            text = "Negalėjom pasitikėti specialistais labai dažnai, nes jų irgi įvairios buvo"
        intervals [506]:
            xmin = 1061.240000
            xmax = 1061.300000
            text = ""
        intervals [507]:
            xmin = 1061.300000
            xmax = 1062.320000
            text = "motyvacijos."
        intervals [508]:
            xmin = 1062.320000
            xmax = 1062.440000
            text = ""
        intervals [509]:
            xmin = 1062.440000
            xmax = 1064.270000
            text = "Dažnai buvo tokių pavyzdžių, kad"
        intervals [510]:
            xmin = 1064.270000
            xmax = 1064.450000
            text = ""
        intervals [511]:
            xmin = 1064.450000
            xmax = 1065.890000
            text = "traukinys nuvažiuoja ne ten"
        intervals [512]:
            xmin = 1065.890000
            xmax = 1066.250000
            text = ""
        intervals [513]:
            xmin = 1066.250000
            xmax = 1066.640000
            text = "arba"
        intervals [514]:
            xmin = 1066.640000
            xmax = 1066.760000
            text = ""
        intervals [515]:
            xmin = 1066.760000
            xmax = 1069.400000
            text = "toks gali įtarti, kad sabotavimas kažkoks tai vyksta"
        intervals [516]:
            xmin = 1069.400000
            xmax = 1070.120000
            text = ""
        intervals [517]:
            xmin = 1070.120000
            xmax = 1071.650000
            text = "ir taip pat maisto turėjom."
        intervals [518]:
            xmin = 1071.650000
            xmax = 1071.890000
            text = ""
        intervals [519]:
            xmin = 1071.890000
            xmax = 1076.120000
            text = "Čia buvo didžiulis privalumas. Tuo metu lietuviai turėjo ką valgyt"
        intervals [520]:
            xmin = 1076.120000
            xmax = 1077.227000
            text = ""
        intervals [521]:
            xmin = 1077.227000
            xmax = 1081.410000
            text = "prašo reiškia tas pirmąsias kovas, kad kada jau lietuviai su vokiečiais kartu kariavo prieš"
        intervals [522]:
            xmin = 1081.410000
            xmax = 1083.690000
            text = "bolševikus, ir užima kažkokią tai ten, sakykim"
        intervals [523]:
            xmin = 1083.690000
            xmax = 1084.050000
            text = ""
        intervals [524]:
            xmin = 1084.050000
            xmax = 1084.980000
            text = "priešų stovyklą,"
        intervals [525]:
            xmin = 1084.980000
            xmax = 1085.280000
            text = ""
        intervals [526]:
            xmin = 1085.280000
            xmax = 1087.590000
            text = "tai lietuviai paima ginklus, o vokiečiai - maistą."
        intervals [527]:
            xmin = 1087.590000
            xmax = 1096.012000
            text = ""
        intervals [528]:
            xmin = 1096.012000
            xmax = 1099.540000
            text = "Ir tai yra vienas didžiausių privalumų mūsų šito žemės ūkio krašto,"
        intervals [529]:
            xmin = 1099.540000
            xmax = 1100.651000
            text = ""
        intervals [530]:
            xmin = 1100.651000
            xmax = 1102.360000
            text = "nepaisant visų vokiečių"
        intervals [531]:
            xmin = 1102.360000
            xmax = 1103.170000
            text = ""
        intervals [532]:
            xmin = 1103.170000
            xmax = 1105.060000
            text = "reparacijų ir kitų dalykų,"
        intervals [533]:
            xmin = 1105.060000
            xmax = 1105.360000
            text = ""
        intervals [534]:
            xmin = 1105.360000
            xmax = 1107.010000
            text = "kaime valgyt tikrai buvo,"
        intervals [535]:
            xmin = 1107.010000
            xmax = 1107.740000
            text = ""
        intervals [536]:
            xmin = 1107.740000
            xmax = 1107.950000
            text = "Tai"
        intervals [537]:
            xmin = 1107.950000
            xmax = 1108.211000
            text = ""
        intervals [538]:
            xmin = 1108.211000
            xmax = 1109.500000
            text = "labai svarbus resursas."
        intervals [539]:
            xmin = 1109.500000
            xmax = 1131.690000
            text = ""
        intervals [540]:
            xmin = 1131.690000
            xmax = 1134.060000
            text = "Reikia pasakyt, kad tų savanorių buvo visokių."
        intervals [541]:
            xmin = 1134.060000
            xmax = 1134.960000
            text = ""
        intervals [542]:
            xmin = 1134.960000
            xmax = 1139.670000
            text = "Labai dažnai Lietuvoj savanoriais vadinami visi Nepriklausomybės karų dalyviai. Tai nėra visai"
        intervals [543]:
            xmin = 1139.670000
            xmax = 1142.550000
            text = ""
        intervals [544]:
            xmin = 1142.550000
            xmax = 1142.850000
            text = "Tai"
        intervals [545]:
            xmin = 1142.850000
            xmax = 1143.180000
            text = ""
        intervals [546]:
            xmin = 1143.180000
            xmax = 1145.400000
            text = "taip skaičiuojama, kad apie tris tūkstančius"
        intervals [547]:
            xmin = 1145.400000
            xmax = 1145.970000
            text = ""
        intervals [548]:
            xmin = 1145.970000
            xmax = 1149.360000
            text = "savanorių Lietuvoj buvo tikrųjų savanorių, kurie atėjo iš tų"
        intervals [549]:
            xmin = 1149.360000
            xmax = 1151.681000
            text = ""
        intervals [550]:
            xmin = 1151.681000
            xmax = 1152.300000
            text = "yra"
        intervals [551]:
            xmin = 1152.300000
            xmax = 1152.630000
            text = ""
        intervals [552]:
            xmin = 1152.630000
            xmax = 1157.490000
            text = "geriausioji stipriausioji dalis. Tai žmonės, atėję iš kaimo aplinkui"
        intervals [553]:
            xmin = 1157.490000
            xmax = 1157.520000
            text = ""
        intervals [554]:
            xmin = 1157.520000
            xmax = 1158.060000
            text = "Kauną"
        intervals [555]:
            xmin = 1158.060000
            xmax = 1158.630000
            text = ""
        intervals [556]:
            xmin = 1158.630000
            xmax = 1163.550000
            text = "į pietus nuo Kauno, Marijampolė, Alytus Štai šitos visos žemės, kurios kažkada buvo Lenkijos"
        intervals [557]:
            xmin = 1163.550000
            xmax = 1166.280000
            text = "karalystė ir kur buvo tokie gaspadoriški žmonės,"
        intervals [558]:
            xmin = 1166.280000
            xmax = 1166.820000
            text = ""
        intervals [559]:
            xmin = 1166.820000
            xmax = 1171.440000
            text = "na, ir taip pat nemažai savanorių, atėjo iš Aukštaitijos. Tuo tarpu Žemaitijos krašte"
        intervals [560]:
            xmin = 1171.440000
            xmax = 1173.600000
            text = "savanorių buvo pakankamai mažai. Nes ir"
        intervals [561]:
            xmin = 1173.600000
            xmax = 1174.290000
            text = ""
        intervals [562]:
            xmin = 1174.290000
            xmax = 1178.910000
            text = "sąlygų kurti Lietuvos kariuomenei nebuvo, nes vis tik tą kraštą ir toliau kontroliavo. Vokiečiai"
        intervals [563]:
            xmin = 1178.910000
            xmax = 1179.210000
            text = ""
        intervals [564]:
            xmin = 1179.210000
            xmax = 1181.790000
            text = "ar vėliau bermontininkai, bet, vienu žodžiu, šitos jėgos,"
        intervals [565]:
            xmin = 1181.790000
            xmax = 1182.090000
            text = ""
        intervals [566]:
            xmin = 1182.090000
            xmax = 1186.980000
            text = "žinoma, lietuviškom komendantūron veikti ten bus sudarytos sąlygos, ir tų žmonių šiek tiek buvo."
        intervals [567]:
            xmin = 1186.980000
            xmax = 1188.690000
            text = "Bet santykinai jų buvo mažai."
        intervals [568]:
            xmin = 1188.690000
            xmax = 1195.190000
            text = ""
        intervals [569]:
            xmin = 1195.190000
            xmax = 1199.960000
            text = "kas kontroliavo realiai kraštą. Čia nuo to priklausė, nes vis tiek tada viešieji ryšiai visi vyksta"
        intervals [570]:
            xmin = 1199.960000
            xmax = 1203.080000
            text = "pilnai. Vienas dalykas, kada tu vokiečių kontroliuojamoj zonoj kažką"
        intervals [571]:
            xmin = 1203.080000
            xmax = 1203.690000
            text = ""
        intervals [572]:
            xmin = 1203.690000
            xmax = 1206.092000
            text = "o kitas kada gali naudoti kunigus ten ir"
        intervals [573]:
            xmin = 1206.092000
            xmax = 1206.870000
            text = ""
        intervals [574]:
            xmin = 1206.870000
            xmax = 1210.830000
            text = "kitus tuos re rekrutavimo būdus, tais laikais labai paplitusius, nes"
        intervals [575]:
            xmin = 1210.830000
            xmax = 1211.118000
            text = ""
        intervals [576]:
            xmin = 1211.118000
            xmax = 1212.626000
            text = "realiai, tą rekrutavimą darė"
        intervals [577]:
            xmin = 1212.626000
            xmax = 1212.742000
            text = ""
        intervals [578]:
            xmin = 1212.742000
            xmax = 1215.960000
            text = "karininkai pasiųsti aštuonioliktų metų pačioj pabaigoj"
        intervals [579]:
            xmin = 1215.960000
            xmax = 1215.990000
            text = ""
        intervals [580]:
            xmin = 1215.990000
            xmax = 1216.890000
            text = "Devynioliktų metų"
        intervals [581]:
            xmin = 1216.890000
            xmax = 1217.130000
            text = ""
        intervals [582]:
            xmin = 1217.130000
            xmax = 1221.630000
            text = "pradžioj reiškia rinkti žmonių. va tas gyvas žodis ėjimas, kalbėjimas, jisai duoda tą"
        intervals [583]:
            xmin = 1221.630000
            xmax = 1222.050000
            text = ""
        intervals [584]:
            xmin = 1222.050000
            xmax = 1223.130000
            text = "pagrindinį efektą,"
        intervals [585]:
            xmin = 1223.130000
            xmax = 1223.640000
            text = ""
        intervals [586]:
            xmin = 1223.640000
            xmax = 1227.398000
            text = "ir galbūt tai yra susiję ir su tam tikrom žmonių motyvacijom."
        intervals [587]:
            xmin = 1227.398000
            xmax = 1227.900000
            text = ""
        intervals [588]:
            xmin = 1227.900000
            xmax = 1228.560000
            text = "Vis tiktai"
        intervals [589]:
            xmin = 1228.560000
            xmax = 1228.980000
            text = ""
        intervals [590]:
            xmin = 1228.980000
            xmax = 1229.657000
            text = "šitas"
        intervals [591]:
            xmin = 1229.657000
            xmax = 1230.000000
            text = ""
        intervals [592]:
            xmin = 1230.000000
            xmax = 1231.320000
            text = "šitas Pietų Lietuvos"
        intervals [593]:
            xmin = 1231.320000
            xmax = 1232.760000
            text = ""
        intervals [594]:
            xmin = 1232.760000
            xmax = 1234.500000
            text = "pagal liudininkų pasakymus, buvo"
        intervals [595]:
            xmin = 1234.500000
            xmax = 1234.650000
            text = ""
        intervals [596]:
            xmin = 1234.650000
            xmax = 1236.720000
            text = "ypatingai patriotiškai nusiteikęs."
        intervals [597]:
            xmin = 1236.720000
            xmax = 1237.333000
            text = ""
        intervals [598]:
            xmin = 1237.333000
            xmax = 1238.870000
            text = "Na, gal, sakykim, šviesesnis"
        intervals [599]:
            xmin = 1238.870000
            xmax = 1239.200000
            text = ""
        intervals [600]:
            xmin = 1239.200000
            xmax = 1241.930000
            text = "išsilavinimo lygis buvo šitoj vietoj pakankamai geras."
        intervals [601]:
            xmin = 1241.930000
            xmax = 1242.290000
            text = ""
        intervals [602]:
            xmin = 1242.290000
            xmax = 1247.662000
            text = "Tai ir inteligentijos tokios buvo. Tai tai vienu žodžiu, šitas kraštas yra iš tikrųjų toksai labai stiprus."
        intervals [603]:
            xmin = 1247.662000
            xmax = 1248.230000
            text = ""
        intervals [604]:
            xmin = 1248.230000
            xmax = 1252.970000
            text = "Pavyzdžiui, Vilniuj rinkti savanorius į pirmą pulką buvo pakankamai problematiška."
        intervals [605]:
            xmin = 1252.970000
            xmax = 1256.210000
            text = "Todėl, kad ten tie žmonės buvo labai įvairių motyvacijų."
        intervals [606]:
            xmin = 1256.210000
            xmax = 1256.800000
            text = ""
        intervals [607]:
            xmin = 1256.800000
            xmax = 1260.430000
            text = "Ir dažnai kokia nors materialinės, tos motyvacijos už tai pirmo pulko"
        intervals [608]:
            xmin = 1260.430000
            xmax = 1261.510000
            text = ""
        intervals [609]:
            xmin = 1261.510000
            xmax = 1266.400000
            text = "nuopelnai pradiniam nepriklausomybės kovų etape yra kažkokie keisti jis toks tas"
        intervals [610]:
            xmin = 1266.400000
            xmax = 1270.300000
            text = "pulkas, toks kažkoks kitoks, reiškia tai iš principo Vilnius - netinkama vieta"
        intervals [611]:
            xmin = 1270.300000
            xmax = 1270.600000
            text = ""
        intervals [612]:
            xmin = 1270.600000
            xmax = 1274.803000
            text = "formuot Lietuvos kariuomenei Žymiai geriau buvo, kada buvo tas daroma Kaune, Alytuj"
        intervals [613]:
            xmin = 1274.803000
            xmax = 1275.113000
            text = ""
        intervals [614]:
            xmin = 1275.113000
            xmax = 1276.450000
            text = "ar kituose. Vat šituose"
        intervals [615]:
            xmin = 1276.450000
            xmax = 1276.750000
            text = ""
        intervals [616]:
            xmin = 1276.750000
            xmax = 1277.710000
            text = "labiau tokiuose,"
        intervals [617]:
            xmin = 1277.710000
            xmax = 1278.200000
            text = ""
        intervals [618]:
            xmin = 1278.200000
            xmax = 1282.850000
            text = "na lietuviškuose kraštuose. Bet, aišku, reikėtų prijungt ir didelę dalį Aukštaitijos ir"
        intervals [619]:
            xmin = 1282.850000
            xmax = 1282.910000
            text = ""
        intervals [620]:
            xmin = 1282.910000
            xmax = 1286.090000
            text = "Panevėžys ir Kėdainiai. ir Ukmergė visur čia, čia čia buvo tas"
        intervals [621]:
            xmin = 1286.090000
            xmax = 1286.330000
            text = ""
        intervals [622]:
            xmin = 1286.330000
            xmax = 1288.340000
            text = "ir tai ne tiek patys miestai, miesteliai,"
        intervals [623]:
            xmin = 1288.340000
            xmax = 1288.870000
            text = ""
        intervals [624]:
            xmin = 1288.870000
            xmax = 1289.830000
            text = "aplinkiniai kaimai"
        intervals [625]:
            xmin = 1289.830000
            xmax = 1302.380000
            text = ""
        intervals [626]:
            xmin = 1302.380000
            xmax = 1305.350000
            text = "susiejimas su šituo kraštu. Jisai labai buvo stiprus."
        intervals [627]:
            xmin = 1305.350000
            xmax = 1305.560000
            text = ""
        intervals [628]:
            xmin = 1305.560000
            xmax = 1306.340000
            text = "Tose vietose,"
        intervals [629]:
            xmin = 1306.340000
            xmax = 1307.240000
            text = ""
        intervals [630]:
            xmin = 1307.240000
            xmax = 1309.842000
            text = "o Vilniaus krašte buvo visaip, ir, pavyzdžiui, tas"
        intervals [631]:
            xmin = 1309.842000
            xmax = 1310.090000
            text = ""
        intervals [632]:
            xmin = 1310.090000
            xmax = 1312.079000
            text = "tas pirmųjų savanorių toks kartais"
        intervals [633]:
            xmin = 1312.079000
            xmax = 1312.760000
            text = ""
        intervals [634]:
            xmin = 1312.760000
            xmax = 1313.510000
            text = "nu toks"
        intervals [635]:
            xmin = 1313.510000
            xmax = 1314.500000
            text = ""
        intervals [636]:
            xmin = 1314.500000
            xmax = 1317.470000
            text = "visuotinis, reiškia pagyrimas. Kas yra, žinoma, gerai,"
        intervals [637]:
            xmin = 1317.470000
            xmax = 1318.100000
            text = ""
        intervals [638]:
            xmin = 1318.100000
            xmax = 1319.840000
            text = "nes taip formuojamas"
        intervals [639]:
            xmin = 1319.840000
            xmax = 1320.320000
            text = ""
        intervals [640]:
            xmin = 1320.320000
            xmax = 1324.038000
            text = "naujųjų savanorių reiškia institutas. Bet vis tik reikia suprasti, kad tų"
        intervals [641]:
            xmin = 1324.038000
            xmax = 1324.460000
            text = ""
        intervals [642]:
            xmin = 1324.460000
            xmax = 1326.950000
            text = "tokių keistų žmonių tenai buvo ir buvo žmonių, kurie"
        intervals [643]:
            xmin = 1326.950000
            xmax = 1327.190000
            text = ""
        intervals [644]:
            xmin = 1327.190000
            xmax = 1328.330000
            text = "vienu metu į kelias"
        intervals [645]:
            xmin = 1328.330000
            xmax = 1328.570000
            text = ""
        intervals [646]:
            xmin = 1328.570000
            xmax = 1336.400000
            text = "kariuomenes registruojasi ir žiūri, kur ten geresnės sąlygos, o sąlygos dažnai geresnės buvo arba pas lenkus, arba pas bolševikus Ten įvairiai būdavo. Tai"
        intervals [647]:
            xmin = 1336.400000
            xmax = 1336.730000
            text = ""
        intervals [648]:
            xmin = 1336.730000
            xmax = 1339.645000
            text = "vienu žodžiu čia mes turime tokią konkurencinę aplinką"
        intervals [649]:
            xmin = 1339.645000
            xmax = 1340.190000
            text = ""
        intervals [650]:
            xmin = 1340.190000
            xmax = 1341.020000
            text = "O tuo tarpu"
        intervals [651]:
            xmin = 1341.020000
            xmax = 1341.410000
            text = ""
        intervals [652]:
            xmin = 1341.410000
            xmax = 1345.940000
            text = "tuo tarpu Pietų Lietuvoj, centrinėj Lietuvoj Aukštaitijoj tos konkurencinės nebuvo."
        intervals [653]:
            xmin = 1345.940000
            xmax = 1346.720000
            text = "Aplinkos buvo"
        intervals [654]:
            xmin = 1346.720000
            xmax = 1347.261000
            text = ""
        intervals [655]:
            xmin = 1347.261000
            xmax = 1349.010000
            text = "vienas aiškus, geras pasiūlymas"
        intervals [656]:
            xmin = 1349.010000
            xmax = 1381.004000
            text = ""
        intervals [657]:
            xmin = 1381.004000
            xmax = 1381.898000
            text = "reikalas tas, kad"
        intervals [658]:
            xmin = 1381.898000
            xmax = 1382.220000
            text = ""
        intervals [659]:
            xmin = 1382.220000
            xmax = 1385.114000
            text = "žemės pasiūlymas - jisai gali būt"
        intervals [660]:
            xmin = 1385.114000
            xmax = 1385.370000
            text = ""
        intervals [661]:
            xmin = 1385.370000
            xmax = 1386.780000
            text = "apžvelgiamas iš kelių pusių."
        intervals [662]:
            xmin = 1386.780000
            xmax = 1387.530000
            text = ""
        intervals [663]:
            xmin = 1387.530000
            xmax = 1392.180000
            text = "Kodėl lenkai negalėjo siūlyti žemės todėl, kad jie būtų praradę dvarininkų palaikymą?"
        intervals [664]:
            xmin = 1392.180000
            xmax = 1392.600000
            text = ""
        intervals [665]:
            xmin = 1392.600000
            xmax = 1396.290000
            text = "Iš karto aišku, kad šitas reikalas ne nevyksta. Pas lenkus"
        intervals [666]:
            xmin = 1396.290000
            xmax = 1396.950000
            text = ""
        intervals [667]:
            xmin = 1396.950000
            xmax = 1399.050000
            text = "pas bolševikus galima žadėti bet ką,"
        intervals [668]:
            xmin = 1399.050000
            xmax = 1399.560000
            text = ""
        intervals [669]:
            xmin = 1399.560000
            xmax = 1402.140000
            text = "bet visi labai greitai pamatė, kas vyksta iš tikrųjų."
        intervals [670]:
            xmin = 1402.140000
            xmax = 1402.770000
            text = ""
        intervals [671]:
            xmin = 1402.770000
            xmax = 1405.470000
            text = "Tai ten gi šūkiai sau, gyvenimas sau."
        intervals [672]:
            xmin = 1405.470000
            xmax = 1405.830000
            text = ""
        intervals [673]:
            xmin = 1405.830000
            xmax = 1410.750000
            text = "Dažniausiai tai yra kažkoks kūrimas kažkokių tai utopinių organizacijų, kurios labai panašios į"
        intervals [674]:
            xmin = 1410.750000
            xmax = 1411.500000
            text = "buvusį dvarą."
        intervals [675]:
            xmin = 1411.500000
            xmax = 1412.130000
            text = ""
        intervals [676]:
            xmin = 1412.130000
            xmax = 1416.810000
            text = "Na, o o o lietuviai jie galėjo pasiūlyti šitą socialinę programą."
        intervals [677]:
            xmin = 1416.810000
            xmax = 1420.920000
            text = "Todėl, kad jie ne turėjo kažkokiu būdu perimti valdžią krašte,"
        intervals [678]:
            xmin = 1420.920000
            xmax = 1421.550000
            text = ""
        intervals [679]:
            xmin = 1421.550000
            xmax = 1423.620000
            text = "nes Lietuvą valdė, dvarai, dar"
        intervals [680]:
            xmin = 1423.620000
            xmax = 1423.920000
            text = ""
        intervals [681]:
            xmin = 1423.920000
            xmax = 1425.690000
            text = "ir dvarininkai, o dvarininkai"
        intervals [682]:
            xmin = 1425.690000
            xmax = 1426.050000
            text = ""
        intervals [683]:
            xmin = 1426.050000
            xmax = 1429.380000
            text = "didžia dalim jokiu būdu ne šimtu procentų iš esmės"
        intervals [684]:
            xmin = 1429.380000
            xmax = 1429.830000
            text = ""
        intervals [685]:
            xmin = 1429.830000
            xmax = 1431.870000
            text = "palaikė. Senosios Lietuvos"
        intervals [686]:
            xmin = 1431.870000
            xmax = 1432.100000
            text = ""
        intervals [687]:
            xmin = 1432.100000
            xmax = 1437.050000
            text = "unijos su Lenkija idėją tai tas buvo labai akivaizdu ir save labai tapatino su Lenkijos kultūra."
        intervals [688]:
            xmin = 1437.050000
            xmax = 1437.530000
            text = ""
        intervals [689]:
            xmin = 1437.530000
            xmax = 1442.240000
            text = "Taigi natūraliai reikėjo kažką daryti su žemės klausimu, tam, kad valdyt šitą"
        intervals [690]:
            xmin = 1442.240000
            xmax = 1443.470000
            text = "kraštą. Priešingu atveju"
        intervals [691]:
            xmin = 1443.470000
            xmax = 1443.740000
            text = ""
        intervals [692]:
            xmin = 1443.740000
            xmax = 1444.670000
            text = "šansų jokių."
        intervals [693]:
            xmin = 1444.670000
            xmax = 1445.120000
            text = ""
        intervals [694]:
            xmin = 1445.120000
            xmax = 1447.325000
            text = "Vokiečių kareiviai buvę Lietuvoj. Vat"
        intervals [695]:
            xmin = 1447.325000
            xmax = 1447.760000
            text = ""
        intervals [696]:
            xmin = 1447.760000
            xmax = 1451.420000
            text = "Pirmo pasaulinio karo metais matė dvi Lietuvas dvarų - Lietuvą"
        intervals [697]:
            xmin = 1451.420000
            xmax = 1451.780000
            text = ""
        intervals [698]:
            xmin = 1451.780000
            xmax = 1452.898000
            text = "ir kaimų Lietuvą"
        intervals [699]:
            xmin = 1452.898000
            xmax = 1453.680000
            text = ""
        intervals [700]:
            xmin = 1453.680000
            xmax = 1458.120000
            text = "Čia labai akivaizdžiai matėsi tos dvi konkurencinės aplinkos. Buvo ne tik kalbinės,"
        intervals [701]:
            xmin = 1458.120000
            xmax = 1458.480000
            text = ""
        intervals [702]:
            xmin = 1458.480000
            xmax = 1460.218000
            text = "bet jos buvo ir socialinės"
        intervals [703]:
            xmin = 1460.218000
            xmax = 1469.390000
            text = ""
        intervals [704]:
            xmin = 1469.390000
            xmax = 1470.830000
            text = "Tie skaičiai pastoviai juda,"
        intervals [705]:
            xmin = 1470.830000
            xmax = 1471.340000
            text = ""
        intervals [706]:
            xmin = 1471.340000
            xmax = 1474.250000
            text = "Ir ir mes galim kalbėti apie"
        intervals [707]:
            xmin = 1474.250000
            xmax = 1474.370000
            text = ""
        intervals [708]:
            xmin = 1474.370000
            xmax = 1479.170000
            text = "apie pradžioj tris tūkstančius, va čia pradinis laikotarpis. Paskui toksai skaičius - dvylika"
        intervals [709]:
            xmin = 1479.170000
            xmax = 1479.830000
            text = "tūkstančių"
        intervals [710]:
            xmin = 1479.830000
            xmax = 1480.490000
            text = ""
        intervals [711]:
            xmin = 1480.490000
            xmax = 1485.140000
            text = "iki, sakykim, didžiausius skaičius Lietuvos kariuomenė pasiekė iš esmės Karam pasibaigus"
        intervals [712]:
            xmin = 1485.140000
            xmax = 1485.170000
            text = ""
        intervals [713]:
            xmin = 1485.170000
            xmax = 1486.130000
            text = "dvidešimtų metų"
        intervals [714]:
            xmin = 1486.130000
            xmax = 1491.360000
            text = ""
        intervals [715]:
            xmin = 1491.360000
            xmax = 1496.250000
            text = "taip, tai tie savanoriai. Viena kada atsiranda mobilizacija, imtis iš karto yra kitokia,"
        intervals [716]:
            xmin = 1496.250000
            xmax = 1496.640000
            text = ""
        intervals [717]:
            xmin = 1496.640000
            xmax = 1501.320000
            text = "ir natūraliai, kad tada tų žmonių ten galima paimti ir daugiau, nes vis tiek, jie gi"
        intervals [718]:
            xmin = 1501.320000
            xmax = 1501.950000
            text = "užaugo"
        intervals [719]:
            xmin = 1501.950000
            xmax = 1502.337000
            text = ""
        intervals [720]:
            xmin = 1502.337000
            xmax = 1504.920000
            text = "Rusijos kariuomenė jų paimti negalėjo. Vokiečiai neėmė."
        intervals [721]:
            xmin = 1504.920000
            xmax = 1505.620000
            text = ""
        intervals [722]:
            xmin = 1505.620000
            xmax = 1507.330000
            text = "Tai reiškia to mobilizacinio"
        intervals [723]:
            xmin = 1507.330000
            xmax = 1507.540000
            text = ""
        intervals [724]:
            xmin = 1507.540000
            xmax = 1511.350000
            text = "resurso mes, kaip ir turėjom Lietuvoj, reikėjo tik surasti tinkamą formą."
        intervals [725]:
            xmin = 1511.350000
            xmax = 1511.830000
            text = ""
        intervals [726]:
            xmin = 1511.830000
            xmax = 1516.750000
            text = "Tai ta forma ir buvo per per per tuos per tą per tą šaukimą, kuris yra, na,"
        intervals [727]:
            xmin = 1516.750000
            xmax = 1516.780000
            text = ""
        intervals [728]:
            xmin = 1516.780000
            xmax = 1518.020000
            text = "žinoma, kad prievartinis"
        intervals [729]:
            xmin = 1518.020000
            xmax = 1518.353000
            text = ""
        intervals [730]:
            xmin = 1518.353000
            xmax = 1521.860000
            text = "nediskusinis, bet jisai yra vienintelis įmanomas toje situacijoj. "
        intervals [731]:
            xmin = 1521.860000
            xmax = 1543.083000
            text = ""
        intervals [732]:
            xmin = 1543.083000
            xmax = 1545.372000
            text = "rengimo procesas yra super trumpas."
        intervals [733]:
            xmin = 1545.372000
            xmax = 1547.360000
            text = ""
        intervals [734]:
            xmin = 1547.360000
            xmax = 1550.060000
            text = "tas mokslas yra karo, sakykim, gan paprastas"
        intervals [735]:
            xmin = 1550.060000
            xmax = 1551.200000
            text = ""
        intervals [736]:
            xmin = 1551.200000
            xmax = 1552.910000
            text = "tam tikri pratimai su šautuvu,"
        intervals [737]:
            xmin = 1552.910000
            xmax = 1553.270000
            text = ""
        intervals [738]:
            xmin = 1553.270000
            xmax = 1554.800000
            text = "pagarbos atidavimas,"
        intervals [739]:
            xmin = 1554.800000
            xmax = 1555.670000
            text = ""
        intervals [740]:
            xmin = 1555.670000
            xmax = 1557.320000
            text = "minimalus apkaso, maždaug"
        intervals [741]:
            xmin = 1557.320000
            xmax = 1557.650000
            text = ""
        intervals [742]:
            xmin = 1557.650000
            xmax = 1562.360000
            text = "kaip jisai ten kasamas, ir ir viskas ten. Tai tie, kas turėjo laiko ten, Kaune, dar šiek tiek"
        intervals [743]:
            xmin = 1562.360000
            xmax = 1564.910000
            text = "pasimokyt. Spėjo kažką pasimokyt, o paskui realiai"
        intervals [744]:
            xmin = 1564.910000
            xmax = 1565.270000
            text = ""
        intervals [745]:
            xmin = 1565.270000
            xmax = 1570.220000
            text = "mokymas vykdavo tiesiog mūšių laukuose. Čia gal svarbiausias dalykas buvo puskarininkių rengimas,"
        intervals [746]:
            xmin = 1570.220000
            xmax = 1570.700000
            text = ""
        intervals [747]:
            xmin = 1570.700000
            xmax = 1575.290000
            text = "nes mes dažnai kažkaip apie karininkus apie kareivius. kalbam o puskarininkiai tarsi tokie nesvarbūs,"
        intervals [748]:
            xmin = 1575.290000
            xmax = 1575.350000
            text = ""
        intervals [749]:
            xmin = 1575.350000
            xmax = 1576.280000
            text = "labai svarbūs,"
        intervals [750]:
            xmin = 1576.280000
            xmax = 1576.580000
            text = ""
        intervals [751]:
            xmin = 1576.580000
            xmax = 1581.200000
            text = "nes jie yra realiai kareivius mokantys. Žmonės tai tam būdavo formuojamos mokomosios kuopos"
        intervals [752]:
            xmin = 1581.200000
            xmax = 1581.850000
            text = ""
        intervals [753]:
            xmin = 1581.850000
            xmax = 1583.630000
            text = "prie pulko būdavo mokomoji kuopa,"
        intervals [754]:
            xmin = 1583.630000
            xmax = 1583.960000
            text = ""
        intervals [755]:
            xmin = 1583.960000
            xmax = 1586.270000
            text = "kuri iš esmės buvo tų puskarininkių mokykla."
        intervals [756]:
            xmin = 1586.270000
            xmax = 1587.290000
            text = ""
        intervals [757]:
            xmin = 1587.290000
            xmax = 1589.990000
            text = "į jų rengimą karininkai dėdavo daug sveikatos."
        intervals [758]:
            xmin = 1589.990000
            xmax = 1590.490000
            text = ""
        intervals [759]:
            xmin = 1590.490000
            xmax = 1593.940000
            text = "Ir, tiesą sakant, nuo jų labai daug kas ir priklausė mūšio lauke, nes"
        intervals [760]:
            xmin = 1593.940000
            xmax = 1594.300000
            text = ""
        intervals [761]:
            xmin = 1594.300000
            xmax = 1596.520000
            text = "nuostoliai didžiausi buvo karininkų tarpe."
        intervals [762]:
            xmin = 1596.520000
            xmax = 1596.790000
            text = ""
        intervals [763]:
            xmin = 1596.790000
            xmax = 1601.440000
            text = "Kadangi tais laikais reikėjo asmeniniu, pavyzdžiu, vest karius į mūšį, tai reiškia tas karininkas jisai"
        intervals [764]:
            xmin = 1601.440000
            xmax = 1601.470000
            text = ""
        intervals [765]:
            xmin = 1601.470000
            xmax = 1602.610000
            text = "fiziškai eina kovot."
        intervals [766]:
            xmin = 1602.610000
            xmax = 1603.000000
            text = ""
        intervals [767]:
            xmin = 1603.000000
            xmax = 1605.700000
            text = "Na, o natūraliai, tokie daugiausia ir sulaukia kulkų."
        intervals [768]:
            xmin = 1605.700000
            xmax = 1606.150000
            text = ""
        intervals [769]:
            xmin = 1606.150000
            xmax = 1607.357000
            text = "Tai mes turim suprast, kad"
        intervals [770]:
            xmin = 1607.357000
            xmax = 1607.650000
            text = ""
        intervals [771]:
            xmin = 1607.650000
            xmax = 1612.570000
            text = "dažnai ir puskarininkiam tekdavo vadovaut ir padaliniam ir ir netgi kuopom kartais, nes, nes karininkų"
        intervals [772]:
            xmin = 1612.570000
            xmax = 1614.340000
            text = "tiesiog nebūdavo sužeisti. Išmušti"
        intervals [773]:
            xmin = 1614.340000
            xmax = 1614.940000
            text = ""
        intervals [774]:
            xmin = 1614.940000
            xmax = 1618.720000
            text = "tai čia toks tas kariavimo būdas, ir tas mokymas buvo toksai."
        intervals [775]:
            xmin = 1618.720000
            xmax = 1619.050000
            text = ""
        intervals [776]:
            xmin = 1619.050000
            xmax = 1624.030000
            text = "Karo mokykloj dviejų mėnesių kursas nu tas pats pagreitintas Rusijos imperijos"
        intervals [777]:
            xmin = 1624.030000
            xmax = 1626.070000
            text = "karininko rengimo kursas. Nieko kito,"
        intervals [778]:
            xmin = 1626.070000
            xmax = 1626.580000
            text = ""
        intervals [779]:
            xmin = 1626.580000
            xmax = 1628.200000
            text = "tai žmonės gaudavo gerai"
        intervals [780]:
            xmin = 1628.200000
            xmax = 1628.800000
            text = ""
        intervals [781]:
            xmin = 1628.800000
            xmax = 1629.280000
            text = "gerą"
        intervals [782]:
            xmin = 1629.280000
            xmax = 1629.400000
            text = ""
        intervals [783]:
            xmin = 1629.400000
            xmax = 1630.840000
            text = "porciją patriotizmo,"
        intervals [784]:
            xmin = 1630.840000
            xmax = 1631.230000
            text = ""
        intervals [785]:
            xmin = 1631.230000
            xmax = 1636.150000
            text = "motyvacijos, minimaliai karinių žinių, praktinių tokių ir štai su tokiu bagažu"
        intervals [786]:
            xmin = 1636.150000
            xmax = 1636.510000
            text = "jau"
        intervals [787]:
            xmin = 1636.510000
            xmax = 1636.690000
            text = ""
        intervals [788]:
            xmin = 1636.690000
            xmax = 1638.040000
            text = "keliauja ir ir kariauja."
        intervals [789]:
            xmin = 1638.040000
            xmax = 1638.370000
            text = ""
        intervals [790]:
            xmin = 1638.370000
            xmax = 1644.460000
            text = "Todėl labai didelis procentas jaunų karininkų žūdavo, arba būdavo sužeistų, nes jie labai drąsiai puldavo."
        intervals [791]:
            xmin = 1644.460000
            xmax = 1645.060000
            text = ""
        intervals [792]:
            xmin = 1645.060000
            xmax = 1646.650000
            text = "Rezultatai savaime suprantami,"
        intervals [793]:
            xmin = 1646.650000
            xmax = 1647.250000
            text = ""
        intervals [794]:
            xmin = 1647.250000
            xmax = 1647.790000
            text = "tačiau"
        intervals [795]:
            xmin = 1647.790000
            xmax = 1648.030000
            text = ""
        intervals [796]:
            xmin = 1648.030000
            xmax = 1650.460000
            text = "paruošti štabo karininką šansų jokių"
        intervals [797]:
            xmin = 1650.460000
            xmax = 1650.580000
            text = ""
        intervals [798]:
            xmin = 1650.580000
            xmax = 1655.200000
            text = "reiškia tu Tiktai gali tikėtis tikėtis, kad kažkas jau iš anksčiau kažką tai"
        intervals [799]:
            xmin = 1655.200000
            xmax = 1657.491000
            text = "moka ir kažką gali daryti. Dėl to Lietuvos"
        intervals [800]:
            xmin = 1657.491000
            xmax = 1657.855000
            text = ""
        intervals [801]:
            xmin = 1657.855000
            xmax = 1658.890000
            text = "ypatingai trūko"
        intervals [802]:
            xmin = 1658.890000
            xmax = 1659.400000
            text = ""
        intervals [803]:
            xmin = 1659.400000
            xmax = 1660.420000
            text = "divizijų vadų."
        intervals [804]:
            xmin = 1660.420000
            xmax = 1660.930000
            text = ""
        intervals [805]:
            xmin = 1660.930000
            xmax = 1665.820000
            text = "Jau nekalbu apie kariuomenės vadus ir ir praktiškai tai yra keletas žmonių, į kurios gali atsiremti"
        intervals [806]:
            xmin = 1665.820000
            xmax = 1668.180000
            text = ""
        intervals [807]:
            xmin = 1668.180000
            xmax = 1670.340000
            text = "kurie turėjo aukštesnius laipsnius, bet, sakykime,"
        intervals [808]:
            xmin = 1670.340000
            xmax = 1673.520000
            text = ""
        intervals [809]:
            xmin = 1673.520000
            xmax = 1674.600000
            text = "talento. Neturėjo,"
        intervals [810]:
            xmin = 1674.600000
            xmax = 1675.170000
            text = ""
        intervals [811]:
            xmin = 1675.170000
            xmax = 1678.079000
            text = "nes Rusijos imperijos kariuomenėj buvo daug tokių"
        intervals [812]:
            xmin = 1678.079000
            xmax = 1678.247000
            text = ""
        intervals [813]:
            xmin = 1678.247000
            xmax = 1680.030000
            text = "karininkų pareigybių, nesusijusių"
        intervals [814]:
            xmin = 1680.030000
            xmax = 1681.530000
            text = "su vadovavimo mūšio lauke."
        intervals [815]:
            xmin = 1681.530000
            xmax = 1681.860000
            text = ""
        intervals [816]:
            xmin = 1681.860000
            xmax = 1684.900000
            text = "Tai logistika, tai įvairios tarnybos, tai"
        intervals [817]:
            xmin = 1684.900000
            xmax = 1686.990000
            text = ""
        intervals [818]:
            xmin = 1686.990000
            xmax = 1687.890000
            text = "Paskui pasižiūri"
        intervals [819]:
            xmin = 1687.890000
            xmax = 1688.040000
            text = ""
        intervals [820]:
            xmin = 1688.040000
            xmax = 1688.550000
            text = "į mūšį."
        intervals [821]:
            xmin = 1688.550000
            xmax = 1688.910000
            text = ""
        intervals [822]:
            xmin = 1688.910000
            xmax = 1689.450000
            text = "nu tai,"
        intervals [823]:
            xmin = 1689.450000
            xmax = 1689.840000
            text = ""
        intervals [824]:
            xmin = 1689.840000
            xmax = 1692.270000
            text = "ne visada tie žmonės pasižymėjo ryžtu."
        intervals [825]:
            xmin = 1692.270000
            xmax = 1692.570000
            text = ""
        intervals [826]:
            xmin = 1692.570000
            xmax = 1695.180000
            text = "Ne visada jiems užteko tokios iniciatyvos."
        intervals [827]:
            xmin = 1695.180000
            xmax = 1695.410000
            text = ""
        intervals [828]:
            xmin = 1695.410000
            xmax = 1700.030000
            text = "Kai kuriais atvejais jie buvo linkę delsti na tas. Rusijos imperijos buvo ta tas neigiamas"
        intervals [829]:
            xmin = 1700.030000
            xmax = 1702.490000
            text = "karininko tipas. Ne tik teigiamas, bet ir neigiamas,"
        intervals [830]:
            xmin = 1702.490000
            xmax = 1704.257000
            text = ""
        intervals [831]:
            xmin = 1704.257000
            xmax = 1708.570000
            text = "biurokratai su antpečiais? Vat irgi yra tokia kategorija, kurie mūšio lauke"
        intervals [832]:
            xmin = 1708.570000
            xmax = 1709.470000
            text = "labai prastai"
        intervals [833]:
            xmin = 1709.470000
            xmax = 1709.650000
            text = ""
        intervals [834]:
            xmin = 1709.650000
            xmax = 1714.540000
            text = "save parodė. Jiem pritrūkdavo sprendimo, kai jie negaudavo iš viršaus komandos nežinodavo, kaip elgtis."
        intervals [835]:
            xmin = 1714.540000
            xmax = 1714.990000
            text = ""
        intervals [836]:
            xmin = 1714.990000
            xmax = 1717.750000
            text = "Užtai buvo labai svarbu, kas tai kariuomenei vadovauja."
        intervals [837]:
            xmin = 1717.750000
            xmax = 1718.140000
            text = ""
        intervals [838]:
            xmin = 1718.140000
            xmax = 1721.350000
            text = "Na, ir čia mūsų tas gelbėtojas buvo Silvestras Žukauskas,"
        intervals [839]:
            xmin = 1721.350000
            xmax = 1721.830000
            text = ""
        intervals [840]:
            xmin = 1721.830000
            xmax = 1723.150000
            text = "kuris buvo pakankamai"
        intervals [841]:
            xmin = 1723.150000
            xmax = 1724.530000
            text = ""
        intervals [842]:
            xmin = 1724.530000
            xmax = 1730.397000
            text = "šiandien jinai atrodo labai gerai, bet to meto kariuomenėj turėjo labai daug rezervų. Kareiviai "
        intervals [843]:
            xmin = 1730.397000
            xmax = 1730.980000
            text = ""
        intervals [844]:
            xmin = 1730.980000
            xmax = 1731.490000
            text = "atžvilgiu"
        intervals [845]:
            xmin = 1731.490000
            xmax = 1731.920000
            text = ""
        intervals [846]:
            xmin = 1731.920000
            xmax = 1733.453000
            text = "todėl, kad jisai iš esmės"
        intervals [847]:
            xmin = 1733.453000
            xmax = 1733.660000
            text = ""
        intervals [848]:
            xmin = 1733.660000
            xmax = 1738.730000
            text = "žinojo vieną tipą. Rusijos kariuomenė kvietėsi žmones nepriklausomai nuo tautybės, reiškia"
        intervals [849]:
            xmin = 1738.730000
            xmax = 1739.000000
            text = ""
        intervals [850]:
            xmin = 1739.000000
            xmax = 1743.075000
            text = "aplink save apsistatė, tais vadinamais Rusijos imperijos štabnikais Visokiais"
        intervals [851]:
            xmin = 1743.075000
            xmax = 1743.590000
            text = ""
        intervals [852]:
            xmin = 1743.590000
            xmax = 1746.380000
            text = "jų patikimumas buvo labai labai abejotinas."
        intervals [853]:
            xmin = 1746.380000
            xmax = 1746.680000
            text = ""
        intervals [854]:
            xmin = 1746.680000
            xmax = 1751.630000
            text = "Na, ir vienu žodžiu, ta kariuomenė jau tada turėjo tokį vidinį susipriešinimą tarp tų lietuvių ir"
        intervals [855]:
            xmin = 1751.630000
            xmax = 1752.830000
            text = "tų Žukausko žmonių."
        intervals [856]:
            xmin = 1752.830000
            xmax = 1753.280000
            text = ""
        intervals [857]:
            xmin = 1753.280000
            xmax = 1754.720000
            text = "Ir nors Žukauskas, jisai ten"
        intervals [858]:
            xmin = 1754.720000
            xmax = 1755.180000
            text = ""
        intervals [859]:
            xmin = 1755.180000
            xmax = 1760.040000
            text = "sugebėdavo šiokią tokią kalbą pasakyti, bet rašyt tai lietuviškai nemokėjo, ir karininkai"
        intervals [860]:
            xmin = 1760.040000
            xmax = 1764.360000
            text = "tarp savęs kalbėjo arba lenkiškai, arba rusiškai. Čia nu, ne visi, bet didelė dalis"
        intervals [861]:
            xmin = 1764.360000
            xmax = 1779.758000
            text = ""
        intervals [862]:
            xmin = 1779.758000
            xmax = 1784.801000
            text = "tiesiog lietuvių kalba karo reikalam nebuvo naudota šimtmečiais. Čia reikia suprast. Yra "
        intervals [863]:
            xmin = 1784.801000
            xmax = 1789.390000
            text = ""
        intervals [864]:
            xmin = 1789.390000
            xmax = 1789.810000
            text = "Na,"
        intervals [865]:
            xmin = 1789.810000
            xmax = 1790.260000
            text = ""
        intervals [866]:
            xmin = 1790.260000
            xmax = 1792.180000
            text = "čiagi nieko labai keisto. Na, ir"
        intervals [867]:
            xmin = 1792.180000
            xmax = 1792.510000
            text = ""
        intervals [868]:
            xmin = 1792.510000
            xmax = 1794.580000
            text = "ir šiandien mūsų Lietuvos karininkai"
        intervals [869]:
            xmin = 1794.580000
            xmax = 1794.910000
            text = ""
        intervals [870]:
            xmin = 1794.910000
            xmax = 1799.860000
            text = "pereina prie angliškos terminologijos. Kai kuriais atvejais todėl, kad, na, tie vertimai arba jų nėra, arba"
        intervals [871]:
            xmin = 1799.860000
            xmax = 1801.030000
