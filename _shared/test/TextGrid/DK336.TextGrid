        intervals [209]:
            xmin = 1536.680000
            xmax = 1540.250000
            text = "yra priešas už vartų arba jau čia jau jau tavo kiemo pusėj."
        intervals [210]:
            xmin = 1540.250000
            xmax = 1702.790000
            text = ""
        intervals [211]:
            xmin = 1702.790000
            xmax = 1704.146000
            text = "Pareigybių daug kariaut nėra kam"
        intervals [212]:
