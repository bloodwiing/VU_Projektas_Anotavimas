            text = ""
        intervals [309]:
            xmin = 2568.470000
            xmax = 2570.217000
            text = "kariuomenės pagrindinės"
        intervals [310]:
            xmin = 2570.217000
            xmax = 2570.450000
            text = ""
        intervals [311]:
            xmin = 2570.450000
            xmax = 2573.420000
            text = "kryptys, kokie buvo pagrindiniai uždaviniai, formuluojami"
        intervals [312]:
            xmin = 2573.420000
            xmax = 2634.750000
            text = ""
        intervals [313]:
            xmin = 2634.750000
            xmax = 2639.730000
            text = "Kaip tik ir norėjau klaust čia turbūt kalbant apie kariuomenę neįmanoma išvengti klausimo apie"
        intervals [314]:
            xmin = 2639.730000
