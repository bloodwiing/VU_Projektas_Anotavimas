            text = "kariuomenei reikia remtis tuo, ką turi,"
        intervals [906]:
            xmin = 1855.080000
            xmax = 1908.970000
            text = ""
        intervals [907]:
            xmin = 1908.970000
            xmax = 1913.170000
            text = "Kalbant apie bolševikus, nes karas pirmiausia ir pagrindinis vyksta su jais."
