            text = ""
        intervals [927]:
            xmin = 1942.620000
            xmax = 1946.032000
            text = "bet ten jau ir devynioliktais tų konfliktų vyko daug ir susišaudymų"
        intervals [928]:
            xmin = 1946.032000
            xmax = 1946.300000
            text = ""
        intervals [929]:
            xmin = 1946.300000
