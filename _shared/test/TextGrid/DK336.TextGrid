            xmin = 2266.182000
            xmax = 2290.070000
            text = ""
        intervals [276]:
            xmin = 2290.070000
            xmax = 2291.660000
            text = "Plius dar mes turim tą situaciją"
        intervals [277]:
            xmin = 2291.660000
