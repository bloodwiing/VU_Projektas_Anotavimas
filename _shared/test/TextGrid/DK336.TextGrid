            text = ""
        intervals [198]:
            xmin = 1488.704000
            xmax = 1490.160000
            text = "dvylikos tai yra kartais"
        intervals [199]:
            xmin = 1490.160000
            xmax = 1522.490000
            text = ""
        intervals [200]:
            xmin = 1522.490000
            xmax = 1525.760000
            text = "na ir čia atsiduria. Tie visi žmonės iš karto toksai, kaip sako"
