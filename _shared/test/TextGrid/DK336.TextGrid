            text = ""
        intervals [324]:
            xmin = 2696.600000
            xmax = 2700.020000
            text = "tam tikrus kertinius įvykius ar ne kaip apie nacius, mes kalbamės."
        intervals [325]:
            xmin = 2700.020000
            xmax = 2700.440000
            text = ""
        intervals [326]:
            xmin = 2700.440000
            xmax = 2704.070000
            text = "Mes turim omenyje holokaustą. Turim antrą pasaulinį karą. Kalbant apie"
        intervals [327]:
            xmin = 2704.070000
            xmax = 2704.190000
            text = ""
        intervals [328]:
            xmin = 2704.190000
            xmax = 2708.031000
            text = "bolševizmą, mes omenyje turim tremtis ir visus kitus žiaurumus, kurie atsitiko"
        intervals [329]:
            xmin = 2708.031000
            xmax = 2708.390000
            text = ""
        intervals [330]:
            xmin = 2708.390000
            xmax = 2708.862000
            text = "tuomet."
        intervals [331]:
            xmin = 2708.862000
            xmax = 2709.410000
            text = ""
        intervals [332]:
            xmin = 2709.410000
            xmax = 2712.950000
            text = "Taip nebuvo, nes tiesiog tos informacijos, tokios, na, preteksto"
        intervals [333]:
            xmin = 2712.950000
            xmax = 2713.100000
            text = ""
        intervals [334]:
            xmin = 2713.100000
            xmax = 2714.420000
            text = "kitaip galvoti nebuvo."
        intervals [335]:
            xmin = 2714.420000
            xmax = 2790.580000
            text = ""
        intervals [336]:
            xmin = 2790.580000
            xmax = 2792.687000
            text = "aišku, šitoje temoje jau visiškai pabaigai."
        intervals [337]:
            xmin = 2792.687000
            xmax = 2793.070000
            text = ""
        intervals [338]:
            xmin = 2793.070000
            xmax = 2793.670000
            text = "Na, mes"
        intervals [339]:
            xmin = 2793.670000
            xmax = 2794.030000
            text = ""
        intervals [340]:
            xmin = 2794.030000
            xmax = 2798.860000
            text = "manau, kad mes dar susitiksim vieną kitą kartą pakalbėt. Kaip nutiko, kad kad, kad buvo tokių"
        intervals [341]:
            xmin = 2798.860000
            xmax = 2798.890000
            text = ""
        intervals [342]:
            xmin = 2798.890000
            xmax = 2803.279000
            text = "perbėgėlių? Aš kalbu kaip apie generolas Vitkauskas. Ar ne buvo buvo tokie reiškiniai?"
        intervals [343]:
            xmin = 2803.279000
            xmax = 2803.720000
            text = ""
        intervals [344]:
            xmin = 2803.720000
            xmax = 2804.800000
            text = "Na, o šiandien"
        intervals [345]:
            xmin = 2804.800000
            xmax = 2805.820000
            text = ""
        intervals [346]:
            xmin = 2805.820000
            xmax = 2810.560000
            text = "aš labai noriu padėkot profesoriui Valdui Rakučiui ir jus asmeniškai pasveikinti su"
        intervals [347]:
            xmin = 2810.560000
            xmax = 2812.750000
            text = "Lietuvos kariuomenės diena. Nesvarbu, ar tai"
        intervals [348]:
