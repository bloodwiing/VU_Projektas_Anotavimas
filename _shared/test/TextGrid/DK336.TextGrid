        intervals [204]:
            xmin = 1528.460000
            xmax = 1533.260000
            text = "treniruotė mūšyje, ar ne? Kad kad kad kad nepriklausomai, kiek tu turi to"
        intervals [205]:
            xmin = 1533.260000
            xmax = 1535.120000
            text = "pasirengimo, pasirinkimo,"
