            text = ""
        intervals [217]:
            xmin = 1769.020000
            xmax = 1773.670000
            text = "trisdešim devintus metus Vilniaus atidavimo išvakares ir Nagevičiaus"
        intervals [218]:
            xmin = 1773.670000
