            text = ""
        intervals [108]:
            xmin = 713.630000
            xmax = 716.060000
            text = "būrį, vien apginkluot kaip šitie reikalai judėjo"
        intervals [109]:
            xmin = 716.060000
            xmax = 820.031000
            text = ""
        intervals [110]:
            xmin = 820.031000
            xmax = 821.730000
            text = "lėktuvų ir iš bermontininkų paėmė"
        intervals [111]:
            xmin = 821.730000
            xmax = 842.110000
            text = ""
        intervals [112]:
            xmin = 842.110000
            xmax = 850.660000
            text = "Čia panašiai kaip ir su uniformom buvo ar ne tiktai buvo britiškos ameriko amerikietiškos tiktai skiriamieji ženklai buvo lietuviški. Ta įvairovė tokia vėlgi kaip ir su ginklais."
        intervals [113]:
            xmin = 850.660000
            xmax = 868.542000
            text = ""
        intervals [114]:
            xmin = 868.542000
            xmax = 868.954000
            text = "Prisimenu,"
        intervals [115]:
            xmin = 868.954000
            xmax = 869.020000
            text = ""
        intervals [116]:
            xmin = 869.020000
            xmax = 869.920000
            text = "Vienas toksai buvo"
        intervals [117]:
            xmin = 869.920000
            xmax = 870.137000
            text = ""
        intervals [118]:
            xmin = 870.137000
            xmax = 870.959000
