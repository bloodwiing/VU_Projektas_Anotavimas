# --- Vowel vs Consonant ---
QS "Vowel" {a,Aa,aA,aa,A,e,eA,eE,ea,ee,Ea,Ee,E,i,iE,iI,ie,ii,Ie,Ii,I,o,oO,oo,Oo,O,u,uO,uU,uo,uu,Uo,Uu,U}

QS "Consonant" {L,L_pal,M,M_pal,N,N_pal,R,R_pal,S,S_pal,Z,Z_pal,b,b_pal,d,dZ,dZ_pal,d_pal,dz,dz_pal,f,f_pal,g,g_pal,h,h_pal,j_pal,k,k_pal,l,l_pal,m,m_pal,n,n_pal,p,p_pal,r,r_pal,s,s_pal,t,tS,tS_pal,t_pal,ts,ts_pal,v,v_pal,x,x_pal,z,z_pal}

# --- Vowel Classes ---
QS "V_a" {a,Aa,aA,aa,A}

QS "V_e" {e,eA,eE,ea,ee,Ea,Ee,E}

QS "V_i" {i,iE,iI,ie,ii,Ie,Ii,I}

QS "V_o" {o,oO,oo,Oo,O}

QS "V_u" {u,uO,uU,uo,uu,Uo,Uu,U}

# --- Consonant Families ---
QS "L_Family" {L,L_pal}

QS "M_Family" {M,M_pal}

QS "N_Family" {N,N_pal}

QS "R_Family" {R,R_pal}

QS "S_Family" {S,S_pal}

QS "Z_Family" {Z,Z_pal}

QS "b_Family" {b,b_pal}

QS "d_Family" {d,d_pal}

QS "dZ_Family" {dZ,dZ_pal}

QS "dz_Family" {dz,dz_pal}

QS "f_Family" {f,f_pal}

