# --- Stressed Vowels ---
QS "ShortUnstressed" {a,e,i,o,u}

QS "ShortStressed" {A,E,I,O,U}

QS "LongUnstressed" {aa,ea,ee,ie,ii,oo,uo,uu}

QS "StressedFalling" {Aa,Ea,Ee,Ie,Ii,Oo,Uo,Uu}

QS "StressedRising" {aA,eA,eE,iE,iI,oO,uO,uU}

# --- Palatalised (soft) Consonants ---
QS "Palatalised" {L_pal,M_pal,N_pal,R_pal,S_pal,Z_pal,b_pal,dZ_pal,d_pal,dz_pal,f_pal,g_pal,h_pal,j_pal,k_pal,l_pal,m_pal,n_pal,p_pal,r_pal,s_pal,tS_pal,t_pal,ts_pal,v_pal,x_pal,z_pal}

# QS "NonPalatalised" {L,M,N,R,S,Z,b,d,dZ,dz,f,g,h,k,l,m,n,p,r,s,t,tS,ts,v,x,z}

# --- Consonant Classes ---
QS "Sonorant" {j,j_pal,l,l_pal,m,m_pal,n,n_pal,r,r_pal,v,v_pal}

# QS "NonSonorant" {b,b_pal,d,d_pal,g,g_pal,k,k_pal,p,p_pal,s,s_pal,S,S_pal,t,t_pal,z,z_pal,Z,Z_pal}

QS "Fricative" {s,s_pal,S,S_pal,z,z_pal,Z,Z_pal,f,f_pal,h,h_pal,x,x_pal}

# QS "NonFricative" {p,p_pal,t,t_pal,k,k_pal,b,b_pal,d,d_pal,g,g_pal}

QS "Affricates" {ts,ts_pal,tS,tS_pal,dz,dz_pal,dZ,dZ_pal}

# QS "ForeignFricatives" {f,f_pal,x,x_pal,h,h_pal}

# --- Place of Articulation ---
QS "Labial" {p,p_pal,b,b_pal,m,m_pal,v,v_pal,f,f_pal}

# QS "NonLabial" {t,t_pal,d,d_pal,k,k_pal,g,g_pal}

QS "Coronal" {t,t_pal,d,d_pal,n,n_pal,l,l_pal,r,r_pal}

# QS "NonCoronal" {k,k_pal,g,g_pal}

QS "Silibant" {s,s_pal,z,z_pal,S,S_pal,Z,Z_pal,ts,ts_pal,tS,tS_pal,dz,dz_pal,dZ,dZ_pal}

# QS "NonSilibant" {S,S_pal,Z,Z_pal}

# --- Voiced ---
QS "Voiced" {g,g_pal,d,d_pal,b,b_pal,dz,dz_pal,dZ,dZ_pal,z,z_pal,Z,Z_pal,m,m_pal,n,n_pal,l,l_pal,r,r_pal,j,j_pal}

QS "NonVoiced" {k,k_pal,t,t_pal,p,p_pal,ts,ts_pal,tS,tS_pal,s,s_pal,S,S_pal,f,f_pal,h,h_pal,x,x_pal}

# --- Diphthong endings ---
QS "Diphthong" {j,J,w,W}

QS "StressedMixedDiphthong" {L,L_pal,M,M_pal,N,N_pal,R,R_pal}

QS "StressedDiphthong" {J,W}

# --- Silence and Noise ---
QS "Silence" {sil}


